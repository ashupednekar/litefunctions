{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "istioNamespace": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "istioNamespace"
      ]
    },
    "istio": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "includeGtw": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "includeGtw"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "includeGtw": {
                "const": true
              }
            },
            "required": [
              "includeGtw"
            ]
          },
          "then": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "gatewayApi": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gatewayClassName": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "gatewayClassName"
            ]
          }
        }
      ]
    }
  }
}
