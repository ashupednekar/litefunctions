package templates

templ BaseLayout(data ShellData, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.Title } · Litefunctions</title>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/js/portal.js" defer></script>
		</head>
		<body>
			<div class="z-app">
				<aside class="z-sidebar" id="app-sidebar">
					<a href="/dashboard/" class="z-brand">
						<span class="z-brand-mark">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
							</svg>
						</span>
						<span class="z-brand-name">litefunctions</span>
						<span class="z-brand-version">0.1</span>
					</a>

					<div class="z-workspace-switch">
						<a href="/dashboard/" class="z-project-btn" title="Switch project">
							<span class="z-project-avatar">{ projectInitial(data.ProjectName) }</span>
							<span class="z-project-meta">
								<span class="z-project-name">{ projectLabel(data.ProjectName) }</span>
								<span class="z-project-role">{ projectRole(data.Role) }</span>
							</span>
							@Icon("chevron-down", "w-3 h-3 text-[#5b5b65]")
						</a>
					</div>

					<nav class="z-sidebar-scroll">
						<div class="z-nav-section">
							<div class="z-nav-label">Workspace</div>
							@NavItem("/dashboard/", "Overview", "grid", data.Active == "overview", "")
							@NavItem("/functions/", "Functions", "code", data.Active == "functions", "")
							@NavItem("/endpoints/", "Endpoints", "route", data.Active == "endpoints", "")
						</div>
						<div class="z-nav-section">
							<div class="z-nav-label">Build</div>
							@NavItem("/dependencies/", "Dependencies", "package", data.Active == "dependencies", "")
							@NavItem("/data-model/", "Data Model", "database", data.Active == "data-model", "")
							@NavItem("/agent/", "Agentic Planner", "sparkles", data.Active == "agent", "AI")
						</div>
						<div class="z-nav-section">
							<div class="z-nav-label">Data</div>
							@NavItem("/data/", "Data & Storage", "layers", data.Active == "data", "")
							@NavItem("/pubsub/", "Pub/Sub · Olly", "network", data.Active == "pubsub", "")
						</div>
						<div class="z-nav-section">
							<div class="z-nav-label">Operate</div>
							@NavItem("/traffic/", "Traffic · Gateway", "shield", data.Active == "traffic", "")
							@NavItem("/compute/", "Compute · Isolation", "cpu", data.Active == "compute", "FUTURE")
							@NavItem("/observability/", "Observability", "activity", data.Active == "observability", "")
							@NavItem("/deployments/", "Deployments", "rocket", data.Active == "deployments", "")
						</div>
						<div class="z-nav-section">
							<div class="z-nav-label">Project settings</div>
							@NavItem("/configuration/", "Configs & Secrets", "key", data.Active == "configuration", "")
							@NavItem("/access/", "Team & Access", "users", data.Active == "access", "")
							@NavItem("/audit/", "Audit Log", "clock", data.Active == "audit", "")
						</div>
					</nav>

					<div class="z-sidebar-foot">
						<a href="https://github.com/ashupednekar/litefunctions" target="_blank" rel="noopener" class="z-sidebar-link">
							@Icon("book", "")
							<span>Documentation</span>
							<span style="margin-left:auto">@Icon("external", "w-3 h-3")</span>
						</a>
						<a href="https://github.com/ashupednekar/litefunctions/issues" target="_blank" rel="noopener" class="z-sidebar-link">
							@Icon("activity", "")
							<span>Platform status</span>
							<span class="z-dot z-dot-green" style="margin-left:auto"></span>
						</a>
					</div>
				</aside>

				<div class="z-main">
					<header class="z-titlebar">
						<button class="z-icon-btn z-sidebar-toggle" data-sidebar-toggle aria-label="Toggle sidebar">
							@Icon("sliders", "")
						</button>
						<div class="z-crumbs">
							<span class="z-crumb">{ data.Section }</span>
							<span class="z-crumb-sep">/</span>
							<span class="z-crumb-current">{ data.Title }</span>
						</div>
						<div class="z-titlebar-spacer"></div>
						<button class="z-cmd-trigger" onclick="openSpotlight()">
							@Icon("search", "")
							<span>Search workspace…</span>
							<span class="z-kbd">⌘</span><span class="z-kbd">K</span>
						</button>
						<span class="z-badge z-badge-green" title="Platform healthy" style="height:24px">
							<span class="z-dot z-dot-green"></span> Live
						</span>
						<div style="position:relative">
							<button class="z-user-chip" data-user-menu-btn>
								<span class="z-user-avatar">{ userInitial(data.Username) }</span>
								<span class="z-user-name">{ data.Username }</span>
								@Icon("chevron-down", "w-3 h-3 text-[#5b5b65]")
							</button>
							<div id="user-menu" class="z-user-menu">
								<div class="z-user-menu-head">
									<div class="z-user-avatar" style="width:28px;height:28px">{ userInitial(data.Username) }</div>
									<div>
										<div style="font-size:11.5px;color:var(--text)">{ data.Username }</div>
										<div style="font-size:10px;color:var(--text-3)">{ data.Role }</div>
									</div>
								</div>
								<a href="/dashboard/" class="z-user-menu-item">@Icon("grid", "") Workspace overview</a>
								<a href="/configuration/" class="z-user-menu-item">@Icon("key", "") Project settings</a>
								<div class="z-user-menu-sep"></div>
								<a href="/logout/" class="z-user-menu-item danger">@Icon("arrow-right", "") Sign out</a>
							</div>
						</div>
					</header>

					<main class="z-content">
						<div class="z-content-inner">
							@content
						</div>
					</main>

					<footer class="z-statusbar">
						<span class="z-status-item">@Icon("git-branch", "w-3 h-3") ui_overhaul</span>
						<span class="z-status-item z-status-hide-sm">@Icon("package", "w-3 h-3") { projectLabel(data.ProjectName) }</span>
						<span class="z-status-item z-status-hide-sm"><span class="z-status-dot"></span> NATS connected</span>
						<span class="z-status-item z-status-hide-sm">@Icon("cloud", "w-3 h-3") local-cluster</span>
						<span class="z-status-spacer"></span>
						<span class="z-status-item">@Icon("terminal", "w-3 h-3") Go 1.26</span>
						<span class="z-status-item">@Icon("clock", "w-3 h-3") 12ms</span>
						<span class="z-status-item" onclick="openSpotlight()" style="cursor:pointer">⌘K commands</span>
					</footer>
				</div>
			</div>

			<div id="toast-container"></div>

			<div id="spotlight-modal" class="z-spotlight" onclick="closeSpotlight()">
				<div class="z-spotlight-box" onclick="event.stopPropagation()">
					<div class="z-spotlight-input-row">
						@Icon("search", "")
						<input id="spotlight-input" class="z-spotlight-input" type="text" placeholder="Jump to a page, function, or endpoint…" autocomplete="off"/>
						<span class="z-kbd">esc</span>
					</div>
					<div id="spotlight-results" class="z-spotlight-results"></div>
					<div class="z-spotlight-foot">
						<span><span class="z-kbd">↑</span><span class="z-kbd">↓</span> navigate</span>
						<span><span class="z-kbd">↵</span> open</span>
						<span style="margin-left:auto">Litefunctions command palette</span>
					</div>
				</div>
			</div>
		</body>
	</html>
}

templ AuthLayout(content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Litefunctions · Self-hosted functions</title>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/js/portal.js" defer></script>
		</head>
		<body>
			<div class="z-auth">
				<nav class="z-auth-nav">
					<a href="/" class="z-brand" style="border:0;padding:0;height:auto">
						<span class="z-brand-mark">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
							</svg>
						</span>
						<span class="z-brand-name">litefunctions</span>
					</a>
					<span class="z-badge" style="margin-left:8px">self-hosted</span>
					<div style="margin-left:auto;display:flex;gap:8px;align-items:center">
						<a href="https://github.com/ashupednekar/litefunctions" target="_blank" rel="noopener" class="z-btn z-btn-ghost z-btn-sm">@Icon("book", "") Docs</a>
						<a href="https://github.com/ashupednekar/litefunctions" target="_blank" rel="noopener" class="z-btn z-btn-sm">@Icon("github", "") GitHub</a>
					</div>
				</nav>
				<div class="z-auth-body">
					<div class="z-auth-grid">
						@content
					</div>
				</div>
			</div>
			<div id="toast-container"></div>
		</body>
	</html>
}
