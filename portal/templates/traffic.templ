package templates

templ FunctionTrafficPanel(fn Function, ep Endpoint) {
	<div id={ "fn-traffic-" + fn.ID } class="z-fn-config hidden" data-fn-traffic
		data-endpoint-name={ trafficEndpointName(fn, ep) }
		data-endpoint-method={ trafficMethod(fn, ep) }
		data-endpoint-async={ boolString(trafficIsAsync(fn, ep)) }
		data-endpoint-ui={ boolString(fn.IsUI) }
		data-endpoint-id={ ep.ID }>
		<div class="z-fn-config-head">
			if fn.IsUI {
				<span class="z-panel-title">@Icon("external", "") Live preview</span>
			} else {
				<span class="z-panel-title">@Icon("play", "") Test &amp; logs</span>
			}
			<span class="z-badge z-badge-muted">{ fn.Name }</span>
			<span class="z-badge z-badge-green z-mono">{ trafficMethod(fn, ep) } { trafficEndpointName(fn, ep) }</span>
			if trafficIsAsync(fn, ep) {
				<span class="z-badge z-badge-purple">websocket</span>
			}
			if fn.IsUI {
				<a class="z-btn z-btn-sm" style="margin-left:auto" href={ templ.SafeURL(trafficPreviewPath(fn, ep)) } target="_blank" rel="noopener">@Icon("external", "") Open in new tab</a>
			}
		</div>

		if fn.IsUI {
			<iframe
				src={ templ.SafeURL(trafficPreviewPath(fn, ep)) }
				title={ fn.Name }
				style="width:100%;height:520px;border:1px solid var(--border);border-radius:6px;background:#0b0b0c"
			></iframe>
			<div class="z-help" style="margin:8px 0 0">Server-rendered UI preview. It calls other functions through their public endpoints or async workers.</div>
		} else {
			<div id={ "fn-test-host-" + fn.ID } class="fn-test-host"></div>
		}

		<div class="z-fn-traffic-logs">
			<div class="z-log-toolbar">
				<span class="z-label">@Icon("terminal", "") Live logs</span>
				<button id={ "fn-logs-toggle-" + fn.ID } class="z-btn z-btn-sm" onclick={ templ.JSFuncCall("toggleFnLogStream", fn.ID) }>Pause</button>
				<button class="z-btn z-btn-sm" onclick={ templ.JSFuncCall("clearFnLogs", fn.ID) }>Clear</button>
				<button class="z-btn z-btn-sm z-btn-primary" onclick={ templ.JSFuncCall("openFnLogFullscreen", fn.ID) }>@Icon("maximize", "") Fullscreen</button>
			</div>
			<div id={ "fn-logs-" + fn.ID } class="z-log z-fn-log"></div>
		</div>
	</div>
}

templ FunctionBuildPanel(fn Function) {
	<div id={ "fn-build-" + fn.ID } class="z-fn-config hidden" data-fn-build>
		<div class="z-fn-config-head">
			<span class="z-panel-title">@Icon("package", "") Build logs</span>
			<span class="z-badge z-badge-muted">{ fn.Name }</span>
			<span class="z-help">Gitea Actions runner output for this project.</span>
		</div>
		<div class="z-fn-traffic-logs">
			<div class="z-log-toolbar">
				<span class="z-label">@Icon("terminal", "") Live build logs</span>
				<button id={ "fn-build-toggle-" + fn.ID } class="z-btn z-btn-sm" onclick={ templ.JSFuncCall("toggleFnBuildStream", fn.ID) }>Pause</button>
				<button class="z-btn z-btn-sm" onclick={ templ.JSFuncCall("clearFnBuildLogs", fn.ID) }>Clear</button>
				<button class="z-btn z-btn-sm z-btn-primary" onclick={ templ.JSFuncCall("openFnBuildFullscreen", fn.ID) }>@Icon("maximize", "") Fullscreen</button>
			</div>
			<div id={ "fn-build-logs-" + fn.ID } class="z-log z-fn-log"></div>
		</div>
	</div>
}
