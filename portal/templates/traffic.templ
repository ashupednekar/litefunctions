package templates

script testTrafficEndpoint(id string) {
	window.testFnEndpoint(id);
}
script testTrafficWsEndpoint(id string) {
	window.openWsTestModalForEndpoint(id);
}

templ FunctionTrafficPanel(fn Function, ep Endpoint) {
	<div id={ "fn-traffic-" + fn.ID } class="z-fn-config hidden" data-fn-traffic>
		<div class="z-fn-config-head">
			<span class="z-panel-title">@Icon("activity", "") Traffic</span>
			<span class="z-badge z-badge-muted">{ fn.Name }</span>
			if ep.ID != "" {
				<span class="z-badge z-badge-green">endpoint live</span>
			} else {
				<span class="z-badge z-badge-amber">no endpoint</span>
			}
		</div>
		<div class="z-fn-traffic-grid">
			<div class="z-field">
				<span class="z-label">Endpoint</span>
				if ep.ID != "" {
					<input class="z-input z-mono" readonly value={ ep.URL }/>
					<div style="display:flex;gap:6px;margin-top:8px">
						<button class="z-btn z-btn-sm z-btn-primary" onclick={ testTrafficEndpoint(ep.ID) }>@Icon("play", "") Test endpoint</button>
						if ep.IsAsync {
							<button class="z-btn z-btn-sm" onclick={ testTrafficWsEndpoint(ep.ID) }>@Icon("network", "") Test WS</button>
						}
					</div>
					<span class="z-help">{ ep.Method } <span class="z-faint">·</span> { ep.Scope } <span class="z-faint">·</span> auto-mapped route</span>
				} else {
					<span class="z-help">No endpoint is mapped to this function yet.</span>
				}
				<div class="z-help" style="margin-top:10px">Live runtime + ingestor output for this function, streamed from Loki.</div>
			</div>
			<div class="z-field">
				<div class="z-log-toolbar">
					<span class="z-label">Live logs</span>
					<span id={ "fn-logs-status-" + fn.ID } class="z-badge z-badge-muted">idle</span>
					<button id={ "fn-logs-toggle-" + fn.ID } class="z-btn z-btn-sm" onclick={ templ.JSFuncCall("toggleFnLogStream", fn.ID) }>Pause</button>
					<button class="z-btn z-btn-sm" onclick={ templ.JSFuncCall("clearFnLogs", fn.ID) }>Clear</button>
					<button class="z-btn z-btn-sm z-btn-primary" onclick={ templ.JSFuncCall("openFnLogFullscreen", fn.ID) }>@Icon("maximize", "") Fullscreen</button>
				</div>
				<div id={ "fn-logs-" + fn.ID } class="z-log z-fn-log"></div>
			</div>
		</div>
	</div>
}
