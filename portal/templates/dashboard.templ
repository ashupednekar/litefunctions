package templates

templ DashboardContent(data DashboardData) {
	@PageHead("Overview", "Your project workspace, recent activity and request history.", "Workspace", templ.Raw(`
		<a href="/functions/" class="z-btn z-btn-primary">`+svgPlus()+` New function</a>
		<button class="z-btn" onclick="syncProject()">`+svgRefresh()+` Sync project</button>
	`))

	<div class="z-grid z-grid-4" style="margin-bottom:14px">
		<div class="z-stat">
			<div class="z-stat-label">@Icon("code", "") Functions</div>
			<div class="z-stat-value">{ itoa(data.FunctionCount) }</div>
			<div class="z-stat-delta"><span class="z-delta-up">▲ 2</span> this week <span class="z-faint">·</span> 5 runtimes</div>
		</div>
		<div class="z-stat">
			<div class="z-stat-label">@Icon("route", "") Endpoints</div>
			<div class="z-stat-value">{ itoa(data.EndpointCount) }</div>
			<div class="z-stat-delta">HTTP + WebSocket <span class="z-faint">·</span> auto-routed</div>
		</div>
		<div class="z-stat">
			<div class="z-stat-label">@Icon("activity", "") Requests · 24h</div>
			<div class="z-stat-value">1,284</div>
			<div class="z-stat-delta"><span class="z-delta-up">▲ 18.4%</span> vs previous period</div>
		</div>
		<div class="z-stat">
			<div class="z-stat-label">@Icon("gauge", "") P95 latency</div>
			<div class="z-stat-value">42<small>ms</small></div>
			<div class="z-stat-delta"><span class="z-delta-up">▼ 9ms</span> <span class="z-faint">·</span> 0 errors</div>
		</div>
	</div>

	<div>
		<div>
			<div class="z-panel">
				<div class="z-panel-header">
					<span class="z-panel-title">Your projects</span>
					<span class="z-badge z-badge-muted">{ itoa(len(data.Projects)) }</span>
					<div class="z-panel-actions">
						<button class="z-btn z-btn-sm" onclick="openJoinModal()">@Icon("users", "") Join</button>
						<button class="z-btn z-btn-sm z-btn-accent" onclick="openProjectModal()">@Icon("plus", "") New project</button>
					</div>
				</div>
				<div class="z-panel-body tight">
					if len(data.Projects) == 0 {
						<div class="z-empty">
							<div class="z-empty-icon">@Icon("grid", "")</div>
							<div class="z-empty-title">No projects yet</div>
							<div class="z-empty-sub">Create your first project to start deploying functions, endpoints and data services.</div>
							<button class="z-btn z-btn-primary z-btn-sm" onclick="openProjectModal()">Create project</button>
						</div>
					} else {
						<div class="z-grid z-grid-2" style="padding:12px">
							for _, p := range data.Projects {
								<div class={ "z-project-card", templ.KV("active", data.ActiveProjectID == p.ID) }>
									<div style="display:flex;align-items:flex-start;gap:10px">
										<span class="z-project-avatar" style="width:30px;height:30px;font-size:12px">{ projectInitial(p.Name) }</span>
										<div style="flex:1;min-width:0">
											<div style="display:flex;align-items:center;gap:7px">
												<span style="font-size:12.5px;font-weight:600;color:var(--text)">{ p.Name }</span>
												if data.ActiveProjectID == p.ID {
													<span class="z-badge z-badge-green"><span class="z-dot z-dot-green"></span> active</span>
												}
											</div>
											<div class="z-mono" style="font-size:9.5px;color:var(--text-3);margin-top:2px;text-transform:uppercase;letter-spacing:.06em">{ p.Role } · { shortID(p.ID) }</div>
										</div>
										if data.ActiveProjectID == p.ID {
											<button class="z-icon-btn" style="width:24px;height:24px" title="Sync project" onclick="event.stopPropagation(); syncProject()">@Icon("refresh", "")</button>
										}
									</div>
									<div style="display:flex;align-items:center;gap:6px;margin-top:12px">
										<button class={ "z-btn z-btn-sm", templ.KV("z-btn-primary", data.ActiveProjectID == p.ID) } style="flex:1" onclick={ templ.JSFuncCall("selectProject", p.ID) }>
											if data.ActiveProjectID == p.ID {
												@Icon("check", "") Selected
											} else {
												Select project
											}
										</button>
										if p.Role == "owner" {
											<button class="z-btn z-btn-sm" title="Invite member" onclick={ templ.JSFuncCall("openInviteModal", p.ID) }>@Icon("plus", "")</button>
											<button class="z-btn z-btn-sm" title="Manage access" onclick={ templ.JSFuncCall("openAccessModal", p.ID) }>@Icon("users", "")</button>
										}
									</div>
								</div>
							}
						</div>
					}
				</div>
			</div>

			if data.ActiveProjectID == "" {
				<div class="z-panel" style="margin-top:14px">
					<div class="z-empty">
						<div class="z-empty-icon">@Icon("arrow-right", "")</div>
						<div class="z-empty-title">Select a project to continue</div>
						<div class="z-empty-sub">Functions, endpoints and platform tools are scoped to the active project.</div>
					</div>
				</div>
			} else {
				<div class="z-grid z-grid-2" style="margin-top:14px">
					<a href="/agent/" class="z-action-card">
						<span class="z-list-icon" style="color:#c7b3ff;border-color:rgba(182,156,255,.25);background:rgba(182,156,255,.08)">@Icon("sparkles", "")</span>
						<div>
							<div class="z-list-title">Plan something new</div>
							<div class="z-list-sub">Describe a use case and generate functions, schemas and routes.</div>
						</div>
						@Icon("arrow-right", "ml-auto w-3 h-3 text-[#5b5b65]")
					</a>
					<a href="/dependencies/" class="z-action-card">
						<span class="z-list-icon" style="color:#8ab4ff;border-color:rgba(138,180,255,.25);background:rgba(138,180,255,.08)">@Icon("package", "")</span>
						<div>
							<div class="z-list-title">Manage dependencies</div>
							<div class="z-list-sub">go.mod, package.json, requirements and lockfiles.</div>
						</div>
						@Icon("arrow-right", "ml-auto w-3 h-3 text-[#5b5b65]")
					</a>
					<a href="/traffic/" class="z-action-card">
						<span class="z-list-icon" style="color:#e8b96a;border-color:rgba(232,185,106,.25);background:rgba(232,185,106,.08)">@Icon("shield", "")</span>
						<div>
							<div class="z-list-title">Traffic & rate limits</div>
							<div class="z-list-sub">Gateway routes, quotas and circuit breakers.</div>
						</div>
						@Icon("arrow-right", "ml-auto w-3 h-3 text-[#5b5b65]")
					</a>
					<a href="/functions/" class="z-action-card">
						<span class="z-list-icon" style="color:#76d6e0;border-color:rgba(118,214,224,.25);background:rgba(118,214,224,.08)">@Icon("cpu", "")</span>
						<div>
							<div class="z-list-title">Runtime & isolation</div>
							<div class="z-list-sub">Runtime interfaces, dedicated runtimes and repo settings.</div>
						</div>
						@Icon("arrow-right", "ml-auto w-3 h-3 text-[#5b5b65]")
					</a>
				</div>

				<div class="z-panel" style="margin-top:14px">
					<div class="z-tabs" data-tab-group style="padding:0 13px;margin:0">
						<button class="z-tab active" data-tab="activity">Activity</button>
						<button class="z-tab" data-tab="requests">Request log</button>
						<div class="z-panel-actions" style="margin-left:auto;padding:5px 0">
							<a href="/audit/" class="z-btn z-btn-sm z-btn-ghost">@Icon("clock", "") Audit log</a>
						</div>
					</div>
					<div data-tab-panel="activity">
						<div class="z-list">
							@activityItem("Deployed", "hello-world", "Go · function deployed to production", "2m ago", "green")
							@activityItem("Endpoint updated", "POST /lambda/orders", "Rate limit changed to 120 req/min", "18m ago", "blue")
							@activityItem("Dependency synced", "go.mod", "3 packages updated by project sync", "1h ago", "purple")
							@activityItem("Secret rotated", "STRIPE_SECRET_KEY", "Rotated by ashu", "3h ago", "amber")
						</div>
					</div>
					<div data-tab-panel="requests" style="display:none">
						<div class="z-table-wrap">
							<table class="z-table">
								<thead><tr><th>Time</th><th>Method</th><th>Path</th><th>Status</th><th>Latency</th><th>Key</th></tr></thead>
								<tbody>
									@requestLogRow("12:44:12", "POST", "/lambda/create-order", 201, "42ms", "key_…9f2a")
									@requestLogRow("12:44:09", "GET", "/lambda/list-orders", 200, "18ms", "key_…9f2a")
									@requestLogRow("12:43:58", "POST", "/lambda/pay-order", 200, "112ms", "key_…11bc")
									@requestLogRow("12:43:51", "GET", "/lambda/orders/8891", 200, "38ms", "key_…9f2a")
									@requestLogRow("12:43:40", "POST", "/lambda/stripe-webhook", 200, "188ms", "signature")
									@requestLogRow("12:43:37", "GET", "/lambda/orders/9999", 404, "9ms", "key_…9f2a")
									@requestLogRow("12:43:31", "POST", "/lambda/create-order", 429, "2ms", "key_…11bc")
								</tbody>
							</table>
						</div>
					</div>
				</div>
			}
		</div>
	</div>

	<!-- ACCESS MODAL -->
	<div id="access-modal" class="z-modal-backdrop" onclick="closeAccessModal()">
		<div class="z-modal" onclick="event.stopPropagation()">
			<div class="z-modal-header">
				@Icon("users", "w-4 h-4 text-[#a6a6af]")
				<span class="z-modal-title">Project access</span>
				<button class="z-icon-btn" style="margin-left:auto" data-close-modal>@Icon("close", "")</button>
			</div>
			<div class="z-modal-body">
				<div id="access-list" class="z-list" style="border:1px solid var(--border);border-radius:6px;overflow:hidden"></div>
			</div>
			<div class="z-modal-foot"><button class="z-btn" data-close-modal>Close</button></div>
		</div>
	</div>

	<!-- INVITE MODAL -->
	<div id="invite-modal" class="z-modal-backdrop" onclick="closeInviteModal()">
		<div class="z-modal" onclick="event.stopPropagation()">
			<div class="z-modal-header">
				@Icon("plus", "w-4 h-4 text-[#a6a6af]")
				<span class="z-modal-title">Invite teammate</span>
				<button class="z-icon-btn" style="margin-left:auto" data-close-modal>@Icon("close", "")</button>
			</div>
			<div class="z-modal-body">
				<p class="z-help" style="margin-top:0">Generate a one-time invite code. Codes expire in 24 hours.</p>
				<div class="z-input-group" style="margin-top:12px">
					<input id="invite-code-input" readonly class="z-input z-mono" style="text-align:center;font-size:14px;letter-spacing:.2em" value="…"/>
					<button onclick="copyInviteCode()" class="z-btn z-btn-primary">Copy</button>
				</div>
			</div>
			<div class="z-modal-foot"><button class="z-btn" data-close-modal>Dismiss</button></div>
		</div>
	</div>

	<!-- JOIN MODAL -->
	<div id="join-modal" class="z-modal-backdrop" onclick="closeJoinModal()">
		<div class="z-modal" onclick="event.stopPropagation()">
			<div class="z-modal-header">
				@Icon("users", "w-4 h-4 text-[#a6a6af]")
				<span class="z-modal-title">Join a project</span>
				<button class="z-icon-btn" style="margin-left:auto" data-close-modal>@Icon("close", "")</button>
			</div>
			<div class="z-modal-body">
				<p class="z-help" style="margin-top:0">Enter the 8-character code shared by the project owner.</p>
				<input id="join-code-input" class="z-input z-mono" style="margin-top:12px;text-align:center;letter-spacing:.3em;font-size:15px" placeholder="ABCDEFGH"/>
			</div>
			<div class="z-modal-foot">
				<button class="z-btn" data-close-modal>Cancel</button>
				<button class="z-btn z-btn-primary" onclick="submitJoinInvite()">Verify & join</button>
			</div>
		</div>
	</div>

	<!-- NEW PROJECT MODAL -->
	<div id="project-modal" class="z-modal-backdrop" onclick="closeProjectModal()">
		<div class="z-modal" onclick="event.stopPropagation()">
			<div class="z-modal-header">
				@Icon("plus", "w-4 h-4 text-[#a6a6af]")
				<span class="z-modal-title">Create project</span>
				<button class="z-icon-btn" style="margin-left:auto" data-close-modal>@Icon("close", "")</button>
			</div>
			<div class="z-modal-body">
				<div class="z-field">
					<label class="z-label" for="new-project-name">Project name</label>
					<input id="new-project-name" class="z-input" placeholder="My workspace"/>
					<span class="z-help">A Git repository and namespace will be provisioned for this project.</span>
				</div>
			</div>
			<div class="z-modal-foot">
				<button class="z-btn" data-close-modal>Cancel</button>
				<button class="z-btn z-btn-primary" onclick="submitNewProject()">Initialize project</button>
			</div>
		</div>
	</div>

	<script>
		function selectProject(id) {
			document.cookie = "lws_project=" + id + "; path=/; SameSite=Lax";
			location.reload();
		}
		function openProjectModal() { zOpenModal("project-modal"); }
		function closeProjectModal() { zCloseModal("project-modal"); }
		function openJoinModal() { zOpenModal("join-modal"); }
		function closeJoinModal() { zCloseModal("join-modal"); }
		function openAccessModal(id) {
			document.cookie = "lws_project=" + id + "; path=/; SameSite=Lax";
			zOpenModal("access-modal");
			loadProjectAccess();
		}
		function closeAccessModal() { zCloseModal("access-modal"); }
		function openInviteModal(id) {
			document.cookie = "lws_project=" + id + "; path=/; SameSite=Lax";
			zOpenModal("invite-modal");
			fetch("/api/projects/invites/", {method: "POST"})
				.then(r => r.json())
				.then(data => { document.getElementById("invite-code-input").value = data.code || "--------"; })
				.catch(() => { document.getElementById("invite-code-input").value = "--------"; });
		}
		function closeInviteModal() { zCloseModal("invite-modal"); }
		function copyInviteCode() {
			const input = document.getElementById("invite-code-input");
			input.select();
			navigator.clipboard.writeText(input.value).then(() => toast("Invite code copied", "success"));
		}
		async function submitNewProject() {
			const name = document.getElementById("new-project-name").value.trim();
			if (!name) return;
			try {
				await fetch("/api/projects/", {
					method: "POST",
					headers: {"Content-Type": "application/json"},
					body: JSON.stringify({name})
				});
				closeProjectModal();
				location.reload();
			} catch (e) { toast("Could not create project", "error"); }
		}
		async function submitJoinInvite() {
			const code = document.getElementById("join-code-input").value.trim();
			if (!code) return;
			const res = await fetch("/api/projects/join/?code=" + encodeURIComponent(code), {method: "POST"});
			if (res.ok) {
				const data = await res.json();
				document.cookie = "lws_project=" + data.project_id + "; path=/; SameSite=Lax";
				location.reload();
			} else {
				const data = await res.json().catch(() => ({}));
				toast(data.error || "Failed to join project", "error");
			}
		}
		async function syncProject() {
			try {
				await fetch("/api/projects/sync/", {method: "POST"});
				toast("Project sync started", "success");
				setTimeout(() => location.reload(), 600);
			} catch (e) { toast("Sync failed", "error"); }
		}
		async function loadProjectAccess() {
			const list = document.getElementById("access-list");
			list.innerHTML = '<div class="z-empty" style="padding:24px"><div class="z-empty-title">Loading members…</div></div>';
			try {
				const res = await fetch("/api/projects/access/");
				const users = await res.json();
				if (!Array.isArray(users) || users.length === 0) {
					list.innerHTML = '<div class="z-empty" style="padding:24px"><div class="z-empty-title">No members</div></div>';
					return;
				}
				list.innerHTML = users.map(u => {
					const initial = String(u.name || "?").substring(0, 2).toUpperCase();
					const action = u.role !== "owner"
						? '<button class="z-btn z-btn-sm z-btn-danger" onclick="revokeAccess(\'' + u.id + '\')">Revoke</button>'
						: '<span class="z-badge z-badge-muted">owner</span>';
					return '<div class="z-list-item"><span class="z-user-avatar">' + initial + '</span><div class="z-list-main"><div class="z-list-title">' + escapeHtml(u.name) + '</div><div class="z-list-sub">' + escapeHtml(u.role) + '</div></div>' + action + '</div>';
				}).join("");
			} catch (e) {
				list.innerHTML = '<div class="z-empty" style="padding:24px"><div class="z-empty-title">Could not load access</div></div>';
			}
		}
		async function revokeAccess(id) {
			if (!confirm("Revoke access for this member?")) return;
			await fetch("/api/projects/access/" + id + "/", {method: "DELETE"});
			loadProjectAccess();
		}
		function escapeHtml(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
	</script>
}

templ activityItem(title string, subject string, detail string, when string, tone string) {
	<div class="z-list-item">
		<span class={ "z-list-icon", templ.KV("tone-green", tone == "green"), templ.KV("tone-blue", tone == "blue"), templ.KV("tone-purple", tone == "purple"), templ.KV("tone-amber", tone == "amber") }>
			@Icon("activity", "")
		</span>
		<div class="z-list-main">
			<div style="display:flex;align-items:center;gap:6px">
				<span class="z-list-title">{ title }</span>
				<span class="z-mono" style="font-size:10px;color:var(--text-3)">{ subject }</span>
			</div>
			<div class="z-list-sub">{ detail }</div>
		</div>
		<span class="z-mono" style="font-size:9.5px;color:var(--text-4);white-space:nowrap">{ when }</span>
	</div>
}

templ requestLogRow(when string, method string, path string, status int, latency string, key string) {
	<tr>
		<td class="z-cell-mono">{ when }</td>
		<td><span class={ "z-badge", templ.KV("z-badge-green", method == "POST"), templ.KV("z-badge-blue", method == "GET"), templ.KV("z-badge-red", method == "DELETE") }>{ method }</span></td>
		<td class="z-cell-main z-mono" style="font-size:10.5px">{ path }</td>
		<td><span class={ "z-badge", templ.KV("z-badge-green", status < 300), templ.KV("z-badge-amber", status == 404), templ.KV("z-badge-red", status == 429 || status >= 500) }>{ itoa(status) }</span></td>
		<td class="z-cell-mono">{ latency }</td>
		<td class="z-cell-mono">{ key }</td>
	</tr>
}

templ healthRow(name string, detail string, status string) {
	<div class="z-list-item">
		<span class={ "z-dot", templ.KV("z-dot-green", status == "healthy"), templ.KV("z-dot-blue", status == "idle") }></span>
		<div class="z-list-main">
			<div class="z-list-title">{ name }</div>
			<div class="z-list-sub">{ detail }</div>
		</div>
		<span class="z-badge z-badge-muted">{ status }</span>
	</div>
}
