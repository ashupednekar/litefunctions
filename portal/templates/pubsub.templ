package templates

templ PubSubContent() {
	@PageHead("Pub/Sub", "Persistent JetStream streams, durable consumers and Olly telemetry — the SSR Go service that fronts Grafana.", "Data", templ.Raw(`
		<button class="z-btn" onclick="toast('Grafana deep-link is a placeholder','info')">`+svgExternal()+` Open Grafana</button>
		<button class="z-btn z-btn-primary" onclick="zOpenModal('stream-modal')">`+svgPlus()+` New stream</button>
	`))

	<div class="z-grid z-grid-4" style="margin-bottom:14px">
		<div class="z-stat"><div class="z-stat-label">@Icon("network", "") Streams</div><div class="z-stat-value">4</div><div class="z-stat-delta">2 file-backed <span class="z-faint">·</span> 2 memory</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("users", "") Consumers</div><div class="z-stat-value">7</div><div class="z-stat-delta">all active <span class="z-faint">·</span> 0 slow</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("activity", "") Messages / sec</div><div class="z-stat-value">2.4<small>k</small></div><div class="z-stat-delta"><span class="z-delta-up">▲ 12.6%</span> vs 1h ago</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("gauge", "") Consumer lag</div><div class="z-stat-value" style="color:var(--green)">0</div><div class="z-stat-delta">no pending acks <span class="z-faint">·</span> 3 replicas</div></div>
	</div>

	<div class="z-tabs" data-tab-group>
		<button class="z-tab active" data-tab="streams">Streams <span class="z-badge z-badge-muted">4</span></button>
		<button class="z-tab" data-tab="consumers">Consumers <span class="z-badge z-badge-muted">7</span></button>
		<button class="z-tab" data-tab="topology">Topology</button>
		<button class="z-tab" data-tab="olly">Olly telemetry <span class="z-badge z-badge-purple">SSR</span></button>
	</div>

	<div data-tab-panel="streams">
		<div class="z-split">
			<div>
				<div class="z-panel">
					<div class="z-panel-header">
						<span class="z-panel-title">Persistent streams</span>
						<div class="z-panel-actions">
							<div class="z-search" style="width:190px"><input class="z-input" style="height:25px;font-size:10.5px" placeholder="Filter streams…"/></div>
							<button class="z-btn z-btn-sm" onclick="refreshStreams()">@Icon("refresh", "")</button>
						</div>
					</div>
					<div class="z-table-wrap">
						<table class="z-table">
							<thead><tr><th>Stream</th><th>Subjects</th><th>Messages</th><th>Storage</th><th>Replicas</th><th>Retention</th><th>Persistence</th><th>Status</th><th></th></tr></thead>
							<tbody>
								@streamRow("ORDERS", "orders.>", "1.28M", "412 MB", "3", "7 days", "file-backed", "healthy")
								@streamRow("PAYMENTS", "payments.>", "384k", "96 MB", "3", "30 days", "file-backed", "healthy")
								@streamRow("NOTIFICATIONS", "notify.>", "88k", "12 MB", "1", "24 hours", "memory", "healthy")
								@streamRow("DEAD_LETTER", "dead.>", "24", "64 KB", "3", "90 days", "file-backed", "idle")
							</tbody>
						</table>
					</div>
					<div class="z-panel-foot"><span class="z-help">File-backed streams survive restarts. Memory streams are recreated on node restart.</span><span class="z-badge z-badge-blue" style="margin-left:auto">JetStream</span></div>
				</div>

				<div class="z-grid z-grid-2" style="margin-top:14px">
					<div class="z-panel">
						<div class="z-panel-header"><span class="z-panel-title">Throughput · last 3h</span><span class="z-badge z-badge-green">live</span></div>
						<div class="z-panel-body">
							<svg class="z-chart" viewBox="0 0 600 160" preserveAspectRatio="none">
								<defs><linearGradient id="z-area" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#8ab4ff" stop-opacity=".22"/><stop offset="100%" stop-color="#8ab4ff" stop-opacity="0"/></linearGradient></defs>
								<g class="z-chart-grid"><line x1="0" y1="40" x2="600" y2="40"/><line x1="0" y1="80" x2="600" y2="80"/><line x1="0" y1="120" x2="600" y2="120"/></g>
								<path class="z-chart-area" d="M0 128 C40 120 60 98 100 104 S160 72 200 82 S260 58 300 68 S360 42 400 54 S470 28 510 38 S570 20 600 26 L600 160 L0 160 Z"/>
								<path class="z-chart-line" d="M0 128 C40 120 60 98 100 104 S160 72 200 82 S260 58 300 68 S360 42 400 54 S470 28 510 38 S570 20 600 26"/>
								<text class="z-chart-label" x="4" y="12">2.8k/s</text><text class="z-chart-label" x="4" y="152">0</text>
							</svg>
						</div>
					</div>
					<div class="z-panel">
						<div class="z-panel-header"><span class="z-panel-title">Storage by stream</span></div>
						<div class="z-panel-body">
							@storageBar("ORDERS", 412, 520, "79%")
							@storageBar("PAYMENTS", 96, 520, "18%")
							@storageBar("NOTIFICATIONS", 12, 520, "2%")
							@storageBar("DEAD_LETTER", 1, 520, "1%")
						</div>
						<div class="z-panel-foot"><span class="z-help">JetStream file store · 4 GiB PVC</span><span class="z-mono" style="margin-left:auto;font-size:9.5px;color:var(--text-3)">521 MB / 4 GB</span></div>
					</div>
				</div>
			</div>

			<aside>
				<div class="z-panel">
					<div class="z-panel-header"><span class="z-panel-title">Cluster</span><span class="z-badge z-badge-green" style="margin-left:auto">healthy</span></div>
					<div class="z-panel-body tight">
						<div class="z-list">
							<div class="z-list-item"><span class="z-dot z-dot-green"></span><div class="z-list-main"><div class="z-list-title">nats-0</div><div class="z-list-sub">leader · 2.4k msg/s</div></div><span class="z-badge z-badge-muted">az-a</span></div>
							<div class="z-list-item"><span class="z-dot z-dot-green"></span><div class="z-list-main"><div class="z-list-title">nats-1</div><div class="z-list-sub">follower · 2.4k msg/s</div></div><span class="z-badge z-badge-muted">az-b</span></div>
							<div class="z-list-item"><span class="z-dot z-dot-green"></span><div class="z-list-main"><div class="z-list-title">nats-2</div><div class="z-list-sub">follower · 2.3k msg/s</div></div><span class="z-badge z-badge-muted">az-c</span></div>
						</div>
					</div>
					<div class="z-panel-foot"><span class="z-mono" style="font-size:9px;color:var(--text-4)">RAFT · 3/3 quorum</span></div>
				</div>
				<div class="z-panel" style="margin-top:14px">
					<div class="z-panel-header"><span class="z-panel-title">Dead letters</span></div>
					<div class="z-panel-body">
						<div style="display:flex;align-items:baseline;gap:6px"><span style="font-size:22px;font-weight:600;letter-spacing:-.04em">24</span><span class="z-help">messages</span></div>
						<div class="z-help" style="margin-top:4px">Across 3 consumers. Oldest message 2h ago.</div>
						<button class="z-btn" style="width:100%;margin-top:10px" onclick="toast('Dead-letter inspection is a placeholder','info')">Inspect messages</button>
					</div>
				</div>
				<div class="z-panel" style="margin-top:14px">
					<div class="z-panel-header"><span class="z-panel-title">Olly</span><span class="z-badge z-badge-purple">SSR Go</span></div>
					<div class="z-panel-body">
						<div class="z-help" style="line-height:1.6">Olly renders server-side telemetry panels and proxies Grafana queries with project-scoped auth.</div>
						<dl class="z-kv" style="margin-top:10px"><dt>Endpoint</dt><dd>olly:8080</dd><dt>Grafana</dt><dd>connected</dd><dt>Datasource</dt><dd>prometheus</dd></dl>
					</div>
				</div>
			</aside>
		</div>
	</div>

	<div data-tab-panel="consumers" style="display:none">
		<div class="z-panel">
			<div class="z-panel-header"><span class="z-panel-title">Consumers</span><span class="z-panel-sub">durable pull consumers</span><div class="z-panel-actions"><button class="z-btn z-btn-sm">@Icon("plus", "") New consumer</button></div></div>
			<div class="z-table-wrap">
				<table class="z-table">
					<thead><tr><th>Consumer</th><th>Stream</th><th>Filter</th><th>Delivered</th><th>Pending</th><th>Ack wait</th><th>Status</th><th></th></tr></thead>
					<tbody>
						@consumerRow("orders-worker", "ORDERS", "orders.created", "1.28M", "0", "30s", "active")
						@consumerRow("payments-worker", "PAYMENTS", "payments.paid", "384k", "0", "30s", "active")
						@consumerRow("order-audit", "ORDERS", "orders.>", "1.28M", "2", "60s", "active")
						@consumerRow("notify-email", "NOTIFICATIONS", "notify.email", "81k", "0", "30s", "idle")
						@consumerRow("notify-push", "NOTIFICATIONS", "notify.push", "7k", "0", "30s", "idle")
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<div data-tab-panel="topology" style="display:none">
		<div class="z-panel">
			<div class="z-panel-header"><span class="z-panel-title">Message topology</span><span class="z-panel-sub">producers → streams → consumers → functions</span></div>
			<div class="z-panel-body">
				<div class="z-flow">
					<div class="z-flow-node"><span class="z-list-icon">@Icon("code", "")</span><div><div class="z-list-title">create-order</div><div class="z-list-sub">function</div></div></div>
					<span class="z-flow-arrow">@Icon("arrow-right", "")</span>
					<div class="z-flow-node accent"><span class="z-list-icon">@Icon("network", "")</span><div><div class="z-list-title">ORDERS</div><div class="z-list-sub">stream</div></div></div>
					<span class="z-flow-arrow">@Icon("arrow-right", "")</span>
					<div class="z-flow-node"><span class="z-list-icon">@Icon("bolt", "")</span><div><div class="z-list-title">orders-worker</div><div class="z-list-sub">consumer</div></div></div>
					<span class="z-flow-arrow">@Icon("arrow-right", "")</span>
					<div class="z-flow-node"><span class="z-list-icon">@Icon("code", "")</span><div><div class="z-list-title">fulfil-order</div><div class="z-list-sub">function</div></div></div>
				</div>
				<div class="z-divider"></div>
				<div class="z-flow">
					<div class="z-flow-node"><span class="z-list-icon">@Icon("code", "")</span><div><div class="z-list-title">pay-order</div><div class="z-list-sub">function</div></div></div>
					<span class="z-flow-arrow">@Icon("arrow-right", "")</span>
					<div class="z-flow-node accent"><span class="z-list-icon">@Icon("network", "")</span><div><div class="z-list-title">PAYMENTS</div><div class="z-list-sub">stream</div></div></div>
					<span class="z-flow-arrow">@Icon("arrow-right", "")</span>
					<div class="z-flow-node"><span class="z-list-icon">@Icon("bolt", "")</span><div><div class="z-list-title">payments-worker</div><div class="z-list-sub">consumer</div></div></div>
					<span class="z-flow-arrow">@Icon("arrow-right", "")</span>
					<div class="z-flow-node"><span class="z-list-icon">@Icon("code", "")</span><div><div class="z-list-title">send-receipt</div><div class="z-list-sub">function</div></div></div>
				</div>
				<div class="z-divider"></div>
				<div class="z-flow">
					<div class="z-flow-node"><span class="z-list-icon">@Icon("code", "")</span><div><div class="z-list-title">notify</div><div class="z-list-sub">function</div></div></div>
					<span class="z-flow-arrow">@Icon("arrow-right", "")</span>
					<div class="z-flow-node accent"><span class="z-list-icon">@Icon("network", "")</span><div><div class="z-list-title">NOTIFICATIONS</div><div class="z-list-sub">stream</div></div></div>
					<span class="z-flow-arrow">@Icon("arrow-right", "")</span>
					<div class="z-flow-node"><span class="z-list-icon">@Icon("bolt", "")</span><div><div class="z-list-title">notify-email</div><div class="z-list-sub">consumer</div></div></div>
				</div>
			</div>
		</div>
	</div>

	<div data-tab-panel="olly" style="display:none">
		<div class="z-split">
			<div class="z-panel">
				<div class="z-panel-header">
					<span class="z-panel-title">Olly · telemetry</span>
					<span class="z-badge z-badge-purple">server-rendered</span>
					<span class="z-panel-sub">Grafana proxy · project-scoped</span>
					<div class="z-panel-actions"><button class="z-btn z-btn-sm" onclick="refreshStreams()">@Icon("refresh", "") Refresh</button></div>
				</div>
				<div class="z-panel-body">
					<div class="z-grid z-grid-4" style="gap:9px;margin-bottom:14px">
						<div class="z-stat" style="padding:10px"><div class="z-stat-label">Msgs / sec</div><div class="z-stat-value" style="font-size:20px">2,418</div></div>
						<div class="z-stat" style="padding:10px"><div class="z-stat-label">Publish p95</div><div class="z-stat-value" style="font-size:20px">4<small>ms</small></div></div>
						<div class="z-stat" style="padding:10px"><div class="z-stat-label">Consume p95</div><div class="z-stat-value" style="font-size:20px">11<small>ms</small></div></div>
						<div class="z-stat" style="padding:10px"><div class="z-stat-label">Errors</div><div class="z-stat-value" style="font-size:20px;color:var(--green)">0</div></div>
					</div>
					<svg class="z-chart" style="height:220px" viewBox="0 0 900 220" preserveAspectRatio="none">
						<defs><linearGradient id="z-area" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#8ab4ff" stop-opacity=".25"/><stop offset="100%" stop-color="#8ab4ff" stop-opacity="0"/></linearGradient></defs>
						<g class="z-chart-grid"><line x1="0" y1="55" x2="900" y2="55"/><line x1="0" y1="110" x2="900" y2="110"/><line x1="0" y1="165" x2="900" y2="165"/></g>
						<path class="z-chart-area" d="M0 162 C40 150 70 132 110 138 S170 106 220 114 S290 80 340 92 S410 64 460 74 S530 48 580 58 S650 34 700 44 S780 24 830 32 S870 18 900 22 L900 220 L0 220 Z"/>
						<path class="z-chart-line" d="M0 162 C40 150 70 132 110 138 S170 106 220 114 S290 80 340 92 S410 64 460 74 S530 48 580 58 S650 34 700 44 S780 24 830 32 S870 18 900 22"/>
						<text class="z-chart-label" x="4" y="14">3.0k/s</text><text class="z-chart-label" x="4" y="212">0</text>
					</svg>
					<div class="z-panel-foot" style="border:0;padding-left:0;padding-right:0">
						<span class="z-help">Rendered by Olly · iframe-free · grafana-api /api/ds/query</span>
						<span class="z-mono" style="margin-left:auto;font-size:9.5px;color:var(--text-3)">updated 4s ago</span>
					</div>
				</div>
			</div>
			<aside>
				<div class="z-panel">
					<div class="z-panel-header"><span class="z-panel-title">Olly connection</span></div>
					<div class="z-panel-body">
						<dl class="z-kv">
							<dt>Service</dt><dd>olly.litefunctions</dd>
							<dt>Port</dt><dd>8080</dd>
							<dt>Upstream</dt><dd>grafana:3000</dd>
							<dt>Datasource</dt><dd>prometheus</dd>
							<dt>Scopes</dt><dd>project:read</dd>
							<dt>Cache</dt><dd>15s</dd>
						</dl>
						<div class="z-alert z-alert-blue" style="margin-top:10px"><div>Placeholder: Olly will call Grafana APIs server-side and share the project's Grafana token via the operator.</div></div>
					</div>
				</div>
				<div class="z-panel" style="margin-top:14px">
					<div class="z-panel-header"><span class="z-panel-title">Alerts</span><span class="z-badge z-badge-green" style="margin-left:auto">0 firing</span></div>
					<div class="z-panel-body tight"><div class="z-empty" style="padding:20px 12px"><div class="z-empty-title">No active alerts</div><div class="z-empty-sub">Lag, error-rate and storage thresholds are nominal.</div></div></div>
				</div>
			</aside>
		</div>
	</div>

	<div id="stream-modal" class="z-modal-backdrop" onclick="zCloseModal('stream-modal')">
		<div class="z-modal" onclick="event.stopPropagation()">
			<div class="z-modal-header">@Icon("network", "w-4 h-4")<span class="z-modal-title">Create stream</span><button class="z-icon-btn" style="margin-left:auto" data-close-modal>@Icon("close", "")</button></div>
			<div class="z-modal-body">
				<div class="z-field"><label class="z-label">Name</label><input class="z-input z-mono" placeholder="ORDERS"/></div>
				<div class="z-field" style="margin-top:11px"><label class="z-label">Subjects</label><input class="z-input z-mono" placeholder="orders.>"/></div>
				<div class="z-grid z-grid-2" style="margin-top:11px">
					<div class="z-field"><label class="z-label">Replicas</label><select class="z-select"><option>3</option><option>1</option></select></div>
					<div class="z-field"><label class="z-label">Retention</label><select class="z-select"><option>7 days</option><option>30 days</option><option>work queue</option></select></div>
				</div>
			</div>
			<div class="z-modal-foot"><button class="z-btn" data-close-modal>Cancel</button><button class="z-btn z-btn-primary" onclick="zCloseModal('stream-modal'); toast('Stream creation is a placeholder','success')">Create stream</button></div>
		</div>
	</div>

	<script>
		async function refreshStreams() {
			toast("Refreshing JetStream state…", "info");
			await zDummyFetch("/api/pubsub/streams/", {streams: []});
			setTimeout(() => toast("Streams refreshed", "success"), 500);
		}
	</script>
}

templ streamRow(name string, subjects string, messages string, storage string, replicas string, retention string, persistence string, status string) {
	<tr>
		<td class="z-cell-main z-mono" style="font-size:10.5px">{ name }</td>
		<td class="z-cell-mono">{ subjects }</td>
		<td class="z-cell-mono">{ messages }</td>
		<td class="z-cell-mono">{ storage }</td>
		<td><span class="z-badge">{ replicas }</span></td>
		<td class="z-cell-mono">{ retention }</td>
		<td><span class={ "z-badge", templ.KV("z-badge-blue", persistence == "file-backed"), templ.KV("z-badge-muted", persistence != "file-backed") }>{ persistence }</span></td>
		<td><span class={ "z-badge", templ.KV("z-badge-green", status == "healthy"), templ.KV("z-badge-muted", status == "idle") }>{ status }</span></td>
		<td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("more", "")</button></td>
	</tr>
}

templ consumerRow(name string, stream string, filter string, delivered string, pending string, ack string, status string) {
	<tr>
		<td class="z-cell-main z-mono" style="font-size:10.5px">{ name }</td>
		<td class="z-cell-mono">{ stream }</td>
		<td class="z-cell-mono">{ filter }</td>
		<td class="z-cell-mono">{ delivered }</td>
		<td><span class={ "z-badge", templ.KV("z-badge-green", pending == "0"), templ.KV("z-badge-amber", pending != "0") }>{ pending }</span></td>
		<td class="z-cell-mono">{ ack }</td>
		<td><span class="z-badge z-badge-green">{ status }</span></td>
		<td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("more", "")</button></td>
	</tr>
}

templ storageBar(name string, used int, total int, pct string) {
	<div style="margin-bottom:10px">
		<div style="display:flex;justify-content:space-between;margin-bottom:4px"><span class="z-mono" style="font-size:9.5px;color:var(--text-3)">{ name }</span><span class="z-mono" style="font-size:9.5px;color:var(--text-3)">{ pct }</span></div>
		<div class="z-progress"><span style={ "width:" + pct }></span></div>
	</div>
}
