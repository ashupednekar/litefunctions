package templates

script copyFn(id string) {
}
script openCreate() {
}
script closeCreate() {
}
script selectLang(lang string) {
}
script openEdit(id string, lang string) {
}
script closeEdit() {
}
script saveCreate(exit bool) {
}
script saveEdit(exit bool) {
}

templ FunctionContent(functions []Function, langs []Lang, activeProjectID string, username string, samples map[string]CodeSample) {

@PageHead("Functions", "Write, edit and deploy functions in Go, Rust, Python, TypeScript or Lua.", "Workspace", templ.Raw(`
	<button class="z-btn" onclick="openSpotlight()">`+svgSearch()+` Search</button>
	<button class="z-btn z-btn-primary" onclick="openCreate()">`+svgPlus()+` New function</button>
`))

<details class="z-panel z-compute-config" style="margin-bottom:14px">
	<summary class="z-panel-header" style="margin:0;cursor:pointer">
		@Icon("cpu", "")
		<span class="z-panel-title">Compute &amp; isolation</span>
		<span class="z-badge z-badge-amber">dummy data</span>
		<span class="z-panel-sub">runtime interface and execution mode</span>
		<span style="margin-left:auto;color:var(--text-4);display:flex">@Icon("chevron-down", "")</span>
	</summary>
	<div class="z-panel-body">
		<div class="z-grid z-grid-3">
			<div class="z-field">
				<label class="z-label" for="runtime-interface">Runtime interface</label>
				<select id="runtime-interface" class="z-select">
					<option selected>containerd · runc (default)</option>
					<option>gVisor · runsc (preview)</option>
					<option>Kata Containers · microVM (preview)</option>
					<option>WASM / WASI · wasmtime (future)</option>
					<option>Firecracker · microVM (future)</option>
				</select>
				<span class="z-help">Containerd is the default execution path. Stronger isolation profiles are opt-in per function.</span>
			</div>
			<div class="z-field">
				<span class="z-label">Dynamic language runtime</span>
				<div class="z-mode-toggle" id="dyn-runtime-toggle">
					<button class="z-mode-btn selected" onclick="setDynRuntime('shared')">Shared</button>
					<button class="z-mode-btn" onclick="setDynRuntime('dedicated')">Dedicated</button>
				</div>
				<span class="z-help">Python, TypeScript and Lua can share a warm interpreter pool. Go and Rust always ship dedicated binaries.</span>
			</div>
			<div class="z-field">
				<span class="z-label">Dedicated resources</span>
				<div class="z-grid z-grid-2" style="gap:7px">
					<select class="z-select" aria-label="vCPU"><option>0.5 vCPU</option><option selected>1 vCPU</option><option>2 vCPU</option></select>
					<select class="z-select" aria-label="Memory"><option>256 MiB</option><option selected>512 MiB</option><option>1 GiB</option></select>
				</div>
				<span class="z-help">Applied only when the dedicated runtime is selected.</span>
			</div>
		</div>
		<div class="z-compute-foot">
			<a class="z-btn z-btn-sm" href="https://github.com/ashupednekar/litefunctions" target="_blank" rel="noopener">@Icon("github", "") Open project repo</a>
			<span class="z-help">Runtime config is stored with the function package. The UI is a placeholder until the operator API lands.</span>
			<button class="z-btn z-btn-sm z-btn-primary" style="margin-left:auto" onclick="toast('Compute config saved (placeholder)','success')">@Icon("save", "") Save config</button>
		</div>
	</div>
</details>

<div class="z-panel">
	<div class="z-panel-header">
		<span class="z-panel-title">Functions</span>
		<span class="z-badge z-badge-muted">{ itoa(len(functions)) }</span>
		<span class="z-panel-sub">repo-backed · ace editor</span>
		<div class="z-panel-actions">
			<div class="z-search" style="width:180px"><input id="fn-filter" class="z-input" style="height:25px;font-size:10.5px" placeholder="Filter functions…" oninput="filterFunctions(this.value)"/></div>
			<button class="z-btn z-btn-sm" onclick="refreshList()">@Icon("refresh", "")</button>
		</div>
	</div>
	<div id="fn-list-container" class="z-panel-body tight" style="min-height:120px">
		if len(functions) == 0 {
			<div class="z-empty" style="padding:40px 16px">
				<div class="z-empty-icon">@Icon("code", "")</div>
				<div class="z-empty-title">No functions yet</div>
				<div class="z-empty-sub">Create your first function to start deploying.</div>
				<button class="z-btn z-btn-primary z-btn-sm" onclick="openCreate()">New function</button>
			</div>
		}
		for _, fn := range functions {
			<div class="z-fn-row" data-fn-name={ fn.Name }>
				<span class="z-fn-icon"><img src={ fn.Icon } alt=""/></span>
				<div class="z-fn-main">
					<div class="z-fn-name">{ fn.Name }</div>
					<div class="z-fn-meta">
						<span class="z-badge z-badge-muted">{ fn.Language }</span>
						<span class="z-mono" style="font-size:9px;color:var(--text-4)">{ shortID(fn.ID) }</span>
					</div>
				</div>
				<div class="z-fn-actions">
					<button class="z-icon-btn" title="Copy curl" onclick={ copyFn(fn.ID) }>@Icon("copy", "")</button>
					<button class="z-btn z-btn-sm" onclick={ templ.JSFuncCall("openEdit", fn.ID, fn.Language) }>@Icon("edit", "") Edit</button>
					if fn.EndpointID != "" {
						<a class="z-btn z-btn-sm" title="Endpoint" href={ templ.SafeURL("/traffic/?expand=" + fn.EndpointID) }>@Icon("route", "") Test</a>
					} else {
						<span class="z-btn z-btn-sm" style="opacity:.45" title="No endpoint">@Icon("route", "") Test</span>
					}
					<button class="z-icon-btn" title="Delete" onclick={ templ.JSFuncCall("deleteFn", fn.ID) }>@Icon("trash", "")</button>
				</div>
			</div>
		}
	</div>
</div>

<!-- CREATE -->
<div id="create-modal" class="z-modal-backdrop" onclick="closeCreate()">
	<div class="z-modal" style="width:min(1180px,96vw);height:min(90vh,940px);display:flex;flex-direction:column" onclick="event.stopPropagation()">
		<div class="z-modal-header">
			@Icon("code", "")
			<span class="z-modal-title">New function</span>
			<div class="z-mode-toggle" style="margin-left:auto">
				<button id="create-mode-sync" onclick="setCreateMode('sync')" class="z-mode-btn">Sync</button>
				<button id="create-mode-async" onclick="setCreateMode('async')" class="z-mode-btn">Async</button>
			</div>
			<label class="z-check" style="margin-left:10px"><input id="create-vim-toggle" type="checkbox" checked/> Vim</label>
			<button class="z-icon-btn" style="margin-left:4px" onclick="closeCreate()">@Icon("close", "")</button>
		</div>
		<div class="z-modal-body" style="display:flex;flex-direction:column;gap:12px;flex:1;min-height:0;overflow:auto">
			<div class="z-grid z-grid-2" style="gap:12px">
				<div class="z-field">
					<span class="z-label">Language</span>
					<div class="z-lang-grid">
						for _, lang := range langs {
							<button data-lang={ lang.ID } class="z-lang-tile" id={ "lang-" + lang.ID }>
								<img src={ lang.Icon } alt=""/>
								<span>{ lang.Label }</span>
							</button>
						}
					</div>
				</div>
				<div class="z-field">
					<label class="z-label" for="fn-name-input">Function name</label>
					<input id="fn-name-input" class="z-input" placeholder="e.g. create-order" oninput="renameFunctionDir('create')"/>
					<span class="z-help">Each function is a directory in the repo. Lowercase letters, digits and dashes.</span>
				</div>
			</div>
			<div class="z-editor-layout">
				<aside class="z-file-tree" id="create-file-tree"></aside>
				<section class="z-editor-pane">
					<div class="z-editor-breadcrumb">
						<span id="create-editor-path" class="z-mono">function/</span>
						<span style="margin-left:auto;display:flex;gap:2px">
							<button class="z-icon-btn" style="width:22px;height:22px" title="Search files (space space in vim)" onclick="openTelescope('create','files')">@Icon("search", "")</button>
							<button class="z-icon-btn" style="width:22px;height:22px" title="Search content (space / in vim)" onclick="openTelescope('create','content')">@Icon("file", "")</button>
						</span>
					</div>
					<div class="z-editor-shell" style="display:flex;flex-direction:column">
						<div id="create-ace" style="flex:1"></div>
					</div>
					<div class="z-editor-hint">Vim: <span class="z-kbd">space</span><span class="z-kbd">space</span> files · <span class="z-kbd">space</span><span class="z-kbd">/</span> content · only the main file is persisted in this preview.</div>
				</section>
			</div>
		</div>
		<div class="z-modal-foot">
			<button class="z-btn" onclick="closeCreate()">Cancel</button>
			<button class="z-btn" onclick="saveCreate(false)">@Icon("save", "") Save draft</button>
			<button class="z-btn z-btn-primary" onclick="saveCreate(true)">@Icon("check", "") Create &amp; deploy</button>
		</div>
	</div>
</div>

<!-- EDIT -->
<div id="edit-modal" class="z-modal-backdrop" onclick="closeEdit()">
	<div class="z-modal" style="width:min(1180px,96vw);height:min(90vh,940px);display:flex;flex-direction:column" onclick="event.stopPropagation()">
		<div class="z-modal-header">
			@Icon("edit", "")
			<span class="z-modal-title">Edit function</span>
			<div class="z-mode-toggle" style="margin-left:auto">
				<button id="edit-mode-sync" onclick="setEditMode('sync')" class="z-mode-btn">Sync</button>
				<button id="edit-mode-async" onclick="setEditMode('async')" class="z-mode-btn">Async</button>
			</div>
			<label class="z-check" style="margin-left:10px"><input id="edit-vim-toggle" type="checkbox" checked/> Vim</label>
			<button class="z-icon-btn" style="margin-left:4px" onclick="closeEdit()">@Icon("close", "")</button>
		</div>
		<div class="z-modal-body" style="display:flex;flex-direction:column;gap:12px;flex:1;min-height:0;overflow:auto">
			<div class="z-editor-layout">
				<aside class="z-file-tree" id="edit-file-tree"></aside>
				<section class="z-editor-pane">
					<div class="z-editor-breadcrumb">
						<span id="edit-editor-path" class="z-mono">function/</span>
						<span style="margin-left:auto;display:flex;gap:2px">
							<button class="z-icon-btn" style="width:22px;height:22px" title="Search files (space space in vim)" onclick="openTelescope('edit','files')">@Icon("search", "")</button>
							<button class="z-icon-btn" style="width:22px;height:22px" title="Search content (space / in vim)" onclick="openTelescope('edit','content')">@Icon("file", "")</button>
						</span>
					</div>
					<div class="z-editor-shell" style="display:flex;flex-direction:column">
						<div id="edit-ace" style="flex:1"></div>
					</div>
					<div class="z-editor-hint">Vim: <span class="z-kbd">space</span><span class="z-kbd">space</span> files · <span class="z-kbd">space</span><span class="z-kbd">/</span> content · only the main file is persisted in this preview.</div>
				</section>
			</div>
		</div>
		<div class="z-modal-foot">
			<span class="z-help" style="margin-right:auto">The file tree is a UI preview; multi-file persistence is tracked in #84.</span>
			<button class="z-btn" onclick="closeEdit()">Cancel</button>
			<button class="z-btn z-btn-primary" onclick="saveEdit(true)">@Icon("check", "") Save changes</button>
		</div>
	</div>
</div>

<!-- DELETE CONFIRM MODAL -->
<div id="delete-modal" class="z-modal-backdrop" onclick="closeDelete()">
	<div class="z-modal" onclick="event.stopPropagation()">
		<div class="z-modal-header">
			@Icon("trash", "")
			<span class="z-modal-title">Delete function?</span>
			<button class="z-icon-btn" style="margin-left:auto" onclick="closeDelete()">@Icon("close", "")</button>
		</div>
		<div class="z-modal-body">
			<p class="z-help" style="margin:0">This removes the function from the repository and deletes its generated endpoint. This action cannot be undone.</p>
		</div>
		<div class="z-modal-foot">
			<button class="z-btn" onclick="closeDelete()">Cancel</button>
			<button class="z-btn z-btn-danger" onclick="confirmDelete()">Delete function</button>
		</div>
	</div>
</div>

<!-- TELESCOPE -->
<div id="z-telescope" class="z-telescope" onclick="closeTelescope()">
	<div class="z-telescope-box" onclick="event.stopPropagation()">
		<div class="z-telescope-input-row">
			@Icon("search", "")
			<input id="z-telescope-input" class="z-telescope-input" placeholder="Search files…" oninput="updateTelescope()"/>
			<span id="z-telescope-kind" class="z-badge z-badge-muted">files</span>
		</div>
		<div id="z-telescope-results" class="z-telescope-results"></div>
		<div class="z-telescope-foot">
			<span><span class="z-kbd">↑</span><span class="z-kbd">↓</span> navigate</span>
			<span><span class="z-kbd">↵</span> open</span>
			<span><span class="z-kbd">esc</span> close</span>
		</div>
	</div>
</div>

	@templ.JSONScript("function-samples", samples)

	<!-- ACE from CDN (fallback to local if needed) -->
	<script>
	(function(){
		const cdn = "https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.3/";
		const s1 = document.createElement('script');
		s1.src = cdn + 'ace.js';
		s1.onload = () => {
            ace.config.set('basePath', cdn);
            ace.config.set('modePath', cdn);
            ace.config.set('themePath', cdn);
			// load optional ext and keybinding after ace
			const s2 = document.createElement('script');
			s2.src = cdn + 'ext-language_tools.js';
			document.head.appendChild(s2);
			const s3 = document.createElement('script');
			s3.src = cdn + 'keybinding-vim.js';
            s3.onload = () => {
                // Periodically check for Vim global to ensure it's ready
                const check = () => {
                    if (ace.require && ace.require("ace/keyboard/vim")) {
                        defineVimEx();
                    } else {
                        setTimeout(check, 100);
                    }
                };
                check();
            };
			document.head.appendChild(s3);
		};
		document.head.appendChild(s1);
	})();
	</script>

	<script>
window.ACE_MODES = {
    python: "python",
    ts: "typescript",
    go: "golang",
    rust: "rust",
    lua: "lua"
};

window.__activeProjectID = "{ activeProjectID }";

let createEditor = null;
let editEditor = null;
let selectedLang = "python";
let selectedCreateMode = "sync";
let selectedEditMode = "sync";



const modeMap = window.ACE_MODES;

/* --- Helpers for project id resolution (use cookie fallback) --- */
function getCookie(name) {
  const v = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
  return v ? decodeURIComponent(v.pop()) : '';
}

function getActiveProjectID() {
  const raw = (window.__activeProjectID || '').trim();
  // treat templ placeholder or empty as "not provided"
  if (raw && raw !== '{ activeProjectID }' && raw !== '') return raw;
  // fallback to cookie
  return getCookie('lws_project') || '';
}

function projectUrl(pathSuffix) {
  const pid = getActiveProjectID();
  if (!pid) {
    console.warn('no active project id set (lws_project cookie missing and server didn\'t provide one)');
    return pathSuffix || '';
  }
  if (pathSuffix && pathSuffix[0] !== '/') pathSuffix = '/' + pathSuffix;
  // NOTE: prepend /api here so we call server routes under /api
  return `/api/projects/${encodeURIComponent(pid)}${pathSuffix || ''}`;
}

/* --- Ace + Vim ex helpers --- */
window.__isCreateEditor = false;
window.__isEditEditor = false;

function defineVimEx(){
  try {
    const vimMod = ace.require("ace/keyboard/vim") || window.Vim;
    if (!vimMod) return;
    const Vim = vimMod.CodeMirror ? vimMod.CodeMirror.Vim : (vimMod.Vim || vimMod);
    if (!Vim || !Vim.defineEx) return;
    
    const writeHandler = function() {
        if (window.__isCreateEditor) saveCreate(false);
        else if (window.__isEditEditor) saveEdit(false);
    };
    const saveAndQuitHandler = function() {
        if (window.__isCreateEditor) saveCreate(true);
        else if (window.__isEditEditor) saveEdit(true);
    };
    const quitHandler = function() {
        if (window.__isCreateEditor) closeCreate();
        else if (window.__isEditEditor) closeEdit();
    };

    Vim.defineEx("w", "", writeHandler);
    Vim.defineEx("write", "", writeHandler);
    Vim.defineEx("wq", "", saveAndQuitHandler);
    Vim.defineEx("x", "", saveAndQuitHandler);
    Vim.defineEx("q", "", quitHandler);
    Vim.defineEx("quit", "", quitHandler);
    Vim.defineEx("q!", "", quitHandler);
    Vim.defineEx("quit!", "", quitHandler);
    
    console.log("LWS: Vim Ex commands registered");
    Vim.__lws_ex_defined = true;
  } catch (e) {
    console.error("LWS: Error in defineVimEx", e);
  }
}

/* --- UI functions --- */
function copyFn(id){
  const curl = `curl -X POST ${projectUrl(`/api/functions/`)}${id ? id : ''}`;
  navigator.clipboard.writeText(curl);
}

function getTemplate(lang, mode) {
  const el = document.getElementById("function-samples");
  if (!el) return "";
  let samples = {};
  try {
    samples = JSON.parse(el.textContent || "{}");
  } catch (e) {
    console.error("failed to parse function samples", e);
    return "";
  }
  const entry = samples[lang];
  if (!entry) return "";
  if (typeof entry === "string") return entry;
  return entry[mode] || entry.sync || "";
}

function setCreateMode(mode) {
  if (!mode || mode === selectedCreateMode) {
    updateCreateModeButtons();
    return;
  }
  const template = getTemplate(selectedLang, mode);
  if (createEditor) {
    const current = createEditor.getValue();
    if (current && current.trim() && !confirm("Switching mode will replace the editor content. Continue?")) {
      updateCreateModeButtons();
      return;
    }
    createEditor.setValue(template || "", -1);
  }
  selectedCreateMode = mode;
  updateCreateModeButtons();
}

function setEditMode(mode) {
  if (!mode || mode === selectedEditMode) {
    updateEditModeButtons();
    return;
  }
  const lang = window.__editFnLang || "python";
  const template = getTemplate(lang, mode);
  if (editEditor) {
    const current = editEditor.getValue();
    if (current && current.trim() && !confirm("Switching mode will replace the editor content. Continue?")) {
      updateEditModeButtons();
      return;
    }
    editEditor.setValue(template || "", -1);
  }
  selectedEditMode = mode;
  updateEditModeButtons();
}

function updateCreateModeButtons() {
  const syncBtn = document.getElementById("create-mode-sync");
  const asyncBtn = document.getElementById("create-mode-async");
  [syncBtn, asyncBtn].forEach(b => b?.classList.remove("selected"));
  if (selectedCreateMode === "async") asyncBtn?.classList.add("selected");
  else syncBtn?.classList.add("selected");
}

function updateEditModeButtons() {
  const syncBtn = document.getElementById("edit-mode-sync");
  const asyncBtn = document.getElementById("edit-mode-async");
  [syncBtn, asyncBtn].forEach(b => b?.classList.remove("selected"));
  if (selectedEditMode === "async") asyncBtn?.classList.add("selected");
  else syncBtn?.classList.add("selected");
}

function setDynRuntime(mode) {
  document.querySelectorAll("#dyn-runtime-toggle .z-mode-btn").forEach((btn, i) => {
    btn.classList.toggle("selected", mode === "dedicated" ? i === 1 : i === 0);
  });
  toast(mode === "dedicated" ? "Dedicated dynamic runtime selected" : "Shared dynamic runtime selected", "info");
}

const FILE_MANIFESTS = {
  go: [
    { path: "main.go", main: true },
    { path: "types.go" },
    { path: "go.mod" },
    { path: "README.md" }
  ],
  rust: [
    { path: "main.rs", main: true },
    { path: "Cargo.toml" },
    { path: "README.md" }
  ],
  python: [
    { path: "handler.py", main: true },
    { path: "requirements.txt" },
    { path: "README.md" }
  ],
  ts: [
    { path: "index.ts", main: true },
    { path: "package.json" },
    { path: "tsconfig.json" }
  ],
  lua: [
    { path: "main.lua", main: true },
    { path: "README.md" }
  ]
};

let lastVimSpace = 0;
let teleState = { mode: "create", type: "files", results: [], index: -1 };

function activeEditor(mode) {
  return mode === "create" ? createEditor : editEditor;
}

function vimEnabled(mode) {
  return !!document.getElementById(mode + "-vim-toggle")?.checked;
}

function applyEditorVim(mode) {
  const ed = activeEditor(mode);
  if (!ed) return;
  try {
    ed.setKeyboardHandler(vimEnabled(mode) ? "ace/keyboard/vim" : null);
    if (vimEnabled(mode)) defineVimEx();
  } catch (e) { /* ignore */ }
}

function functionDirName(mode) {
  if (mode === "create") {
    const value = document.getElementById("fn-name-input")?.value?.trim();
    return value || "function";
  }
  return window.__editFnName || (window.__editFnID ? window.__editFnID.slice(0, 10) : "function");
}

function stubContent(lang, path, dirName) {
  if (path.endsWith(".md")) {
    return "# " + (dirName || "function") + "\n\nPlaceholder package file. Multi-file editing is tracked in #84.\n";
  }
  if (path.endsWith("go.mod")) return "module example.com/" + (dirName || "function") + "\n\ngo 1.26\n";
  if (path.endsWith("Cargo.toml")) return '[package]\nname = "' + (dirName || "function") + '"\nversion = "0.1.0"\nedition = "2021"\n';
  if (path.endsWith("package.json")) return '{\n  "name": "' + (dirName || "function") + '",\n  "private": true\n}\n';
  if (path.endsWith("tsconfig.json")) return '{\n  "compilerOptions": { "strict": true }\n}\n';
  if (path.endsWith("requirements.txt")) return "# add dependencies here\n";
  return "// Placeholder file. Multi-file editing is tracked in #84.\n";
}

function initEditorFiles(mode, lang, mainContent) {
  const manifest = FILE_MANIFESTS[lang] || FILE_MANIFESTS.python;
  const contents = {};
  const dirName = functionDirName(mode);
  manifest.forEach(file => {
    contents[file.path] = file.main ? (mainContent || "") : stubContent(lang, file.path, dirName);
  });
  window["__" + mode + "Files"] = { lang: lang, manifest: manifest, contents: contents };
  window["__" + mode + "ActiveFile"] = (manifest.find(f => f.main) || manifest[0]).path;
  renderFileTree(mode);
  updateEditorPath(mode);
}

function renderFileTree(mode) {
  const state = window["__" + mode + "Files"];
  const el = document.getElementById(mode + "-file-tree");
  if (!state || !el) return;
  const dirName = functionDirName(mode);
  const active = window["__" + mode + "ActiveFile"];
  const files = state.manifest.map(file => {
    const isActive = file.path === active;
    return '<button class="z-tree-file' + (isActive ? " active" : "") + '" data-path="' + escapeFnHtml(file.path) + '" onclick="selectEditorFile(\'' + mode + '\',\'' + escapeFnHtml(file.path) + '\')" title="' + escapeFnHtml(file.path) + '">' +
      zIcon("file") + '<span class="z-tree-name">' + escapeFnHtml(file.path) + '</span>' +
      (file.main ? "" : '<span class="z-badge z-badge-amber">stub</span>') +
      '</button>';
  }).join("");
  el.innerHTML =
    '<div class="z-tree-root-row">' +
      '<button class="z-tree-root" id="' + mode + '-tree-root" onclick="toggleFileTree(\'' + mode + '\')">' +
        '<span class="z-tree-caret">' + zIcon("chevron-right") + '</span>' +
        '<span class="z-mono">' + escapeFnHtml(dirName) + '/</span>' +
        '<span class="z-badge z-badge-muted">' + state.manifest.length + '</span>' +
      '</button>' +
    '</div>' +
    '<div class="z-tree-children hidden" id="' + mode + '-tree-children">' + files + '</div>' +
    '<div class="z-tree-foot"><span class="z-kbd">space</span><span class="z-kbd">space</span> files · <span class="z-kbd">space</span><span class="z-kbd">/</span> content</div>';
}

function toggleFileTree(mode) {
  const children = document.getElementById(mode + "-tree-children");
  if (!children) return;
  children.classList.toggle("hidden");
  const caret = document.querySelector("#" + mode + "-tree-root .z-tree-caret svg");
  if (caret) caret.style.transform = children.classList.contains("hidden") ? "" : "rotate(90deg)";
}

function updateEditorPath(mode) {
  const state = window["__" + mode + "Files"];
  const el = document.getElementById(mode + "-editor-path");
  if (!state || !el) return;
  const active = window["__" + mode + "ActiveFile"];
  const main = (state.manifest.find(f => f.main) || {}).path;
  el.innerHTML = escapeFnHtml(functionDirName(mode)) + '/ <span style="color:var(--text)">' + escapeFnHtml(active) + '</span>' +
    (active !== main ? ' <span class="z-badge z-badge-amber">stub</span>' : '');
}

function renameFunctionDir(mode) {
  const state = window["__" + mode + "Files"];
  if (!state) return;
  const dirName = functionDirName(mode);
  state.manifest.forEach(file => {
    if (!file.main) state.contents[file.path] = stubContent(state.lang, file.path, dirName);
  });
  renderFileTree(mode);
  updateEditorPath(mode);
}

function syncEditorBuffer(mode) {
  const ed = activeEditor(mode);
  const state = window["__" + mode + "Files"];
  if (!ed || !state) return;
  const active = window["__" + mode + "ActiveFile"];
  if (active) state.contents[active] = ed.getValue();
}

function mainFile(mode) {
  const state = window["__" + mode + "Files"];
  return state ? (state.manifest.find(f => f.main) || state.manifest[0]) : null;
}

function mainFileContent(mode) {
  syncEditorBuffer(mode);
  const main = mainFile(mode);
  const state = window["__" + mode + "Files"];
  return main && state ? (state.contents[main.path] || "") : "";
}

function selectEditorFile(mode, path) {
  const state = window["__" + mode + "Files"];
  if (!state || state.contents[path] === undefined) return;
  syncEditorBuffer(mode);
  window["__" + mode + "ActiveFile"] = path;
  const ed = activeEditor(mode);
  if (ed) {
    ed.session.setMode("ace/mode/" + modeMap[state.lang]);
    ed.setValue(state.contents[path] || "", -1);
    ed.focus();
  }
  document.querySelectorAll("#" + mode + "-file-tree .z-tree-file").forEach(btn => {
    btn.classList.toggle("active", btn.getAttribute("data-path") === path);
  });
  document.getElementById(mode + "-tree-children")?.classList.remove("hidden");
  const caret = document.querySelector("#" + mode + "-tree-root .z-tree-caret svg");
  if (caret) caret.style.transform = "rotate(90deg)";
  updateEditorPath(mode);
}

function openCreate(){
  window.__isCreateEditor = true;
  window.__isEditEditor = false;
  zOpenModal("create-modal");

  if (!createEditor && window.ace) {
    createEditor = ace.edit("create-ace");
    createEditor.setTheme("ace/theme/dracula");
    applyEditorVim("create");
  }

  const mainContent = getTemplate(selectedLang, selectedCreateMode) || "";
  initEditorFiles("create", selectedLang, mainContent);
  if (createEditor) {
    createEditor.session.setMode("ace/mode/" + modeMap[selectedLang]);
    createEditor.setValue(mainContent, -1);
    setTimeout(() => createEditor.focus(), 120);
  }
  updateCreateModeButtons();
}

function selectLang(lang){
  selectedLang = lang;
  document.querySelectorAll('.z-lang-tile').forEach(b=>b.classList.remove('selected'));
  const el = document.getElementById('lang-' + lang);
  if(el) el.classList.add('selected');
  if(createEditor){
    const mainContent = getTemplate(lang, selectedCreateMode) || "";
    initEditorFiles("create", lang, mainContent);
    createEditor.session.setMode('ace/mode/' + modeMap[lang]);
    createEditor.setValue(mainContent, -1);
    setTimeout(()=>createEditor.focus(),120);
  }
}

function closeCreate(){
  window.__isCreateEditor = false;
  closeTelescope();
  zCloseModal('create-modal');
}

function saveCreate(exit){
  const name = document.getElementById('fn-name-input')?.value?.trim();
  if(!name){
    const el = document.getElementById('fn-name-input');
    el.classList.add('shake');
    setTimeout(()=>el.classList.remove('shake'),400);
    el.focus();
    return;
  }
  const main = mainFile("create");
  if (window.__createActiveFile && main && window.__createActiveFile !== main.path) {
    toast("Stub files are read-only in this preview; saving the main file only", "info");
  }
  const description = document.getElementById('fn-desc-input')?.value?.trim();
  const payload = {
    name: name,
    language: selectedLang,
    description: description,
    code: mainFileContent("create"),
    is_async: selectedCreateMode === "async"
  };
  fetch(`/api/functions/`,{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(payload)
  }).then(()=>{
    if(exit) closeCreate();
    refreshList()
  });
}

function openEdit(id, lang){
  window.__isCreateEditor = false;
  window.__isEditEditor = true;
  window.__editFnID = id;
  window.__editFnLang = lang;
  window.__editFnName = "";
  zOpenModal('edit-modal');
  if(!editEditor && window.ace){
    editEditor = ace.edit('edit-ace');
    editEditor.setTheme('ace/theme/dracula');
    applyEditorVim("edit");
  }

  if(editEditor){
    editEditor.session.setMode('ace/mode/' + modeMap[lang]);
    editEditor.setValue('Loading...', -1);
    fetch(`/api/functions/${id}/`).then(r=>r.json()).then(data=>{
      selectedEditMode = data?.is_async ? "async" : "sync";
      updateEditModeButtons();
      window.__editFnName = data?.name || data?.Name || id.slice(0, 10);
      const mainContent = data.content || getTemplate(lang, selectedEditMode) || '';
      initEditorFiles("edit", lang, mainContent);
      editEditor.setValue(mainContent, -1);
      applyEditorVim("edit");
      editEditor.focus();
      setTimeout(() => editEditor.focus(), 50);
    }).catch(()=>{
      window.__editFnName = id.slice(0, 10);
      const mainContent = getTemplate(lang, selectedEditMode) || '';
      initEditorFiles("edit", lang, mainContent);
      editEditor.setValue(mainContent, -1);
      editEditor.focus();
    });
    editEditor.focus();
  }
  updateEditModeButtons();
}

function closeEdit(){
  window.__isEditEditor = false;
  closeTelescope();
  zCloseModal('edit-modal');
}

function saveEdit(exit){
  if(!window.__editFnID) return;
  const main = mainFile("edit");
  if (window.__editActiveFile && main && window.__editActiveFile !== main.path) {
    toast("Stub files are read-only in this preview; saving the main file only", "info");
  }
  const body = mainFileContent("edit");
  fetch(`/api/functions/${window.__editFnID}/`,{
    method:'PUT',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      code: body,
      is_async: selectedEditMode === "async"
    })
  }).then(()=>{
    if(exit) closeEdit();
    refreshList()
  });
}

/* --- telescope-like file/content search --- */
function openTelescope(mode, type) {
  syncEditorBuffer(mode);
  teleState = { mode: mode, type: type, results: [], index: -1 };
  const modal = document.getElementById("z-telescope");
  const input = document.getElementById("z-telescope-input");
  const kind = document.getElementById("z-telescope-kind");
  if (!modal || !input) return;
  input.value = "";
  input.placeholder = type === "files" ? "Search files…" : "Search current file…";
  if (kind) kind.textContent = type === "files" ? "files" : "content";
  modal.classList.add("open");
  updateTelescope();
  setTimeout(() => input.focus(), 30);
}

function closeTelescope() {
  document.getElementById("z-telescope")?.classList.remove("open");
}

function telescopeItems() {
  const state = window["__" + teleState.mode + "Files"];
  const query = (document.getElementById("z-telescope-input")?.value || "").trim().toLowerCase();
  if (!state) return [];
  if (teleState.type === "files") {
    return state.manifest
      .filter(file => !query || file.path.toLowerCase().includes(query))
      .map(file => ({ label: file.path, path: file.path, main: file.main }));
  }
  const active = window["__" + teleState.mode + "ActiveFile"];
  const content = state.contents[active] || "";
  return content.split("\n").map((line, i) => ({
    label: line.trim() || "(blank line)",
    line: i + 1
  })).filter(item => !query || item.label.toLowerCase().includes(query));
}

function updateTelescope() {
  teleState.results = telescopeItems();
  teleState.index = teleState.results.length ? 0 : -1;
  renderTelescopeResults();
}

function renderTelescopeResults() {
  const container = document.getElementById("z-telescope-results");
  if (!container) return;
  if (!teleState.results.length) {
    container.innerHTML = '<div class="z-empty" style="padding:22px"><div class="z-empty-title">No matches</div><div class="z-empty-sub">Try a different query.</div></div>';
    return;
  }
  container.innerHTML = teleState.results.map((item, i) => {
    const active = i === teleState.index ? " active" : "";
    const right = teleState.type === "files"
      ? (item.main ? '<span class="z-badge z-badge-green">main</span>' : '<span class="z-badge z-badge-amber">stub</span>')
      : '<span class="z-mono" style="font-size:9px;color:var(--text-4)">L' + item.line + '</span>';
    return '<button class="z-telescope-result' + active + '" onclick="chooseTelescope(' + i + ')">' +
      zIcon(teleState.type === "files" ? "file" : "search") +
      '<span class="z-telescope-label">' + escapeFnHtml(item.label) + '</span>' + right + '</button>';
  }).join("");
  container.querySelectorAll(".z-telescope-result")[teleState.index]?.scrollIntoView({ block: "nearest" });
}

function chooseTelescope(index) {
  const item = teleState.results[index];
  if (!item) return;
  if (teleState.type === "files") {
    selectEditorFile(teleState.mode, item.path);
  } else {
    const ed = activeEditor(teleState.mode);
    if (ed) {
      ed.gotoLine(item.line, 0, true);
      ed.focus();
    }
  }
  closeTelescope();
}

document.addEventListener("keydown", function (e) {
  const tele = document.getElementById("z-telescope");
  if (tele?.classList.contains("open")) {
    if (e.key === "Escape") { e.preventDefault(); closeTelescope(); return; }
    if (e.key === "ArrowDown") { e.preventDefault(); teleState.index = Math.min(teleState.index + 1, teleState.results.length - 1); renderTelescopeResults(); return; }
    if (e.key === "ArrowUp") { e.preventDefault(); teleState.index = Math.max(teleState.index - 1, 0); renderTelescopeResults(); return; }
    if (e.key === "Enter") { e.preventDefault(); chooseTelescope(teleState.index); return; }
    return;
  }

  const editOpen = document.getElementById("edit-modal")?.classList.contains("open");
  const createOpen = document.getElementById("create-modal")?.classList.contains("open");
  const mode = editOpen ? "edit" : (createOpen ? "create" : null);
  if (!mode || !vimEnabled(mode)) return;
  const ed = activeEditor(mode);
  if (!ed || !ed.container || !ed.container.contains(e.target)) return;

  // Best-effort guard so insert-mode spaces still type normally.
  const vimState = ed.state && ed.state.cm && ed.state.cm.state && ed.state.cm.state.vim;
  if (vimState && vimState.insertMode) return;

  const now = Date.now();
  if (e.code === "Space" || e.key === " ") {
    if (now - lastVimSpace < 600) {
      e.preventDefault();
      lastVimSpace = 0;
      openTelescope(mode, "files");
    } else {
      lastVimSpace = now;
    }
    return;
  }
  if (e.key === "/" && now - lastVimSpace < 600) {
    e.preventDefault();
    lastVimSpace = 0;
    openTelescope(mode, "content");
    return;
  }
  lastVimSpace = 0;
}, true);

/* --- bind language tiles and other DOM wiring after load --- */
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.z-lang-tile[data-lang]').forEach(btn=>{
    btn.addEventListener('click', ()=> {
      const lang = btn.getAttribute('data-lang');
      selectLang(lang);
    });
  });

  window.__activeProjectID = getActiveProjectID();
  selectLang(selectedLang);
  updateCreateModeButtons();
  updateEditModeButtons();

  ["create", "edit"].forEach(mode => {
    document.getElementById(mode + "-vim-toggle")?.addEventListener("change", () => applyEditorVim(mode));
  });

  const params = new URLSearchParams(window.location.search);
  const editId = params.get("edit");
  if (editId) {
    fetch(`/api/functions/${editId}/`)
      .then(r => r.json())
      .then(f => openEdit(f.id, f.language))
      .catch(err => console.error("Failed to auto-open edit modal", err));
  }
});

window.__deleteFnID = null;

function deleteFn(id) {
    window.__deleteFnID = id;
    zOpenModal("delete-modal");
}

function closeDelete() {
    window.__deleteFnID = null;
    zCloseModal("delete-modal");
}

function confirmDelete() {
    if (!window.__deleteFnID) return;

    fetch(`/api/functions/${window.__deleteFnID}/`, {
        method: "DELETE"
    })
    .then(() => {
        closeDelete();
        refreshList(); // refresh UI
    });
}


function fnIcon(name) {
    const paths = {
        code: '<path d="m8 6-6 6 6 6"/><path d="m16 6 6 6-6 6"/>',
        copy: '<rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
        edit: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
        route: '<circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/>',
        trash: '<path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>'
    };
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' + (paths[name] || "") + '</svg>';
}

function escapeFnHtml(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}

function filterFunctions(q) {
    const needle = String(q || "").trim().toLowerCase();
    document.querySelectorAll("#fn-list-container .z-fn-row").forEach(row => {
        const name = String(row.getAttribute("data-fn-name") || "").toLowerCase();
        row.style.display = (!needle || name.includes(needle)) ? "" : "none";
    });
}

function refreshList() {
    fetch(`/api/functions/`)
        .then(r => r.json())
        .then(obj => {
            const list = Object.values(obj || {});
            const container = document.querySelector("#fn-list-container");
            if (!container) return;

            if (list.length === 0) {
                container.innerHTML = `
                    <div class="z-empty" style="padding:40px 16px">
                        <div class="z-empty-icon">${fnIcon("code")}</div>
                        <div class="z-empty-title">No functions yet</div>
                        <div class="z-empty-sub">Create your first function to start deploying.</div>
                        <button class="z-btn z-btn-primary z-btn-sm" onclick="openCreate()">New function</button>
                    </div>`;
                return;
            }

            container.innerHTML = list.map(fn => {
                const id = escapeFnHtml(fn.id);
                const name = escapeFnHtml(fn.name);
                const lang = escapeFnHtml(fn.language);
                const endpointId = fn.endpoint_id || "";
                const icon = `/static/imgs/${encodeURIComponent(lang)}-svgrepo-com.svg`;
                const endpointBtn = endpointId
                    ? `<a class="z-btn z-btn-sm" href="/traffic/?expand=${encodeURIComponent(endpointId)}" title="Endpoint">${fnIcon("route")} Test</a>`
                    : `<span class="z-btn z-btn-sm" style="opacity:.45" title="No endpoint">${fnIcon("route")} Test</span>`;
                return `
                    <div class="z-fn-row" data-fn-name="${name.toLowerCase()}">
                        <span class="z-fn-icon"><img src="${icon}" alt=""/></span>
                        <div class="z-fn-main">
                            <div class="z-fn-name">${name}</div>
                            <div class="z-fn-meta">
                                <span class="z-badge z-badge-muted">${lang}</span>
                                <span class="z-mono" style="font-size:9px;color:var(--text-4)">${id.slice(0, 10)}</span>
                            </div>
                        </div>
                        <div class="z-fn-actions">
                            <button class="z-icon-btn" title="Copy curl" onclick="copyFn('${id}')">${fnIcon("copy")}</button>
                            <button class="z-btn z-btn-sm" onclick="openEdit('${id}', '${lang}')">${fnIcon("edit")} Edit</button>
                            ${endpointBtn}
                            <button class="z-icon-btn" title="Delete" onclick="deleteFn('${id}')">${fnIcon("trash")}</button>
                        </div>
                    </div>`;
            }).join("");

            filterFunctions(document.getElementById("fn-filter")?.value || "");
        })
        .catch(() => toast("Could not refresh functions", "error"));
}
	</script>

	<style>
	.ace_editor,
	.ace_scroller,
	.ace_content { background: #0b0b0c !important; color: #eee !important; }
	.shake { animation: shake .3s linear; }
	@keyframes shake { 0%{transform:translateX(0)} 25%{transform:translateX(-6px)} 50%{transform:translateX(6px)} 75%{transform:translateX(-6px)} 100%{transform:translateX(0)} }
	</style>

}
