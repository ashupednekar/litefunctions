package templates

import "strings"

script selectFnMethod(id string, method string) {
	const input = document.getElementById("fn-config-methods-" + id);
	const methods = new Set((input?.value || "").split(",").filter(Boolean));
	if (methods.has(method)) methods.delete(method); else methods.add(method);
	const selectedMethods = [...methods];
	["GET", "POST", "PUT", "PATCH", "DELETE"].forEach(m => {
		const btn = document.getElementById("fn-method-" + m + "-" + id);
		if (btn) btn.classList.toggle("selected", methods.has(m));
	});
	if (input) input.value = selectedMethods.join(",");
}

script openCreate() {
}
script closeCreate() {
}
script selectLang(lang string) {
}
script openEdit(id string, lang string) {
}
script toggleFnConfig(id string) {
}
script closeEdit() {
}
script saveCreate(exit bool) {
}
script saveEdit(exit bool) {
}

templ FunctionContent(functions []Function, langs []Lang, activeProjectID string, username string, samples map[string]CodeSample, endpoints []Endpoint, repoURL string) {

@templ.JSONScript("function-samples", samples)
@templ.JSONScript("endpoint-list", endpoints)

@PageHead("Functions", "Write, edit and deploy functions in Go, Rust, Python, TypeScript or Lua.", "Workspace", templ.Raw(`
	<button class="z-btn" onclick="openSpotlight()">`+svgSearch()+` Search</button>
	<button class="z-btn z-btn-primary" onclick="openCreate()">`+svgPlus()+` New function</button>
`))


<div class="z-panel">
	<div class="z-panel-header">
		<span class="z-panel-title">Functions</span>
		<span class="z-badge z-badge-muted">{ itoa(len(functions)) }</span>

		<div class="z-panel-actions">
			<div class="z-search" style="width:180px"><input id="fn-filter" class="z-input" style="height:25px;font-size:10.5px" placeholder="Filter functions…" oninput="filterFunctions(this.value)"/></div>
			<button class="z-btn z-btn-sm" onclick="refreshList()">@Icon("refresh", "")</button>
		</div>
	</div>
	<div id="fn-list-container" class="z-panel-body tight" style="min-height:120px">
		if len(functions) == 0 {
			<div class="z-empty" style="padding:40px 16px">
				<div class="z-empty-icon">@Icon("code", "")</div>
				<div class="z-empty-title">No functions yet</div>
				<div class="z-empty-sub">Create your first function to start deploying.</div>
				<button class="z-btn z-btn-primary z-btn-sm" onclick="openCreate()">New function</button>
			</div>
		}
		for _, fn := range functions {
			<div class="z-fn-row" data-fn-name={ fn.Name } data-fn-id={ fn.ID } data-fn-endpoint-id={ fn.EndpointID } data-fn-language={ fn.Language } data-fn-async={ boolString(fn.IsAsync) }>
				<span class="z-fn-icon"><img src={ fn.Icon } alt=""/></span>
				<div class="z-fn-main">
					<div class="z-fn-name">{ fn.Name }</div>
					<div class="z-fn-meta">
						<span class="z-badge z-badge-muted">{ fn.Language }</span>
						<span class="z-mono" style="font-size:9px;color:var(--text-4)">{ shortID(fn.ID) }</span>
					</div>
				</div>
				<div class="z-fn-actions">
					<a id={ "fn-row-build-" + fn.ID } class="z-badge z-badge-muted hidden" target="_blank" rel="noopener" title="Latest Actions run">No Actions</a>
					<button class="z-icon-btn" id={ "fn-config-btn-" + fn.ID } title="Function config" onclick={ templ.JSFuncCall("toggleFnConfig", fn.ID) }>@Icon("sliders", "")</button>
					<button class="z-icon-btn" title="Edit" onclick={ templ.JSFuncCall("openEdit", fn.ID, fn.Language) }>@Icon("edit", "")</button>
					<button class="z-icon-btn" id={ "fn-test-btn-" + fn.ID } title="Test &amp; logs" onclick={ templ.JSFuncCall("toggleFnTraffic", fn.ID) }>@Icon("play", "")</button>
					<button class="z-icon-btn" id={ "fn-build-btn-" + fn.ID } title="Build logs" onclick={ templ.JSFuncCall("toggleFnBuild", fn.ID) }>@Icon("package", "")</button>
					<button class="z-icon-btn" title="Delete" onclick={ templ.JSFuncCall("deleteFn", fn.ID) }>@Icon("trash", "")</button>
				</div>
			</div>
			@functionConfigPanel(fn, repoURL)
			@FunctionTrafficPanel(fn, endpointForFunction(endpoints, fn.ID))
			@FunctionBuildPanel(fn)
		}
	</div>
</div>

<!-- CREATE -->
<div id="create-modal" class="z-modal-backdrop" onclick="closeCreate()">
	<div class="z-modal" style="width:min(1180px,96vw);height:min(90vh,940px);display:flex;flex-direction:column" onclick="event.stopPropagation()">
		<div class="z-modal-header">
			@Icon("code", "")
			<span class="z-modal-title">New function</span>
			<div class="z-mode-toggle" style="margin-left:auto">
				<button id="create-mode-sync" onclick="setCreateMode('sync')" class="z-mode-btn">Sync</button>
				<button id="create-mode-async" onclick="setCreateMode('async')" class="z-mode-btn">Async</button>
			</div>
			<label class="z-check" style="margin-left:10px"><input id="create-vim-toggle" type="checkbox" checked/> Vim</label>
			<button class="z-icon-btn" style="margin-left:4px" onclick="closeCreate()">@Icon("close", "")</button>
		</div>
		<div class="z-modal-body" style="display:flex;flex-direction:column;gap:12px;flex:1;min-height:0;overflow:auto">
			<div class="z-grid z-grid-2" style="gap:12px">
				<div class="z-field">
					<span class="z-label">Language</span>
					<div class="z-lang-grid">
						for _, lang := range langs {
							<button data-lang={ lang.ID } class="z-lang-tile" id={ "lang-" + lang.ID }>
								<img src={ lang.Icon } alt=""/>
								<span>{ lang.Label }</span>
							</button>
						}
					</div>
				</div>
				<div class="z-field">
					<label class="z-label" for="fn-name-input">Function name</label>
					<input id="fn-name-input" class="z-input" placeholder="e.g. create-order" oninput="renameFunctionDir('create')"/>
					<span class="z-help">Each function is a directory in the repo. Lowercase letters, digits and dashes.</span>
				</div>
			</div>
			<div class="z-editor-layout">
				<aside class="z-file-tree" id="create-file-tree"></aside>
				<section class="z-editor-pane">
					<div class="z-editor-breadcrumb">
						<span id="create-editor-path" class="z-mono">function/</span>
						<span style="margin-left:auto;display:flex;gap:2px">
							<button class="z-icon-btn" style="width:22px;height:22px" title="Search files (space space in vim)" onclick="openTelescope('create','files')">@Icon("search", "")</button>
							<button class="z-icon-btn" style="width:22px;height:22px" title="Search content (space / in vim)" onclick="openTelescope('create','content')">@Icon("file", "")</button>
						</span>
					</div>
					<div class="z-editor-shell" style="display:flex;flex-direction:column">
						<div id="create-ace" style="flex:1"></div>
					</div>
					<div class="z-editor-hint">Vim: <span class="z-kbd">space</span><span class="z-kbd">space</span> files · <span class="z-kbd">space</span><span class="z-kbd">/</span> content · only the main file is persisted in this preview.</div>
				</section>
			</div>
		</div>
		<div class="z-modal-foot">
			<button class="z-btn" onclick="closeCreate()">Cancel</button>
			<button class="z-btn z-btn-primary" onclick="saveCreate(true)">@Icon("check", "") Create &amp; deploy</button>
		</div>
	</div>
</div>

<!-- EDIT -->
<div id="edit-modal" class="z-modal-backdrop" onclick="closeEdit()">
	<div class="z-modal" style="width:min(1180px,96vw);height:min(90vh,940px);display:flex;flex-direction:column" onclick="event.stopPropagation()">
		<div class="z-modal-header">
			@Icon("edit", "")
			<span class="z-modal-title">Edit function</span>
			<div class="z-mode-toggle" style="margin-left:auto">
				<button id="edit-mode-sync" onclick="setEditMode('sync')" class="z-mode-btn">Sync</button>
				<button id="edit-mode-async" onclick="setEditMode('async')" class="z-mode-btn">Async</button>
			</div>
			<label class="z-check" style="margin-left:10px"><input id="edit-vim-toggle" type="checkbox" checked/> Vim</label>
			<button class="z-icon-btn" style="margin-left:4px" onclick="closeEdit()">@Icon("close", "")</button>
		</div>
		<div class="z-modal-body" style="display:flex;flex-direction:column;gap:12px;flex:1;min-height:0;overflow:auto">
			<div class="z-editor-layout">
				<aside class="z-file-tree" id="edit-file-tree"></aside>
				<section class="z-editor-pane">
					<div class="z-editor-breadcrumb">
						<span id="edit-editor-path" class="z-mono">function/</span>
						<span style="margin-left:auto;display:flex;gap:2px">
							<button class="z-icon-btn" style="width:22px;height:22px" title="Search files (space space in vim)" onclick="openTelescope('edit','files')">@Icon("search", "")</button>
							<button class="z-icon-btn" style="width:22px;height:22px" title="Search content (space / in vim)" onclick="openTelescope('edit','content')">@Icon("file", "")</button>
						</span>
					</div>
					<div class="z-editor-shell" style="display:flex;flex-direction:column">
						<div id="edit-ace" style="flex:1"></div>
					</div>
					<div class="z-editor-hint">Vim: <span class="z-kbd">space</span><span class="z-kbd">space</span> files · <span class="z-kbd">space</span><span class="z-kbd">/</span> content · only the main file is persisted in this preview.</div>
				</section>
			</div>
		</div>
		<div class="z-modal-foot">
			<span class="z-help" style="margin-right:auto">The file tree is a UI preview; multi-file persistence is tracked in #84.</span>
			<button class="z-btn" onclick="closeEdit()">Cancel</button>
			<button class="z-btn z-btn-primary" onclick="saveEdit(true)">@Icon("check", "") Save changes</button>
		</div>
	</div>
</div>

<!-- DELETE CONFIRM MODAL -->
<div id="delete-modal" class="z-modal-backdrop" onclick="closeDelete()">
	<div class="z-modal" onclick="event.stopPropagation()">
		<div class="z-modal-header">
			@Icon("trash", "")
			<span class="z-modal-title">Delete function?</span>
			<button class="z-icon-btn" style="margin-left:auto" onclick="closeDelete()">@Icon("close", "")</button>
		</div>
		<div class="z-modal-body">
			<p class="z-help" style="margin:0">This removes the function from the repository and deletes its generated endpoint. This action cannot be undone.</p>
		</div>
		<div class="z-modal-foot">
			<button class="z-btn" onclick="closeDelete()">Cancel</button>
			<button class="z-btn z-btn-danger" onclick="confirmDelete()">Delete function</button>
		</div>
	</div>
</div>

<!-- ENDPOINT TEST UI (from endpoints screen, mounted inline) -->
@EndpointTestModals()

<!-- LOG FULLSCREEN -->
<div id="log-fullscreen-modal" class="z-modal-backdrop z-log-fullscreen" onclick="closeLogFullscreen()">
	<div class="z-log-fullscreen-panel" onclick="event.stopPropagation()">
		<div class="z-modal-header">
			@Icon("terminal", "")
			<span class="z-modal-title">Live logs <span id="log-fullscreen-name" class="z-badge z-badge-muted"></span></span>
			<span id="log-fullscreen-status" class="z-badge z-badge-muted">idle</span>
			<button class="z-icon-btn" style="margin-left:auto" onclick="closeLogFullscreen()">@Icon("close", "")</button>
		</div>
		<div id="log-fullscreen-stream" class="z-log"></div>
		<div class="z-modal-foot">
			<span id="log-fullscreen-hint" class="z-help">Runtime + ingestor output streamed from Loki.</span>
			<button class="z-btn z-btn-sm" onclick="clearActiveFnLogs()">Clear</button>
			<button id="log-fullscreen-toggle" class="z-btn z-btn-sm" onclick="toggleActiveFnLog()">Pause</button>
			<button class="z-btn z-btn-sm z-btn-primary" onclick="closeLogFullscreen()">Close</button>
		</div>
	</div>
</div>

<!-- TELESCOPE -->
<div id="z-telescope" class="z-telescope" onclick="closeTelescope()">
	<div class="z-telescope-box" onclick="event.stopPropagation()">
		<div class="z-telescope-input-row">
			@Icon("search", "")
			<input id="z-telescope-input" class="z-telescope-input" placeholder="Search files…" oninput="updateTelescope()"/>
			<span id="z-telescope-kind" class="z-badge z-badge-muted">files</span>
		</div>
		<div id="z-telescope-results" class="z-telescope-results"></div>
		<div class="z-telescope-foot">
			<span><span class="z-kbd">↑</span><span class="z-kbd">↓</span> navigate</span>
			<span><span class="z-kbd">↵</span> open</span>
			<span><span class="z-kbd">esc</span> close</span>
		</div>
	</div>
</div>

	<!-- ACE from CDN (fallback to local if needed) -->
	<script>
	(function(){
		const cdn = "https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.3/";
		const s1 = document.createElement('script');
		s1.src = cdn + 'ace.js';
		s1.onload = () => {
            ace.config.set('basePath', cdn);
            ace.config.set('modePath', cdn);
            ace.config.set('themePath', cdn);
			// load optional ext and keybinding after ace
			const s2 = document.createElement('script');
			s2.src = cdn + 'ext-language_tools.js';
			document.head.appendChild(s2);
			const s3 = document.createElement('script');
			s3.src = cdn + 'keybinding-vim.js';
            s3.onload = () => {
                // Periodically check for Vim global to ensure it's ready
                const check = () => {
                    if (ace.require && ace.require("ace/keyboard/vim")) {
                        defineVimEx();
                    } else {
                        setTimeout(check, 100);
                    }
                };
                check();
            };
			document.head.appendChild(s3);
		};
		document.head.appendChild(s1);
	})();
	</script>

	<script>
window.ACE_MODES = {
    python: "python",
    ts: "typescript",
    go: "golang",
    rust: "rust",
    lua: "lua"
};

window.__activeProjectID = "{ activeProjectID }";

let createEditor = null;
let editEditor = null;
let selectedLang = "python";
let selectedCreateMode = "sync";
let selectedEditMode = "sync";



const modeMap = window.ACE_MODES;

/* --- Helpers for project id resolution (use cookie fallback) --- */
function getCookie(name) {
  const v = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
  return v ? decodeURIComponent(v.pop()) : '';
}

function getActiveProjectID() {
  const raw = (window.__activeProjectID || '').trim();
  // treat templ placeholder or empty as "not provided"
  if (raw && raw !== '{ activeProjectID }' && raw !== '') return raw;
  // fallback to cookie
  return getCookie('lws_project') || '';
}

function projectUrl(pathSuffix) {
  const pid = getActiveProjectID();
  if (!pid) {
    console.warn('no active project id set (lws_project cookie missing and server didn\'t provide one)');
    return pathSuffix || '';
  }
  if (pathSuffix && pathSuffix[0] !== '/') pathSuffix = '/' + pathSuffix;
  // NOTE: prepend /api here so we call server routes under /api
  return `/api/projects/${encodeURIComponent(pid)}${pathSuffix || ''}`;
}

/* --- Ace + Vim ex helpers --- */
window.__isCreateEditor = false;
window.__isEditEditor = false;

function defineVimEx(){
  try {
    const vimMod = ace.require("ace/keyboard/vim") || window.Vim;
    if (!vimMod) return;
    const Vim = vimMod.CodeMirror ? vimMod.CodeMirror.Vim : (vimMod.Vim || vimMod);
    if (!Vim || !Vim.defineEx) return;
    
    const writeHandler = function() {
        if (window.__isCreateEditor) saveCreate(false);
        else if (window.__isEditEditor) saveEdit(false);
    };
    const saveAndQuitHandler = function() {
        if (window.__isCreateEditor) saveCreate(true);
        else if (window.__isEditEditor) saveEdit(true);
    };
    const quitHandler = function() {
        if (window.__isCreateEditor) closeCreate();
        else if (window.__isEditEditor) closeEdit();
    };

    Vim.defineEx("w", "", writeHandler);
    Vim.defineEx("write", "", writeHandler);
    Vim.defineEx("wq", "", saveAndQuitHandler);
    Vim.defineEx("x", "", saveAndQuitHandler);
    Vim.defineEx("q", "", quitHandler);
    Vim.defineEx("quit", "", quitHandler);
    Vim.defineEx("q!", "", quitHandler);
    Vim.defineEx("quit!", "", quitHandler);
    
    console.log("LWS: Vim Ex commands registered");
    Vim.__lws_ex_defined = true;
  } catch (e) {
    console.error("LWS: Error in defineVimEx", e);
  }
}

/* --- live function logs --- */
const fnLogStreams = new Map();
let activeLogFnID = "";
let activeLogKind = "runtime";

function fnLogState(id) {
  if (!fnLogStreams.has(id)) fnLogStreams.set(id, { id: id, source: null, paused: false, lines: [] });
  return fnLogStreams.get(id);
}

function setFnLogStatus(id, text, tone) {
  const toneClass = "z-badge z-badge-" + (tone || "muted");
  const inline = document.getElementById("fn-logs-status-" + id);
  if (inline) { inline.textContent = text; inline.className = toneClass; }
  if (activeLogKind === "runtime" && activeLogFnID === id) {
    const full = document.getElementById("log-fullscreen-status");
    if (full) { full.textContent = text; full.className = toneClass; }
  }
}

function closeFnLog(id) {
  const st = fnLogStreams.get(id);
  if (st && st.source) { st.source.close(); st.source = null; }
}

function startFnLog(id) {
  if (!id) return;
  const st = fnLogState(id);
  if (st.source) return;
  setFnLogStatus(id, "connecting", "amber");
  try {
    const es = new EventSource(`/api/functions/${encodeURIComponent(id)}/logs/`);
    es.addEventListener("logs", (event) => {
      let payload;
      try { payload = JSON.parse(event.data || "{}"); } catch (e) { return; }
      ingestFnLog(st, payload);
      setFnLogStatus(id, "live", "green");
    });
    es.onerror = () => setFnLogStatus(id, "reconnecting", "amber");
    st.source = es;
  } catch (e) {
    setFnLogStatus(id, "error", "red");
  }
}

function ingestFnLog(st, payload) {
  const streams = payload.streams || payload.result || (payload.data && payload.data.result) || [];
  if (!Array.isArray(streams)) return;
  streams.forEach(stream => {
    const labels = stream.stream || {};
    (stream.values || []).forEach(value => {
      if (!Array.isArray(value) || value.length < 2) return;
      const ms = Number(value[0]) / 1e6;
      appendFnLogLine(st, {
        time: (isNaN(ms) ? new Date() : new Date(ms)).toLocaleTimeString(),
        app: labels.app || "",
        fn: labels.function || "",
        line: String(value[1])
      });
    });
  });
}

const ANSI_COLORS = {
  30: "#6b7280", 31: "#f87171", 32: "#4ade80", 33: "#fbbf24", 34: "#60a5fa",
  35: "#e879f9", 36: "#22d3ee", 37: "#e5e7eb",
  90: "#9ca3af", 91: "#fca5a5", 92: "#86efac", 93: "#fde68a", 94: "#93c5fd",
  95: "#f0abfc", 96: "#67e8f9", 97: "#ffffff"
};

function ansiFragment(text) {
  const frag = document.createDocumentFragment();
  let color = "", bold = false, dim = false;
  const re = /\x1b\[([0-9;]*)m/g;
  const emit = (chunk) => {
    if (!chunk) return;
    const span = document.createElement("span");
    span.textContent = chunk;
    if (color) span.style.color = color;
    if (bold) span.style.fontWeight = "600";
    if (dim) span.style.opacity = "0.7";
    frag.appendChild(span);
  };
  let last = 0, m;
  while ((m = re.exec(text)) !== null) {
    emit(text.slice(last, m.index));
    const codes = (m[1] || "0").split(";").filter(c => c !== "").map(Number);
    if (!codes.length) codes.push(0);
    codes.forEach(code => {
      if (code === 0) { color = ""; bold = false; dim = false; }
      else if (code === 1) bold = true;
      else if (code === 2) dim = true;
      else if (code === 22) { bold = false; dim = false; }
      else if (code === 39) color = "";
      else if (ANSI_COLORS[code]) color = ANSI_COLORS[code];
    });
    last = re.lastIndex;
  }
  emit(text.slice(last));
  return frag;
}

function fnLogLineNode(entry) {
  const row = document.createElement("div");
  row.className = "z-log-line";
  const time = document.createElement("span");
  time.className = "z-log-time";
  time.textContent = entry.time;
  row.appendChild(time);
  if (entry.app) {
    const app = document.createElement("span");
    app.className = "z-badge z-badge-muted";
    app.textContent = entry.app;
    row.appendChild(app);
  }
  if (entry.fn) {
    const fn = document.createElement("span");
    fn.className = "z-badge z-badge-blue";
    fn.textContent = entry.fn;
    row.appendChild(fn);
  }
  const text = document.createElement("span");
  text.className = "z-log-text";
  text.appendChild(ansiFragment(String(entry.line || "")));
  row.appendChild(text);
  return row;
}

function appendFnLogLine(st, entry) {
  st.lines.push(entry);
  if (st.lines.length > 1000) st.lines.shift();
  const inline = document.getElementById("fn-logs-" + st.id);
  if (inline) {
    inline.appendChild(fnLogLineNode(entry));
    while (inline.childElementCount > 1000) inline.removeChild(inline.firstChild);
    if (inline.offsetParent !== null) inline.scrollTop = inline.scrollHeight;
  }
  if (activeLogFnID === st.id) {
    const full = document.getElementById("log-fullscreen-stream");
    if (full) {
      full.appendChild(fnLogLineNode(entry));
      while (full.childElementCount > 1000) full.removeChild(full.firstChild);
      full.scrollTop = full.scrollHeight;
    }
  }
}

function clearFnLogs(id) {
  const st = fnLogState(id);
  st.lines = [];
  const inline = document.getElementById("fn-logs-" + id);
  if (inline) inline.innerHTML = "";
  if (activeLogFnID === id) {
    const full = document.getElementById("log-fullscreen-stream");
    if (full) full.innerHTML = "";
  }
}

function toggleFnLogStream(id) {
  const st = fnLogState(id);
  st.paused = !st.paused;
  const label = st.paused ? "Resume" : "Pause";
  const inlineBtn = document.getElementById("fn-logs-toggle-" + id);
  if (inlineBtn) inlineBtn.textContent = label;
  if (activeLogFnID === id) {
    const fullBtn = document.getElementById("log-fullscreen-toggle");
    if (fullBtn) fullBtn.textContent = label;
  }
  if (st.paused) closeFnLog(id);
  else startFnLog(id);
  setFnLogStatus(id, st.paused ? "paused" : "live", st.paused ? "amber" : "green");
}

function openFnLogFullscreen(id) {
  activeLogKind = "runtime";
  activeLogFnID = id;
  setLogFullscreenHint("Runtime + ingestor output streamed from Loki.");
  const st = fnLogState(id);
  const row = document.querySelector('[data-fn-id="' + CSS.escape(id) + '"]');
  const name = row?.querySelector(".z-fn-name")?.textContent || id;
  const nameEl = document.getElementById("log-fullscreen-name");
  if (nameEl) nameEl.textContent = name;
  const full = document.getElementById("log-fullscreen-stream");
  if (full) {
    full.innerHTML = "";
    st.lines.forEach(entry => full.appendChild(fnLogLineNode(entry)));
    full.scrollTop = full.scrollHeight;
  }
  const fullBtn = document.getElementById("log-fullscreen-toggle");
  if (fullBtn) fullBtn.textContent = st.paused ? "Resume" : "Pause";
  setFnLogStatus(id, st.paused ? "paused" : "live", st.paused ? "amber" : "green");
  if (window.zOpenModal) window.zOpenModal("log-fullscreen-modal");
  else document.getElementById("log-fullscreen-modal")?.classList.add("open");
  startFnLog(id);
}

function setLogFullscreenHint(text) {
  const hint = document.getElementById("log-fullscreen-hint");
  if (hint) hint.textContent = text;
}

function closeLogFullscreen() {
  if (window.zCloseModal) window.zCloseModal("log-fullscreen-modal");
  else document.getElementById("log-fullscreen-modal")?.classList.remove("open");
  activeLogFnID = "";
  activeLogKind = "runtime";
}

function clearActiveFnLogs() {
  if (!activeLogFnID) return;
  if (activeLogKind === "build") clearFnBuildLogs(activeLogFnID);
  else clearFnLogs(activeLogFnID);
}

function toggleActiveFnLog() {
  if (!activeLogFnID) return;
  if (activeLogKind === "build") toggleFnBuildStream(activeLogFnID);
  else toggleFnLogStream(activeLogFnID);
}

/* --- live build logs --- */
const fnBuildStreams = new Map();

function fnBuildState(id) {
  if (!fnBuildStreams.has(id)) fnBuildStreams.set(id, { id: id, source: null, paused: false, lines: [] });
  return fnBuildStreams.get(id);
}

function setFnBuildStatus(id, text, tone) {
  const toneClass = "z-badge z-badge-" + (tone || "muted");
  const el = document.getElementById("fn-build-status-" + id);
  if (el) { el.textContent = text; el.className = toneClass; }
  if (activeLogKind === "build" && activeLogFnID === id) {
    const full = document.getElementById("log-fullscreen-status");
    if (full) { full.textContent = text; full.className = toneClass; }
  }
}

function closeFnBuild(id) {
  const st = fnBuildStreams.get(id);
  if (st && st.source) { st.source.close(); st.source = null; }
}

function startFnBuild(id) {
  if (!id) return;
  const st = fnBuildState(id);
  if (st.source) return;
  setFnBuildStatus(id, "connecting", "amber");
  try {
    const es = new EventSource(`/api/functions/${encodeURIComponent(id)}/logs/?source=build`);
    es.addEventListener("logs", (event) => {
      let payload;
      try { payload = JSON.parse(event.data || "{}"); } catch (e) { return; }
      ingestFnBuildLog(st, payload);
      setFnBuildStatus(id, "live", "green");
    });
    es.onerror = () => setFnBuildStatus(id, "reconnecting", "amber");
    st.source = es;
  } catch (e) {
    setFnBuildStatus(id, "error", "red");
  }
}

function ingestFnBuildLog(st, payload) {
  const streams = payload.streams || payload.result || (payload.data && payload.data.result) || [];
  if (!Array.isArray(streams)) return;
  streams.forEach(stream => {
    const labels = stream.stream || {};
    (stream.values || []).forEach(value => {
      if (!Array.isArray(value) || value.length < 2) return;
      const ms = Number(value[0]) / 1e6;
      appendFnBuildLine(st, {
        time: (isNaN(ms) ? new Date() : new Date(ms)).toLocaleTimeString(),
        app: labels.app || "",
        fn: labels.function || "",
        line: String(value[1])
      });
    });
  });
}

function appendFnBuildLine(st, entry) {
  st.lines.push(entry);
  if (st.lines.length > 1000) st.lines.shift();
  const inline = document.getElementById("fn-build-logs-" + st.id);
  if (inline) {
    inline.appendChild(fnLogLineNode(entry));
    while (inline.childElementCount > 1000) inline.removeChild(inline.firstChild);
    if (inline.offsetParent !== null) inline.scrollTop = inline.scrollHeight;
  }
  if (activeLogKind === "build" && activeLogFnID === st.id) {
    const full = document.getElementById("log-fullscreen-stream");
    if (full) {
      full.appendChild(fnLogLineNode(entry));
      while (full.childElementCount > 1000) full.removeChild(full.firstChild);
      full.scrollTop = full.scrollHeight;
    }
  }
}

function clearFnBuildLogs(id) {
  const st = fnBuildState(id);
  st.lines = [];
  const inline = document.getElementById("fn-build-logs-" + id);
  if (inline) inline.innerHTML = "";
  if (activeLogKind === "build" && activeLogFnID === id) {
    const full = document.getElementById("log-fullscreen-stream");
    if (full) full.innerHTML = "";
  }
}

function toggleFnBuildStream(id) {
  const st = fnBuildState(id);
  st.paused = !st.paused;
  const label = st.paused ? "Resume" : "Pause";
  const btn = document.getElementById("fn-build-toggle-" + id);
  if (btn) btn.textContent = label;
  if (activeLogKind === "build" && activeLogFnID === id) {
    const fullBtn = document.getElementById("log-fullscreen-toggle");
    if (fullBtn) fullBtn.textContent = label;
  }
  if (st.paused) closeFnBuild(id);
  else startFnBuild(id);
  setFnBuildStatus(id, st.paused ? "paused" : "live", st.paused ? "amber" : "green");
}

function openFnBuildFullscreen(id) {
  activeLogKind = "build";
  activeLogFnID = id;
  setLogFullscreenHint("Gitea Actions runner output streamed from Loki.");
  const st = fnBuildState(id);
  const row = document.querySelector('[data-fn-id="' + CSS.escape(id) + '"]');
  const name = row?.querySelector(".z-fn-name")?.textContent || id;
  const nameEl = document.getElementById("log-fullscreen-name");
  if (nameEl) nameEl.textContent = name;
  const full = document.getElementById("log-fullscreen-stream");
  if (full) {
    full.innerHTML = "";
    st.lines.forEach(entry => full.appendChild(fnLogLineNode(entry)));
    full.scrollTop = full.scrollHeight;
  }
  const fullBtn = document.getElementById("log-fullscreen-toggle");
  if (fullBtn) fullBtn.textContent = st.paused ? "Resume" : "Pause";
  setFnBuildStatus(id, st.paused ? "paused" : "live", st.paused ? "amber" : "green");
  if (window.zOpenModal) window.zOpenModal("log-fullscreen-modal");
  else document.getElementById("log-fullscreen-modal")?.classList.add("open");
  startFnBuild(id);
}

function toggleFnBuild(id) {
  const panel = document.getElementById("fn-build-" + id);
  if (!panel) return;
  const willOpen = panel.classList.contains("hidden");
  document.querySelectorAll("[data-fn-build]").forEach(p => {
    p.classList.add("hidden");
    closeFnBuild(p.id.replace("fn-build-", ""));
  });
  document.querySelectorAll('[id^="fn-build-btn-"]').forEach(b => b.classList.remove("active"));
  document.querySelectorAll("[data-fn-traffic]").forEach(p => {
    p.classList.add("hidden");
    closeFnLog(p.id.replace("fn-traffic-", ""));
  });
  document.querySelectorAll('[id^="fn-test-btn-"]').forEach(b => b.classList.remove("active"));
  document.querySelectorAll("[data-fn-config]").forEach(p => p.classList.add("hidden"));
  document.querySelectorAll('[id^="fn-config-btn-"]').forEach(b => b.classList.remove("active"));
  if (willOpen) {
    panel.classList.remove("hidden");
    document.getElementById("fn-build-btn-" + id)?.classList.add("active");
    startFnBuild(id);
  }
}

/* --- Actions build status pill --- */
function fnIsInProgress(run) {
  if (!run) return false;
  const raw = run.status || run.Status;
  if (!raw) return false;
  const status = String(raw).toLowerCase();
  return status === "in_progress" || status === "queued" || status === "waiting" || status === "running";
}

function fnGetRuns(progress) {
  if (!progress) return [];
  if (Array.isArray(progress.Runs)) return progress.Runs;
  if (Array.isArray(progress.runs)) return progress.runs;
  return [];
}

function fnNormalizeName(val) {
  return String(val || "").trim().toLowerCase();
}

function fnGetRunName(run) {
  return fnNormalizeName(run?.FunctionName || run?.function_name || run?.WorkflowName || run?.workflow_name || run?.Name || run?.name || "");
}

function fnExtractFunctionName(run) {
  const title = String(run?.DisplayTitle || run?.display_title || "").toLowerCase();
  if (!title) return "";
  const m = title.match(/functions\/(?:go|rs|rust|py|python|ts|typescript|lua)\/([^\/\s]+)/);
  return m ? m[1] : "";
}

function fnNormalizeStatus(run) {
  if (!run) return {status: "", conclusion: ""};
  return {
    status: String(run.status || run.Status || "").toLowerCase(),
    conclusion: String(run.conclusion || run.Conclusion || "").toLowerCase()
  };
}

function fnIsRunSuccess(run) {
  const {status, conclusion} = fnNormalizeStatus(run);
  if (conclusion === "success" || status === "success") return true;
  return status === "completed" && !conclusion;
}

function fnIsFailure(run) {
  const {status, conclusion} = fnNormalizeStatus(run);
  const bad = ["failure", "failed", "cancelled", "canceled", "error", "timed_out"];
  return bad.includes(conclusion) || bad.includes(status);
}

function fnRelevantJobs(language) {
  switch (fnNormalizeName(language)) {
    case "go": return ["build-go"];
    case "rust": case "rs": return ["build-rust"];
    case "python": case "py": return ["hook-python"];
    case "ts": case "typescript": return ["hook-ts"];
    case "lua": return ["hook-lua"];
    default: return [];
  }
}

function fnJobName(run) {
  return fnNormalizeName(run?.CurrentJob || run?.current_job || run?.Name || run?.name || "");
}

function fnIsRelevantRun(run, language) {
  const relevant = fnRelevantJobs(language);
  if (!relevant.length) return true;
  const job = fnJobName(run);
  if (!job) return false;
  return relevant.some(r => job.includes(r));
}

function fnIsRelevantCurrentJob(language, currentJob) {
  const relevant = fnRelevantJobs(language);
  if (!relevant.length) return true;
  const job = fnNormalizeName(currentJob);
  if (!job) return true;
  return relevant.some(r => job.includes(r));
}

function fnPickRun(runs, functionName, language) {
  const target = fnNormalizeName(functionName);
  if (!target) return null;
  const matching = runs.filter(r => fnGetRunName(r) === target || fnExtractFunctionName(r) === target);
  if (!matching.length) return null;
  const activeRelevant = matching.find(r => fnIsInProgress(r) && fnIsRelevantRun(r, language));
  if (activeRelevant) return activeRelevant;
  const successRelevant = matching.find(r => fnIsRunSuccess(r) && fnIsRelevantRun(r, language));
  if (successRelevant) return successRelevant;
  return matching.find(fnIsInProgress) || matching[0];
}

function fnStatusClass(status, conclusion, running) {
  if (running) return "z-badge-amber";
  if (conclusion === "success" || status === "success") return "z-badge-green";
  const bad = ["failure", "failed", "cancelled", "canceled", "error", "timed_out"];
  if (bad.includes(conclusion) || bad.includes(status)) return "z-badge-red";
  return "z-badge-muted";
}

function fnStatusLabel(run, running) {
  const name = run?.Name || run?.name || "Build";
  if (running) return `Running: ${name}`;
  const {status, conclusion} = fnNormalizeStatus(run);
  if (conclusion === "success" || status === "success") return `Success: ${name}`;
  const bad = ["failure", "failed", "cancelled", "canceled", "error", "timed_out"];
  if (bad.includes(conclusion) || bad.includes(status)) return `Failed: ${name}`;
  if (status) return `${status}: ${name}`;
  return name;
}

function fnUpdateRowBuildStatus(progress) {
  const runs = fnGetRuns(progress);
  document.querySelectorAll(".z-fn-row[data-fn-id]").forEach(row => {
    const id = row.getAttribute("data-fn-id");
    const fnName = row.getAttribute("data-fn-name") || "";
    const language = row.getAttribute("data-fn-language") || "";
    const pill = document.getElementById("fn-row-build-" + id);
    if (!pill) return;
    const display = fnPickRun(runs, fnName, language);
    const baseRunning = display ? fnIsInProgress(display) : false;
    const url = (display && (display.HTMLURL || display.htmlurl)) || "";
    const jobName = display?.CurrentJob || display?.current_job || "";
    const relevantRunning = baseRunning && fnIsRelevantCurrentJob(language, jobName);
    const effectiveStatus = (baseRunning && !relevantRunning) ? "success" : (display?.status || display?.Status);
    const effectiveConclusion = (baseRunning && !relevantRunning) ? "success" : (display?.conclusion || display?.Conclusion);
    const cls = fnStatusClass(effectiveStatus, effectiveConclusion, relevantRunning);
    const label = display
      ? (baseRunning && !relevantRunning
        ? `Success: ${jobName || (display?.Name || display?.name || "Build")}`
        : fnStatusLabel(display, relevantRunning))
      : "No Actions";
    if (url) {
      pill.setAttribute("href", url);
      pill.classList.remove("pointer-events-none", "opacity-70");
    } else {
      pill.setAttribute("href", "#");
      pill.classList.add("pointer-events-none", "opacity-70");
    }
    pill.className = `z-badge ${cls}`;
    pill.textContent = label;
    pill.classList.remove("hidden");
  });
}

function fnStartActionsSSE() {
  if (!window.EventSource) return;
  const es = new EventSource("/api/actions/status/");
  es.addEventListener("status", (ev) => {
    try {
      fnUpdateRowBuildStatus(JSON.parse(ev.data || "{}"));
    } catch (e) {}
  });
  es.addEventListener("error", () => fnUpdateRowBuildStatus(null));
}

function openFnFromQuery() {
  const params = new URLSearchParams(window.location.search);
  const fnID = params.get("fn");
  if (fnID) {
    toggleFnTraffic(fnID);
    if (params.get("fullscreen") === "1") openFnLogFullscreen(fnID);
    return;
  }
  const expand = params.get("expand");
  if (expand) {
    const row = document.querySelector('[data-fn-endpoint-id="' + CSS.escape(expand) + '"]');
    const id = row?.getAttribute("data-fn-id");
    if (id) {
      toggleFnTraffic(id);
      setTimeout(() => row.scrollIntoView({ behavior: "smooth", block: "center" }), 100);
    }
  }
}

/* --- endpoint test UI (original endpoints-screen runner) --- */
window.__endpointList = (() => {
  let list = [];
  try { list = JSON.parse(document.getElementById("endpoint-list")?.textContent || "[]"); } catch (e) { /* ignore */ }
  document.querySelectorAll("[data-fn-traffic]").forEach(panel => {
    const id = panel.id.replace("fn-traffic-", "");
    const endpointID = panel.getAttribute("data-endpoint-id") || id;
    const name = panel.getAttribute("data-endpoint-name") || "";
    const method = panel.getAttribute("data-endpoint-method") || "POST";
    if (name && !list.some(ep => ep.id === endpointID)) list.push({ id: endpointID, name: name, method: method });
  });
  return list;
})();

function mountTestUI(nodeID, host) {
  const node = document.getElementById(nodeID);
  if (!node || !host) return;
  node.classList.remove("hidden", "fixed", "inset-0", "bg-black/80", "backdrop-blur-md", "z-50",
    "flex", "items-center", "justify-center", "p-4", "z-modal-backdrop", "open");
  node.classList.add("z-test-inline");
  node.removeAttribute("onclick");
  node.style.display = "";
  host.appendChild(node);
  if (nodeID === "ws-test-modal" && window.__wsMessageEditor) {
    setTimeout(() => window.__wsMessageEditor.resize(true), 60);
  }
}

/* --- UI functions --- */
function copyFn(id){
  const curl = `curl -X POST ${projectUrl(`/api/functions/`)}${id ? id : ''}`;
  navigator.clipboard.writeText(curl);
}

function getTemplate(lang, mode) {
  const el = document.getElementById("function-samples");
  if (!el) return "";
  let samples = {};
  try {
    samples = JSON.parse(el.textContent || "{}");
  } catch (e) {
    console.error("failed to parse function samples", e);
    return "";
  }
  const entry = samples[lang];
  if (!entry) return "";
  if (typeof entry === "string") return entry;
  return entry[mode] || entry.sync || "";
}

function replaceMainBuffer(mode, content) {
  const state = window["__" + mode + "Files"];
  const ed = activeEditor(mode);
  if (!state || !ed) {
    if (ed) ed.setValue(content || "", -1);
    return;
  }
  syncEditorBuffer(mode);
  const main = mainFile(mode);
  if (!main) return;
  state.contents[main.path] = content || "";
  window["__" + mode + "ActiveFile"] = main.path;
  ed.setValue(content || "", -1);
  ed.focus();
  document.querySelectorAll("#" + mode + "-file-tree .z-tree-file").forEach(btn => {
    btn.classList.toggle("active", btn.getAttribute("data-path") === main.path);
  });
  document.getElementById(mode + "-tree-children")?.classList.remove("hidden");
  updateEditorPath(mode);
}

function setCreateMode(mode) {
  if (!mode || mode === selectedCreateMode) {
    updateCreateModeButtons();
    return;
  }
  const template = getTemplate(selectedLang, mode) || "";
  selectedCreateMode = mode;
  replaceMainBuffer("create", template);
  updateCreateModeButtons();
}

function setEditMode(mode) {
  if (!mode || mode === selectedEditMode) {
    updateEditModeButtons();
    return;
  }
  const lang = window.__editFnLang || "python";
  const template = getTemplate(lang, mode) || "";
  selectedEditMode = mode;
  replaceMainBuffer("edit", template);
  updateEditModeButtons();
}

function updateCreateModeButtons() {
  const syncBtn = document.getElementById("create-mode-sync");
  const asyncBtn = document.getElementById("create-mode-async");
  [syncBtn, asyncBtn].forEach(b => b?.classList.remove("selected"));
  if (selectedCreateMode === "async") asyncBtn?.classList.add("selected");
  else syncBtn?.classList.add("selected");
}

function updateEditModeButtons() {
  const syncBtn = document.getElementById("edit-mode-sync");
  const asyncBtn = document.getElementById("edit-mode-async");
  [syncBtn, asyncBtn].forEach(b => b?.classList.remove("selected"));
  if (selectedEditMode === "async") asyncBtn?.classList.add("selected");
  else syncBtn?.classList.add("selected");
}

function setDynRuntime(btn, mode) {
  const group = btn.closest(".z-mode-toggle");
  if (!group) return;
  group.querySelectorAll(".z-mode-btn").forEach((b, i) => {
    b.classList.toggle("selected", mode === "dedicated" ? i === 1 : i === 0);
  });
}

function toggleFnConfig(id) {
  const panel = document.getElementById("fn-config-" + id);
  if (!panel) return;
  const willOpen = panel.classList.contains("hidden");
  document.querySelectorAll("[data-fn-config]").forEach(p => p.classList.add("hidden"));
  document.querySelectorAll('[id^="fn-config-btn-"]').forEach(b => b.classList.remove("active"));
  if (willOpen) {
    document.querySelectorAll("[data-fn-traffic]").forEach(p => {
      p.classList.add("hidden");
      closeFnLog(p.id.replace("fn-traffic-", ""));
    });
    document.querySelectorAll('[id^="fn-test-btn-"]').forEach(b => b.classList.remove("active"));
    document.querySelectorAll("[data-fn-build]").forEach(p => {
      p.classList.add("hidden");
      closeFnBuild(p.id.replace("fn-build-", ""));
    });
    document.querySelectorAll('[id^="fn-build-btn-"]').forEach(b => b.classList.remove("active"));
    panel.classList.remove("hidden");
    document.getElementById("fn-config-btn-" + id)?.classList.add("active");
  }
}

function toggleFnTraffic(id) {
  const panel = document.getElementById("fn-traffic-" + id);
  if (!panel) return;
  const willOpen = panel.classList.contains("hidden");
  document.querySelectorAll("[data-fn-traffic]").forEach(p => {
    p.classList.add("hidden");
    closeFnLog(p.id.replace("fn-traffic-", ""));
  });
  document.querySelectorAll('[id^="fn-test-btn-"]').forEach(b => b.classList.remove("active"));
  document.querySelectorAll("[data-fn-config]").forEach(p => p.classList.add("hidden"));
  document.querySelectorAll('[id^="fn-config-btn-"]').forEach(b => b.classList.remove("active"));
  document.querySelectorAll("[data-fn-build]").forEach(p => {
    p.classList.add("hidden");
    closeFnBuild(p.id.replace("fn-build-", ""));
  });
  document.querySelectorAll('[id^="fn-build-btn-"]').forEach(b => b.classList.remove("active"));
  if (willOpen) {
    panel.classList.remove("hidden");
    document.getElementById("fn-test-btn-" + id)?.classList.add("active");
    const host = document.getElementById("fn-test-host-" + id);
    const endpointID = panel.getAttribute("data-endpoint-id") || id;
    if (panel.getAttribute("data-endpoint-async") === "true") {
      window.openWsTestModalForEndpoint?.(endpointID);
      mountTestUI("ws-test-modal", host);
    } else {
      window.openTestModalForEndpoint?.(endpointID);
      mountTestUI("test-modal", host);
    }
    startFnLog(id);
  }
}

const FILE_MANIFESTS = {
  go: [
    { path: "main.go", main: true },
    { path: "types.go" },
    { path: "go.mod" },
    { path: "README.md" }
  ],
  rust: [
    { path: "main.rs", main: true },
    { path: "Cargo.toml" },
    { path: "README.md" }
  ],
  python: [
    { path: "handler.py", main: true },
    { path: "requirements.txt" },
    { path: "README.md" }
  ],
  ts: [
    { path: "index.ts", main: true },
    { path: "package.json" },
    { path: "tsconfig.json" }
  ],
  lua: [
    { path: "main.lua", main: true },
    { path: "README.md" }
  ]
};

let lastVimSpace = 0;
let teleState = { mode: "create", type: "files", results: [], index: -1 };

function activeEditor(mode) {
  return mode === "create" ? createEditor : editEditor;
}

function vimEnabled(mode) {
  return !!document.getElementById(mode + "-vim-toggle")?.checked;
}

function applyEditorVim(mode) {
  const ed = activeEditor(mode);
  if (!ed) return;
  try {
    ed.setKeyboardHandler(vimEnabled(mode) ? "ace/keyboard/vim" : null);
    if (vimEnabled(mode)) defineVimEx();
  } catch (e) { /* ignore */ }
}

function functionDirName(mode) {
  if (mode === "create") {
    const value = document.getElementById("fn-name-input")?.value?.trim();
    return value || "function";
  }
  return window.__editFnName || (window.__editFnID ? window.__editFnID.slice(0, 10) : "function");
}

function stubContent(lang, path, dirName) {
  if (path.endsWith(".md")) {
    return "# " + (dirName || "function") + "\n\nPlaceholder package file. Multi-file editing is tracked in #84.\n";
  }
  if (path.endsWith("go.mod")) return "module example.com/" + (dirName || "function") + "\n\ngo 1.26\n";
  if (path.endsWith("Cargo.toml")) return '[package]\nname = "' + (dirName || "function") + '"\nversion = "0.1.0"\nedition = "2021"\n';
  if (path.endsWith("package.json")) return '{\n  "name": "' + (dirName || "function") + '",\n  "private": true\n}\n';
  if (path.endsWith("tsconfig.json")) return '{\n  "compilerOptions": { "strict": true }\n}\n';
  if (path.endsWith("requirements.txt")) return "# add dependencies here\n";
  return "// Placeholder file. Multi-file editing is tracked in #84.\n";
}

function initEditorFiles(mode, lang, mainContent) {
  const manifest = FILE_MANIFESTS[lang] || FILE_MANIFESTS.python;
  const contents = {};
  const dirName = functionDirName(mode);
  manifest.forEach(file => {
    contents[file.path] = file.main ? (mainContent || "") : stubContent(lang, file.path, dirName);
  });
  window["__" + mode + "Files"] = { lang: lang, manifest: manifest, contents: contents };
  window["__" + mode + "ActiveFile"] = (manifest.find(f => f.main) || manifest[0]).path;
  renderFileTree(mode);
  updateEditorPath(mode);
}

function renderFileTree(mode) {
  const state = window["__" + mode + "Files"];
  const el = document.getElementById(mode + "-file-tree");
  if (!state || !el) return;
  const dirName = functionDirName(mode);
  const active = window["__" + mode + "ActiveFile"];
  const files = state.manifest.map(file => {
    const isActive = file.path === active;
    return '<button class="z-tree-file' + (isActive ? " active" : "") + '" data-path="' + escapeFnHtml(file.path) + '" onclick="selectEditorFile(\'' + mode + '\',\'' + escapeFnHtml(file.path) + '\')" title="' + escapeFnHtml(file.path) + '">' +
      zIcon("file") + '<span class="z-tree-name">' + escapeFnHtml(file.path) + '</span>' +
      (file.main ? "" : '<span class="z-badge z-badge-amber">stub</span>') +
      '</button>';
  }).join("");
  el.innerHTML =
    '<div class="z-tree-root-row">' +
      '<button class="z-tree-root" id="' + mode + '-tree-root" onclick="toggleFileTree(\'' + mode + '\')">' +
        '<span class="z-tree-caret">' + zIcon("chevron-right") + '</span>' +
        '<span class="z-mono">' + escapeFnHtml(dirName) + '/</span>' +
        '<span class="z-badge z-badge-muted">' + state.manifest.length + '</span>' +
      '</button>' +
    '</div>' +
    '<div class="z-tree-children hidden" id="' + mode + '-tree-children">' + files + '</div>' +
    '<div class="z-tree-foot"><span class="z-kbd">space</span><span class="z-kbd">space</span> files · <span class="z-kbd">space</span><span class="z-kbd">/</span> content</div>';
}

function toggleFileTree(mode) {
  const children = document.getElementById(mode + "-tree-children");
  if (!children) return;
  children.classList.toggle("hidden");
  const caret = document.querySelector("#" + mode + "-tree-root .z-tree-caret svg");
  if (caret) caret.style.transform = children.classList.contains("hidden") ? "" : "rotate(90deg)";
}

function updateEditorPath(mode) {
  const state = window["__" + mode + "Files"];
  const el = document.getElementById(mode + "-editor-path");
  if (!state || !el) return;
  const active = window["__" + mode + "ActiveFile"];
  const main = (state.manifest.find(f => f.main) || {}).path;
  el.innerHTML = escapeFnHtml(functionDirName(mode)) + '/ <span style="color:var(--text)">' + escapeFnHtml(active) + '</span>' +
    (active !== main ? ' <span class="z-badge z-badge-amber">stub</span>' : '');
}

function renameFunctionDir(mode) {
  const state = window["__" + mode + "Files"];
  if (!state) return;
  const dirName = functionDirName(mode);
  state.manifest.forEach(file => {
    if (!file.main) state.contents[file.path] = stubContent(state.lang, file.path, dirName);
  });
  renderFileTree(mode);
  updateEditorPath(mode);
}

function syncEditorBuffer(mode) {
  const ed = activeEditor(mode);
  const state = window["__" + mode + "Files"];
  if (!ed || !state) return;
  const active = window["__" + mode + "ActiveFile"];
  if (active) state.contents[active] = ed.getValue();
}

function mainFile(mode) {
  const state = window["__" + mode + "Files"];
  return state ? (state.manifest.find(f => f.main) || state.manifest[0]) : null;
}

function mainFileContent(mode) {
  syncEditorBuffer(mode);
  const main = mainFile(mode);
  const state = window["__" + mode + "Files"];
  return main && state ? (state.contents[main.path] || "") : "";
}

function selectEditorFile(mode, path) {
  const state = window["__" + mode + "Files"];
  if (!state || state.contents[path] === undefined) return;
  syncEditorBuffer(mode);
  window["__" + mode + "ActiveFile"] = path;
  const ed = activeEditor(mode);
  if (ed) {
    ed.session.setMode("ace/mode/" + modeMap[state.lang]);
    ed.setValue(state.contents[path] || "", -1);
    ed.focus();
  }
  document.querySelectorAll("#" + mode + "-file-tree .z-tree-file").forEach(btn => {
    btn.classList.toggle("active", btn.getAttribute("data-path") === path);
  });
  document.getElementById(mode + "-tree-children")?.classList.remove("hidden");
  const caret = document.querySelector("#" + mode + "-tree-root .z-tree-caret svg");
  if (caret) caret.style.transform = "rotate(90deg)";
  updateEditorPath(mode);
}

function openCreate(){
  window.__isCreateEditor = true;
  window.__isEditEditor = false;
  zOpenModal("create-modal");

  if (!createEditor && window.ace) {
    createEditor = ace.edit("create-ace");
    createEditor.setTheme("ace/theme/dracula");
    applyEditorVim("create");
  }

  const mainContent = getTemplate(selectedLang, selectedCreateMode) || "";
  initEditorFiles("create", selectedLang, mainContent);
  if (createEditor) {
    createEditor.session.setMode("ace/mode/" + modeMap[selectedLang]);
    createEditor.setValue(mainContent, -1);
    setTimeout(() => createEditor.focus(), 120);
  }
  updateCreateModeButtons();
}

function selectLang(lang){
  selectedLang = lang;
  document.querySelectorAll('.z-lang-tile').forEach(b=>b.classList.remove('selected'));
  const el = document.getElementById('lang-' + lang);
  if(el) el.classList.add('selected');
  if(createEditor){
    const mainContent = getTemplate(lang, selectedCreateMode) || "";
    initEditorFiles("create", lang, mainContent);
    createEditor.session.setMode('ace/mode/' + modeMap[lang]);
    createEditor.setValue(mainContent, -1);
    setTimeout(()=>createEditor.focus(),120);
  }
}

function closeCreate(){
  window.__isCreateEditor = false;
  closeTelescope();
  zCloseModal('create-modal');
}

function saveCreate(exit){
  const name = document.getElementById('fn-name-input')?.value?.trim();
  if(!name){
    const el = document.getElementById('fn-name-input');
    el.classList.add('shake');
    setTimeout(()=>el.classList.remove('shake'),400);
    el.focus();
    return;
  }
  if (!exit) {
    toast("Draft saving is not supported; use Create & deploy", "info");
    return;
  }
  const main = mainFile("create");
  if (window.__createActiveFile && main && window.__createActiveFile !== main.path) {
    toast("Stub files are read-only in this preview; saving the main file only", "info");
  }
  const description = document.getElementById('fn-desc-input')?.value?.trim();
  const payload = {
    name: name,
    language: selectedLang,
    description: description,
    code: mainFileContent("create"),
    is_async: selectedCreateMode === "async"
  };
  fetch(`/api/functions/`,{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(payload)
  }).then(()=>{
    if(exit) closeCreate();
    refreshList()
  });
}

function openEdit(id, lang){
  window.__isCreateEditor = false;
  window.__isEditEditor = true;
  window.__editFnID = id;
  window.__editFnLang = lang;
  window.__editFnName = "";
  zOpenModal('edit-modal');
  if(!editEditor && window.ace){
    editEditor = ace.edit('edit-ace');
    editEditor.setTheme('ace/theme/dracula');
    applyEditorVim("edit");
  }

  if(editEditor){
    editEditor.session.setMode('ace/mode/' + modeMap[lang]);
    editEditor.setValue('Loading...', -1);
    fetch(`/api/functions/${id}/`).then(r=>r.json()).then(data=>{
      selectedEditMode = data?.is_async ? "async" : "sync";
      updateEditModeButtons();
      window.__editFnName = data?.name || data?.Name || id.slice(0, 10);
      const mainContent = data.content || getTemplate(lang, selectedEditMode) || '';
      initEditorFiles("edit", lang, mainContent);
      editEditor.setValue(mainContent, -1);
      applyEditorVim("edit");
      editEditor.focus();
      setTimeout(() => editEditor.focus(), 50);
    }).catch(()=>{
      window.__editFnName = id.slice(0, 10);
      const mainContent = getTemplate(lang, selectedEditMode) || '';
      initEditorFiles("edit", lang, mainContent);
      editEditor.setValue(mainContent, -1);
      editEditor.focus();
    });
    editEditor.focus();
  }
  updateEditModeButtons();
}

function closeEdit(){
  window.__isEditEditor = false;
  closeTelescope();
  zCloseModal('edit-modal');
}

function saveEdit(exit){
  if(!window.__editFnID) return;
  const main = mainFile("edit");
  if (window.__editActiveFile && main && window.__editActiveFile !== main.path) {
    toast("Stub files are read-only in this preview; saving the main file only", "info");
  }
  const body = mainFileContent("edit");
  fetch(`/api/functions/${window.__editFnID}/`,{
    method:'PUT',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      code: body,
      is_async: selectedEditMode === "async"
    })
  }).then(()=>{
    if(exit) closeEdit();
    refreshList()
  });
}

/* --- telescope-like file/content search --- */
function openTelescope(mode, type) {
  syncEditorBuffer(mode);
  teleState = { mode: mode, type: type, results: [], index: -1 };
  const modal = document.getElementById("z-telescope");
  const input = document.getElementById("z-telescope-input");
  const kind = document.getElementById("z-telescope-kind");
  if (!modal || !input) return;
  input.value = "";
  input.placeholder = type === "files" ? "Search files…" : "Search current file…";
  if (kind) kind.textContent = type === "files" ? "files" : "content";
  modal.classList.add("open");
  updateTelescope();
  setTimeout(() => input.focus(), 30);
}

function closeTelescope() {
  document.getElementById("z-telescope")?.classList.remove("open");
}

function telescopeItems() {
  const state = window["__" + teleState.mode + "Files"];
  const query = (document.getElementById("z-telescope-input")?.value || "").trim().toLowerCase();
  if (!state) return [];
  if (teleState.type === "files") {
    return state.manifest
      .filter(file => !query || file.path.toLowerCase().includes(query))
      .map(file => ({ label: file.path, path: file.path, main: file.main }));
  }
  const active = window["__" + teleState.mode + "ActiveFile"];
  const content = state.contents[active] || "";
  return content.split("\n").map((line, i) => ({
    label: line.trim() || "(blank line)",
    line: i + 1
  })).filter(item => !query || item.label.toLowerCase().includes(query));
}

function updateTelescope() {
  teleState.results = telescopeItems();
  teleState.index = teleState.results.length ? 0 : -1;
  renderTelescopeResults();
}

function renderTelescopeResults() {
  const container = document.getElementById("z-telescope-results");
  if (!container) return;
  if (!teleState.results.length) {
    container.innerHTML = '<div class="z-empty" style="padding:22px"><div class="z-empty-title">No matches</div><div class="z-empty-sub">Try a different query.</div></div>';
    return;
  }
  container.innerHTML = teleState.results.map((item, i) => {
    const active = i === teleState.index ? " active" : "";
    const right = teleState.type === "files"
      ? (item.main ? '<span class="z-badge z-badge-green">main</span>' : '<span class="z-badge z-badge-amber">stub</span>')
      : '<span class="z-mono" style="font-size:9px;color:var(--text-4)">L' + item.line + '</span>';
    return '<button class="z-telescope-result' + active + '" onclick="chooseTelescope(' + i + ')">' +
      zIcon(teleState.type === "files" ? "file" : "search") +
      '<span class="z-telescope-label">' + escapeFnHtml(item.label) + '</span>' + right + '</button>';
  }).join("");
  container.querySelectorAll(".z-telescope-result")[teleState.index]?.scrollIntoView({ block: "nearest" });
}

function chooseTelescope(index) {
  const item = teleState.results[index];
  if (!item) return;
  if (teleState.type === "files") {
    selectEditorFile(teleState.mode, item.path);
  } else {
    const ed = activeEditor(teleState.mode);
    if (ed) {
      ed.gotoLine(item.line, 0, true);
      ed.focus();
    }
  }
  closeTelescope();
}

document.addEventListener("keydown", function (e) {
  const tele = document.getElementById("z-telescope");
  if (tele?.classList.contains("open")) {
    if (e.key === "Escape") { e.preventDefault(); closeTelescope(); return; }
    if (e.key === "ArrowDown") { e.preventDefault(); teleState.index = Math.min(teleState.index + 1, teleState.results.length - 1); renderTelescopeResults(); return; }
    if (e.key === "ArrowUp") { e.preventDefault(); teleState.index = Math.max(teleState.index - 1, 0); renderTelescopeResults(); return; }
    if (e.key === "Enter") { e.preventDefault(); chooseTelescope(teleState.index); return; }
    return;
  }

  const editOpen = document.getElementById("edit-modal")?.classList.contains("open");
  const createOpen = document.getElementById("create-modal")?.classList.contains("open");
  const mode = editOpen ? "edit" : (createOpen ? "create" : null);
  if (!mode || !vimEnabled(mode)) return;
  const ed = activeEditor(mode);
  if (!ed || !ed.container || !ed.container.contains(e.target)) return;

  // Best-effort guard so insert-mode spaces still type normally.
  const vimState = ed.state && ed.state.cm && ed.state.cm.state && ed.state.cm.state.vim;
  if (vimState && vimState.insertMode) return;

  const now = Date.now();
  if (e.code === "Space" || e.key === " ") {
    if (now - lastVimSpace < 600) {
      e.preventDefault();
      lastVimSpace = 0;
      openTelescope(mode, "files");
    } else {
      lastVimSpace = now;
    }
    return;
  }
  if (e.key === "/" && now - lastVimSpace < 600) {
    e.preventDefault();
    lastVimSpace = 0;
    openTelescope(mode, "content");
    return;
  }
  lastVimSpace = 0;
}, true);

/* --- bind language tiles and other DOM wiring after load --- */
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.z-lang-tile[data-lang]').forEach(btn=>{
    btn.addEventListener('click', ()=> {
      const lang = btn.getAttribute('data-lang');
      selectLang(lang);
    });
  });

  window.__activeProjectID = getActiveProjectID();
  fnStartActionsSSE();
  selectLang(selectedLang);
  updateCreateModeButtons();
  updateEditModeButtons();

  ["create", "edit"].forEach(mode => {
    document.getElementById(mode + "-vim-toggle")?.addEventListener("change", () => applyEditorVim(mode));
  });

  const params = new URLSearchParams(window.location.search);
  const editId = params.get("edit");
  if (editId) {
    fetch(`/api/functions/${editId}/`)
      .then(r => r.json())
      .then(f => openEdit(f.id, f.language))
      .catch(err => console.error("Failed to auto-open edit modal", err));
  }
  openFnFromQuery();
});

window.__deleteFnID = null;

function deleteFn(id) {
    window.__deleteFnID = id;
    zOpenModal("delete-modal");
}

function closeDelete() {
    window.__deleteFnID = null;
    zCloseModal("delete-modal");
}

function confirmDelete() {
    if (!window.__deleteFnID) return;

    fetch(`/api/functions/${window.__deleteFnID}/`, {
        method: "DELETE"
    })
    .then(() => {
        closeDelete();
        refreshList(); // refresh UI
    });
}


function fnIcon(name) {
    const paths = {
        code: '<path d="m8 6-6 6 6 6"/><path d="m16 6 6 6-6 6"/>',
        copy: '<rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
        edit: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
        route: '<circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/>',
        sliders: '<line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>',
        activity: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
        terminal: '<path d="m4 17 6-6-6-6M12 19h8"/>',
        close: '<path d="M18 6 6 18M6 6l12 12"/>',
        play: '<path d="m5 3 14 9-14 9V3Z"/>',
        maximize: '<path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/>',
        github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
        trash: '<path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>'
    };
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' + (paths[name] || "") + '</svg>';
}

function escapeFnHtml(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}

function filterFunctions(q) {
    const needle = String(q || "").trim().toLowerCase();
    document.querySelectorAll("#fn-list-container .z-fn-row").forEach(row => {
        const name = String(row.getAttribute("data-fn-name") || "").toLowerCase();
        row.style.display = (!needle || name.includes(needle)) ? "" : "none";
    });
}

function refreshList() {
    fnLogStreams.forEach((st, id) => closeFnLog(id));
    activeLogFnID = "";
    window.location.reload();
}
	</script>

	<style>
	.ace_editor,
	.ace_scroller,
	.ace_content { background: #0b0b0c !important; color: #eee !important; }
	.shake { animation: shake .3s linear; }
	@keyframes shake { 0%{transform:translateX(0)} 25%{transform:translateX(-6px)} 50%{transform:translateX(6px)} 75%{transform:translateX(-6px)} 100%{transform:translateX(0)} }
	</style>

}

templ functionConfigPanel(fn Function, repoURL string) {
	<div id={ "fn-config-" + fn.ID } class="z-fn-config hidden" data-fn-config>
		<div class="z-fn-config-head">
			<span class="z-panel-title">Function config</span>
			<span class="z-badge z-badge-muted">{ fn.Name }</span>
			<span class="z-badge z-badge-amber">dummy data</span>
			<span class="z-help">Runtime, isolation and rate limits scoped to this function.</span>
		</div>
		<div class="z-fn-config-grid">
			<div class="z-field">
				<span class="z-label">HTTP methods</span>
				if fn.IsAsync {
					<div style="margin-top:7px"><span class="z-badge z-badge-purple">WebSocket · GET</span></div>
				} else {
					<input type="hidden" id={ "fn-config-methods-" + fn.ID } value={ fn.Method }/>
					<div class="z-method-row">
						for _, m := range []string{"GET", "POST", "PUT", "PATCH", "DELETE"} {
							<button type="button" onclick={ selectFnMethod(fn.ID, m) } id={ "fn-method-" + m + "-" + fn.ID } class={ "z-method-btn", templ.KV("selected", strings.Contains(fn.Method, m)) }>{ m }</button>
						}
					</div>
				}
				<span class="z-help">Methods for the generated endpoint. Defaults to POST.</span>
			</div>
			<div class="z-field">
				<label class="z-label">Runtime interface</label>
				<select class="z-select">
					<option selected>containerd · runc (default)</option>
					<option>gVisor · runsc</option>
					<option>Kata Containers · microVM</option>
					<option>WASM / WASI · wasmtime</option>
					<option>Firecracker · microVM</option>
				</select>
				<span class="z-help">Containerd by default; stronger isolation is opt-in.</span>
			</div>
			if fn.Language == "python" || fn.Language == "ts" || fn.Language == "lua" {
				<div class="z-field">
					<span class="z-label">Dynamic runtime</span>
					<div class="z-mode-toggle">
						<button class="z-mode-btn selected" onclick="setDynRuntime(this,'shared')">Shared</button>
						<button class="z-mode-btn" onclick="setDynRuntime(this,'dedicated')">Dedicated</button>
					</div>
					<span class="z-help">Python, TypeScript and Lua only.</span>
				</div>
			}
			<div class="z-field">
				<span class="z-label">Rate limit</span>
				<div class="z-input-group">
					<input class="z-input z-mono" style="width:92px" value="120" aria-label="requests per minute"/>
					<span class="z-help">req/min</span>
				</div>
				<span class="z-help">Burst <span class="z-code-inline">40</span> · per function at the gateway.</span>
			</div>
			<div class="z-field">
				<span class="z-label">Dedicated resources</span>
				<div class="z-grid z-grid-2" style="gap:7px">
					<select class="z-select" aria-label="vCPU"><option>0.5 vCPU</option><option selected>1 vCPU</option><option>2 vCPU</option></select>
					<select class="z-select" aria-label="Memory"><option>256 MiB</option><option selected>512 MiB</option><option>1 GiB</option></select>
				</div>
				<span class="z-help">Applied when dedicated runtime is selected.</span>
			</div>
		</div>
		<div class="z-fn-config-foot">
			if repoURL != "" {
				<a class="z-btn z-btn-sm" href={ repoURL } target="_blank" rel="noopener" aria-label="Open repository in Gitea" title="Open repository in Gitea">@Icon("github", "")</a>
			}
			<span class="z-help">Config is stored with this function package.</span>
			<button class="z-btn z-btn-sm z-btn-primary" style="margin-left:auto" onclick="toast('Function config saved (placeholder)','success')">@Icon("save", "") Save config</button>
		</div>
	</div>
}
