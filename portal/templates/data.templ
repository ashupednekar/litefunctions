package templates

templ DataContent() {
	@PageHead("Objects", "S3-compatible object buckets, presigned URLs and bucket policies for this project.", "Data", templ.Raw(`
		<button class="z-btn" onclick="toast('Storage docs are a placeholder','info')">`+svgExternal()+` Storage docs</button>
		<button class="z-btn z-btn-primary" onclick="zOpenModal('store-modal')">`+svgPlus()+` New bucket</button>
	`))

	<div class="z-grid z-grid-4" style="margin-bottom:14px">
		<div class="z-stat"><div class="z-stat-label">@Icon("box", "") Buckets</div><div class="z-stat-value">3</div><div class="z-stat-delta">S3 compatible <span class="z-faint">·</span> MinIO</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("layers", "") Objects</div><div class="z-stat-value">3,682</div><div class="z-stat-delta">across all buckets</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("database", "") Storage</div><div class="z-stat-value">3.4<small>GB</small></div><div class="z-stat-delta">4 GiB PVC <span class="z-faint">·</span> 85% free</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("shield", "") Versioning</div><div class="z-stat-value">2</div><div class="z-stat-delta">buckets versioned <span class="z-faint">·</span> 1 suspended</div></div>
	</div>

	<div class="z-panel">
		<div class="z-panel-header">
			<span class="z-panel-title">Object buckets</span>
			<span class="z-panel-sub">S3-compatible · presigned URLs</span>
			<div class="z-panel-actions"><button class="z-btn z-btn-sm">@Icon("plus", "") Add bucket</button></div>
		</div>
		<div class="z-table-wrap">
			<table class="z-table">
				<thead><tr><th>Bucket</th><th>Provider</th><th>Endpoint</th><th>Region</th><th>Objects</th><th>Size</th><th>Versioning</th><th>Status</th><th></th></tr></thead>
				<tbody>
					@objectRow("user_uploads", "MinIO", "minio.litefunctions", "local", "3,402", "1.2 GB", "enabled", "healthy")
					@objectRow("exports", "MinIO", "minio.litefunctions", "local", "184", "1.8 GB", "enabled", "healthy")
					@objectRow("static-assets", "MinIO", "minio.litefunctions", "local", "96", "410 MB", "suspended", "healthy")
				</tbody>
			</table>
		</div>
		<div class="z-panel-foot"><span class="z-help">Signed URLs expire in 15 minutes. Direct browser uploads use presigned POST.</span><span class="z-badge z-badge-blue" style="margin-left:auto">S3 API</span></div>
	</div>

	<div class="z-panel" style="margin-top:14px">
		<div class="z-panel-header">
			<span class="z-panel-title z-mono">user_uploads</span>
			<span class="z-badge z-badge-muted">3,402 objects</span>
			<span class="z-panel-sub">bucket contents</span>
			<div class="z-panel-actions"><button class="z-btn z-btn-sm">@Icon("plus", "") Upload</button></div>
		</div>
		<div class="z-table-wrap">
			<table class="z-table">
				<thead><tr><th>Object</th><th>Size</th><th>Content type</th><th>Modified</th><th></th></tr></thead>
				<tbody>
					<tr><td class="z-cell-main z-mono" style="font-size:10.5px">avatars/ashu.png</td><td class="z-cell-mono">48 KB</td><td class="z-cell-mono">image/png</td><td class="z-cell-mono">1h ago</td><td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("external", "")</button></td></tr>
					<tr><td class="z-cell-main z-mono" style="font-size:10.5px">receipts/2026/11/order-8891.pdf</td><td class="z-cell-mono">210 KB</td><td class="z-cell-mono">application/pdf</td><td class="z-cell-mono">2h ago</td><td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("external", "")</button></td></tr>
					<tr><td class="z-cell-main z-mono" style="font-size:10.5px">imports/products.csv</td><td class="z-cell-mono">1.4 MB</td><td class="z-cell-mono">text/csv</td><td class="z-cell-mono">yesterday</td><td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("external", "")</button></td></tr>
				</tbody>
			</table>
		</div>
		<div class="z-panel-foot"><span class="z-help">Object paths are bucket-relative. Lifecycle policies can expire prefixes.</span></div>
	</div>

	<div id="store-modal" class="z-modal-backdrop" onclick="zCloseModal('store-modal')">
		<div class="z-modal" onclick="event.stopPropagation()">
			<div class="z-modal-header">@Icon("box", "w-4 h-4")<span class="z-modal-title">New bucket</span><button class="z-icon-btn" style="margin-left:auto" data-close-modal>@Icon("close", "")</button></div>
			<div class="z-modal-body">
				<div class="z-field"><label class="z-label">Name</label><input class="z-input z-mono" placeholder="my-bucket"/></div>
				<div class="z-field" style="margin-top:11px"><label class="z-label">Versioning</label><select class="z-select"><option>Enabled</option><option>Suspended</option></select></div>
				<div class="z-field" style="margin-top:11px"><label class="z-label">Lifecycle</label><select class="z-select"><option>Keep forever</option><option>Expire after 30 days</option><option>Expire after 90 days</option></select></div>
			</div>
			<div class="z-modal-foot"><button class="z-btn" data-close-modal>Cancel</button><button class="z-btn z-btn-primary" onclick="zCloseModal('store-modal'); toast('Bucket creation is a placeholder','success')">Create bucket</button></div>
		</div>
	</div>
}

templ objectRow(bucket string, provider string, endpoint string, region string, objects string, size string, versioning string, status string) {
	<tr>
		<td class="z-cell-main z-mono" style="font-size:10.5px">{ bucket }</td>
		<td class="z-cell-mono">{ provider }</td>
		<td class="z-cell-mono">{ endpoint }</td>
		<td><span class="z-badge z-badge-muted">{ region }</span></td>
		<td class="z-cell-mono">{ objects }</td>
		<td class="z-cell-mono">{ size }</td>
		<td><span class={ "z-badge", templ.KV("z-badge-green", versioning == "enabled"), templ.KV("z-badge-muted", versioning != "enabled") }>{ versioning }</span></td>
		<td><span class={ "z-badge", templ.KV("z-badge-green", status == "healthy"), templ.KV("z-badge-amber", status != "healthy") }>{ status }</span></td>
		<td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("external", "")</button></td>
	</tr>
}
