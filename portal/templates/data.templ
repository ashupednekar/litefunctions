package templates

templ DataContent() {
	@PageHead("Data & Storage", "Key-value stores, object buckets, streams and databases attached to this project.", "Data", templ.Raw(`
		<button class="z-btn" onclick="toast('Storage docs are a placeholder','info')">`+svgExternal()+` Storage docs</button>
		<button class="z-btn z-btn-primary" onclick="zOpenModal('store-modal')">`+svgPlus()+` Attach store</button>
	`))

	<div class="z-grid z-grid-4" style="margin-bottom:14px">
		<div class="z-stat"><div class="z-stat-label">@Icon("layers", "") Key-value</div><div class="z-stat-value">2</div><div class="z-stat-delta">versioned buckets <span class="z-faint">·</span> 1.2M keys</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("box", "") Object buckets</div><div class="z-stat-value">1</div><div class="z-stat-delta">3.4 GB <span class="z-faint">·</span> S3 compatible</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("database", "") Databases</div><div class="z-stat-value">1</div><div class="z-stat-delta">Postgres 16 <span class="z-faint">·</span> 22% used</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("network", "") Streams</div><div class="z-stat-value">4</div><div class="z-stat-delta">JetStream <span class="z-faint">·</span> see Pub/Sub</div></div>
	</div>

	<div class="z-tabs" data-tab-group>
		<button class="z-tab active" data-tab="overview">Overview</button>
		<button class="z-tab" data-tab="kv">Key-value</button>
		<button class="z-tab" data-tab="buckets">Object buckets</button>
		<button class="z-tab" data-tab="databases">Databases</button>
	</div>

	<div data-tab-panel="overview">
		<div class="z-grid z-grid-2">
			<a href="/pubsub/" class="z-panel" style="text-decoration:none">
				<div class="z-panel-header"><span class="z-panel-title">Streams</span><span class="z-badge z-badge-green" style="margin-left:auto">4 active</span></div>
				<div class="z-panel-body">
					<div class="z-help">Durable JetStream streams for events and async work.</div>
					<div class="z-list" style="margin-top:10px">
						<div class="z-list-item"><span class="z-list-icon">@Icon("network", "")</span><div class="z-list-main"><div class="z-list-title z-mono" style="font-size:10.5px">ORDERS</div><div class="z-list-sub">1.28M messages · 412 MB</div></div><span class="z-badge z-badge-green">healthy</span></div>
						<div class="z-list-item"><span class="z-list-icon">@Icon("network", "")</span><div class="z-list-main"><div class="z-list-title z-mono" style="font-size:10.5px">PAYMENTS</div><div class="z-list-sub">384k messages · 96 MB</div></div><span class="z-badge z-badge-green">healthy</span></div>
					</div>
				</div>
				<div class="z-panel-foot"><span class="z-help">Open Pub/Sub · Olly</span>@Icon("arrow-right", "ml-auto w-3 h-3 text-[#5b5b65]")</div>
			</a>

			<div class="z-panel">
				<div class="z-panel-header"><span class="z-panel-title">Key-value stores</span><div class="z-panel-actions"><button class="z-btn z-btn-sm">@Icon("plus", "") New</button></div></div>
				<div class="z-panel-body tight">
					<div class="z-list">
						@kvRow("app_settings", "24 keys", "v7", "healthy")
						@kvRow("sessions", "1.2M keys", "v3", "healthy")
						@kvRow("feature_cache", "82 keys", "v12", "healthy")
					</div>
				</div>
			</div>

			<div class="z-panel">
				<div class="z-panel-header"><span class="z-panel-title">Object buckets</span></div>
				<div class="z-panel-body">
					@storageBar("user_uploads", 3400, 10000, "34%")
					<div class="z-divider"></div>
					<dl class="z-kv"><dt>Provider</dt><dd>S3 compatible</dd><dt>Endpoint</dt><dd>minio.litefunctions</dd><dt>Versioning</dt><dd>enabled</dd></dl>
				</div>
			</div>

			<div class="z-panel">
				<div class="z-panel-header"><span class="z-panel-title">Databases</span><span class="z-badge z-badge-blue" style="margin-left:auto">postgres 16</span></div>
				<div class="z-panel-body">
					<div class="z-list">
						<div class="z-list-item"><span class="z-list-icon">@Icon("database", "")</span><div class="z-list-main"><div class="z-list-title z-mono" style="font-size:10.5px">orders</div><div class="z-list-sub">pool 8 / 20 · 22% disk</div></div><span class="z-badge z-badge-green">healthy</span></div>
					</div>
					<div class="z-divider"></div>
					<a href="/data-model/" class="z-btn z-btn-sm" style="width:100%">@Icon("table", "") Open data model</a>
				</div>
			</div>
		</div>
	</div>

	<div data-tab-panel="kv" style="display:none">
		<div class="z-split-wide">
			<div class="z-panel">
				<div class="z-panel-header"><span class="z-panel-title">Buckets</span></div>
				<div class="z-panel-body tight" style="padding:6px">
					<button class="z-nav-item active" style="width:100%;text-align:left">@Icon("layers", "") <span>app_settings</span></button>
					<button class="z-nav-item" style="width:100%;text-align:left">@Icon("layers", "") <span>sessions</span></button>
					<button class="z-nav-item" style="width:100%;text-align:left">@Icon("layers", "") <span>feature_cache</span></button>
				</div>
			</div>
			<div class="z-panel">
				<div class="z-panel-header"><span class="z-panel-title z-mono">app_settings</span><span class="z-badge z-badge-muted">24 keys</span><div class="z-panel-actions"><button class="z-btn z-btn-sm">@Icon("plus", "") Key</button></div></div>
				<div class="z-table-wrap">
					<table class="z-table">
						<thead><tr><th>Key</th><th>Value</th><th>Revision</th><th>Updated</th><th></th></tr></thead>
						<tbody>
							<tr><td class="z-cell-main z-mono" style="font-size:10.5px">orders.currency</td><td class="z-cell-mono">USD</td><td class="z-cell-mono">7</td><td class="z-cell-mono">2d ago</td><td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("edit", "")</button></td></tr>
							<tr><td class="z-cell-main z-mono" style="font-size:10.5px">orders.max_items</td><td class="z-cell-mono">50</td><td class="z-cell-mono">3</td><td class="z-cell-mono">5d ago</td><td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("edit", "")</button></td></tr>
							<tr><td class="z-cell-main z-mono" style="font-size:10.5px">payments.provider</td><td class="z-cell-mono">stripe</td><td class="z-cell-mono">1</td><td class="z-cell-mono">12d ago</td><td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("edit", "")</button></td></tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

	<div data-tab-panel="buckets" style="display:none">
		<div class="z-panel">
			<div class="z-panel-header"><span class="z-panel-title">user_uploads</span><span class="z-badge z-badge-muted">3,402 objects</span><div class="z-panel-actions"><button class="z-btn z-btn-sm">@Icon("plus", "") Upload</button></div></div>
			<div class="z-table-wrap">
				<table class="z-table">
					<thead><tr><th>Object</th><th>Size</th><th>Content type</th><th>Modified</th><th></th></tr></thead>
					<tbody>
						<tr><td class="z-cell-main z-mono" style="font-size:10.5px">avatars/ashu.png</td><td class="z-cell-mono">48 KB</td><td class="z-cell-mono">image/png</td><td class="z-cell-mono">1h ago</td><td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("external", "")</button></td></tr>
						<tr><td class="z-cell-main z-mono" style="font-size:10.5px">receipts/2026/11/order-8891.pdf</td><td class="z-cell-mono">210 KB</td><td class="z-cell-mono">application/pdf</td><td class="z-cell-mono">2h ago</td><td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("external", "")</button></td></tr>
						<tr><td class="z-cell-main z-mono" style="font-size:10.5px">imports/products.csv</td><td class="z-cell-mono">1.4 MB</td><td class="z-cell-mono">text/csv</td><td class="z-cell-mono">yesterday</td><td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("external", "")</button></td></tr>
					</tbody>
				</table>
			</div>
			<div class="z-panel-foot"><span class="z-help">Signed URLs expire in 15 minutes. Direct browser uploads use presigned POST.</span></div>
		</div>
	</div>

	<div data-tab-panel="databases" style="display:none">
		<div class="z-split">
			<div class="z-panel">
				<div class="z-panel-header"><span class="z-panel-title">orders</span><span class="z-badge z-badge-green" style="margin-left:auto">connected</span><div class="z-panel-actions"><button class="z-btn z-btn-sm">@Icon("play", "") Query</button></div></div>
				<div class="z-panel-body">
					<div class="z-grid z-grid-3">
						<div><div class="z-stat-label">Connections</div><div style="font-size:18px;margin-top:4px">8 / 20</div></div>
						<div><div class="z-stat-label">Disk</div><div style="font-size:18px;margin-top:4px">2.2 / 10 GB</div></div>
						<div><div class="z-stat-label">P95 query</div><div style="font-size:18px;margin-top:4px">7ms</div></div>
					</div>
					<div class="z-divider"></div>
					<dl class="z-kv">
						<dt>Host</dt><dd>orders-db.litefunctions</dd>
						<dt>Database</dt><dd>orders</dd>
						<dt>Extensions</dt><dd>pgcrypto, pg_stat_statements</dd>
						<dt>Backups</dt><dd>daily · 7 retained</dd>
					</dl>
					<a href="/data-model/" class="z-btn" style="width:100%;margin-top:12px">@Icon("table", "") Manage schema</a>
				</div>
			</div>
			<aside>
				<div class="z-panel">
					<div class="z-panel-header"><span class="z-panel-title">Tables</span></div>
					<div class="z-panel-body tight">
						<div class="z-list">
							<div class="z-list-item"><span class="z-list-icon">@Icon("table", "")</span><div class="z-list-main"><div class="z-list-title z-mono" style="font-size:10.5px">orders</div><div class="z-list-sub">184k rows · 410 MB</div></div></div>
							<div class="z-list-item"><span class="z-list-icon">@Icon("table", "")</span><div class="z-list-main"><div class="z-list-title z-mono" style="font-size:10.5px">customers</div><div class="z-list-sub">22k rows · 18 MB</div></div></div>
							<div class="z-list-item"><span class="z-list-icon">@Icon("table", "")</span><div class="z-list-main"><div class="z-list-title z-mono" style="font-size:10.5px">order_items</div><div class="z-list-sub">512k rows · 96 MB</div></div></div>
						</div>
					</div>
				</div>
			</aside>
		</div>
	</div>

	<div id="store-modal" class="z-modal-backdrop" onclick="zCloseModal('store-modal')">
		<div class="z-modal" onclick="event.stopPropagation()">
			<div class="z-modal-header">@Icon("layers", "w-4 h-4")<span class="z-modal-title">Attach storage</span><button class="z-icon-btn" style="margin-left:auto" data-close-modal>@Icon("close", "")</button></div>
			<div class="z-modal-body">
				<div class="z-field"><label class="z-label">Type</label><select class="z-select"><option>Key-value bucket</option><option>Object bucket</option><option>Postgres database</option><option>JetStream stream</option></select></div>
				<div class="z-field" style="margin-top:11px"><label class="z-label">Name</label><input class="z-input z-mono" placeholder="my_store"/></div>
				<div class="z-field" style="margin-top:11px"><label class="z-label">Scope</label><select class="z-select"><option>All functions</option><option>Selected functions</option></select></div>
			</div>
			<div class="z-modal-foot"><button class="z-btn" data-close-modal>Cancel</button><button class="z-btn z-btn-primary" onclick="zCloseModal('store-modal'); toast('Storage attach is a placeholder','success')">Attach</button></div>
		</div>
	</div>
}

templ kvRow(name string, keys string, revision string, status string) {
	<div class="z-list-item">
		<span class="z-list-icon">@Icon("layers", "")</span>
		<div class="z-list-main">
			<div class="z-list-title z-mono" style="font-size:10.5px">{ name }</div>
			<div class="z-list-sub">{ keys } · { revision }</div>
		</div>
		<span class="z-badge z-badge-green">{ status }</span>
	</div>
}
