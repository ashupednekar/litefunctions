package templates

templ AgentContent() {
	@PageHead("Plan", "Describe a use case. Review the functions, schema, routes and policies the agent would generate before anything ships.", "Build", templ.Raw(`
		<button class="z-btn" onclick="toast('Draft history is a placeholder','info')">`+svgClock()+` History</button>
		<button class="z-btn z-btn-primary" onclick="newPlan()">`+svgPlus()+` New plan</button>
	`))

	<div class="z-alert z-alert-blue" style="margin-bottom:14px">
		@Icon("sparkles", "")
		<div><strong style="color:var(--text);font-weight:550">Preview experience.</strong> Plan generation is a UI-only mock. The eventual service will inspect repo context, propose artifacts, and apply them through the normal Git-driven deploy path.</div>
	</div>

	<div class="z-agent-layout">
		<div>
			<div class="z-panel">
				<div class="z-panel-header">
					<span class="z-panel-title">Use case</span>
					<span class="z-badge z-badge-purple">agent</span>
				</div>
				<div class="z-panel-body">
					<div class="z-composer">
						<textarea id="agent-prompt" placeholder="e.g. Build an order management API with a Postgres data model, a POST endpoint to create orders, a pub/sub event when an order is paid, and per-key rate limits…"></textarea>
						<div class="z-composer-bar">
							<span class="z-badge z-badge-muted">@Icon("file", "") repo context</span>
							<span class="z-badge z-badge-muted">@Icon("database", "") schema</span>
							<span class="z-badge z-badge-muted">@Icon("book", "") docs</span>
							<span style="margin-left:auto" class="z-mono z-faint">⌘↵</span>
						</div>
					</div>
					<div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:10px">
						<button class="z-chip-btn" onclick="usePrompt('Order management API with Postgres, create/list endpoints, and an order.paid event')">Order management API</button>
						<button class="z-chip-btn" onclick="usePrompt('Image resizer: upload to object storage, async worker, signed URL endpoint')">Image pipeline</button>
						<button class="z-chip-btn" onclick="usePrompt('Webhook fan-out with retries, dead-letter stream, and per-tenant rate limits')">Webhook fan-out</button>
						<button class="z-chip-btn" onclick="usePrompt('Realtime presence API using WebSocket, Redis KV, and presence events')">Realtime presence</button>
					</div>

					<div class="z-divider"></div>

					<div style="display:flex;flex-direction:column;gap:9px">
						<div style="display:flex;align-items:center;justify-content:space-between">
							<span style="font-size:11px;color:var(--text-2)">Model</span>
							<select class="z-select" style="width:190px;height:26px;font-size:10.5px"><option>planner-large</option><option>planner-fast</option><option>local (ollama)</option></select>
						</div>
						<div style="display:flex;align-items:center;justify-content:space-between">
							<span style="font-size:11px;color:var(--text-2)">Apply mode</span>
							<select class="z-select" style="width:190px;height:26px;font-size:10.5px"><option>Review each artifact</option><option>Open a draft PR</option><option>Apply directly</option></select>
						</div>
					</div>

					<div class="z-divider"></div>
					<div class="z-label" style="margin-bottom:8px">Generate artifacts</div>
					<div style="display:flex;flex-direction:column;gap:7px">
						@scopeToggle("Functions", "Go handlers with typed inputs", true)
						@scopeToggle("Endpoints", "HTTP routes + gateway wiring", true)
						@scopeToggle("Data model", "Tables, migrations, sqlc queries", true)
						@scopeToggle("Pub/Sub", "Streams, subjects, consumers", false)
						@scopeToggle("Traffic policies", "Rate limits and auth", false)
					</div>

					<button id="agent-generate" class="z-btn z-btn-primary" style="width:100%;height:34px;margin-top:14px" onclick="generatePlan()">
						@Icon("sparkles", "")
						Generate plan
						<span style="margin-left:auto" class="z-kbd">⌘↵</span>
					</button>
					<div class="z-help" style="text-align:center;margin-top:8px">Nothing is applied until you approve the plan.</div>
				</div>
			</div>
		</div>

		<div>
			<div class="z-panel">
				<div class="z-panel-header">
					<span class="z-panel-title">Generated plan</span>
					<span class="z-badge z-badge-amber" id="plan-status">draft</span>
					<span class="z-panel-sub" id="plan-meta">4 steps · 7 artifacts · est. 3 min</span>
					<div class="z-panel-actions">
						<button class="z-btn z-btn-sm">@Icon("copy", "") Copy</button>
						<button class="z-btn z-btn-sm z-btn-accent" onclick="toast('Plan queued for review','success')">@Icon("check", "") Approve plan</button>
					</div>
				</div>
				<div class="z-panel-body">
					<div class="z-tabs" data-tab-group style="margin-bottom:12px">
						<button class="z-tab active" data-tab="plan">Plan</button>
						<button class="z-tab" data-tab="artifacts">Artifacts <span class="z-badge z-badge-muted">7</span></button>
						<button class="z-tab" data-tab="diff">Diff</button>
						<button class="z-tab" data-tab="context">Context</button>
					</div>

					<div data-tab-panel="plan">
						<div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:16px;padding:12px;border:1px solid var(--border);border-radius:6px;background:#0d0d0f">
							<span class="z-list-icon" style="width:30px;height:30px;color:#c7b3ff;border-color:rgba(182,156,255,.25);background:rgba(182,156,255,.08)">@Icon("sparkles", "")</span>
							<div style="flex:1">
								<div style="font-size:12px;color:var(--text);font-weight:550">Order management API</div>
								<div class="z-help" style="margin-top:3px">Postgres-backed CRUD for customers and orders, a <span class="z-code-inline">order.created</span> event, and per-tenant rate limiting. Uses existing Go runtime and project git repository.</div>
							</div>
							<span class="z-badge z-badge-blue">go</span>
						</div>

						<div class="z-timeline">
							<div class="z-timeline-step done">
								<div class="z-timeline-dot"></div>
								<div style="display:flex;align-items:center;gap:7px"><span class="z-list-title">Inspect project context</span><span class="z-badge z-badge-green">done</span></div>
								<div class="z-list-sub" style="margin-top:3px">Read go.mod, existing endpoints and schema conventions.</div>
								<div style="display:flex;gap:5px;margin-top:6px"><span class="z-badge">repo</span><span class="z-badge">5 functions</span><span class="z-badge">schema</span></div>
							</div>
							<div class="z-timeline-step running">
								<div class="z-timeline-dot"></div>
								<div style="display:flex;align-items:center;gap:7px"><span class="z-list-title">Create data model & migrations</span><span class="z-badge z-badge-blue">draft</span></div>
								<div class="z-list-sub" style="margin-top:3px">customers, orders, order_items + indexes and sqlc queries.</div>
								<div style="display:flex;gap:5px;margin-top:6px"><span class="z-badge">3 tables</span><span class="z-badge">1 migration</span><span class="z-badge">sqlc</span></div>
							</div>
							<div class="z-timeline-step">
								<div class="z-timeline-dot"></div>
								<div style="display:flex;align-items:center;gap:7px"><span class="z-list-title">Generate functions & endpoints</span><span class="z-badge z-badge-muted">queued</span></div>
								<div class="z-list-sub" style="margin-top:3px">CreateOrder, ListOrders, GetOrder with typed JSON handlers.</div>
								<div style="display:flex;gap:5px;margin-top:6px"><span class="z-badge">3 functions</span><span class="z-badge">3 routes</span></div>
							</div>
							<div class="z-timeline-step">
								<div class="z-timeline-dot"></div>
								<div style="display:flex;align-items:center;gap:7px"><span class="z-list-title">Wire events & traffic policy</span><span class="z-badge z-badge-muted">queued</span></div>
								<div class="z-list-sub" style="margin-top:3px">order.created stream and 120 req/min per API key.</div>
								<div style="display:flex;gap:5px;margin-top:6px"><span class="z-badge">1 stream</span><span class="z-badge">1 policy</span></div>
							</div>
						</div>
					</div>

					<div data-tab-panel="artifacts" style="display:none">
						<div class="z-list" style="border:1px solid var(--border);border-radius:6px;overflow:hidden">
							@artifactRow("functions/orders/create.go", "Go function", "new", "blue")
							@artifactRow("functions/orders/list.go", "Go function", "new", "blue")
							@artifactRow("migrations/00004_orders.sql", "Migration", "new", "purple")
							@artifactRow("db/queries/orders.sql", "sqlc query", "new", "purple")
							@artifactRow("endpoints/orders.yaml", "Gateway route", "modified", "amber")
							@artifactRow("pubsub/order-created.yaml", "Stream", "new", "cyan")
							@artifactRow("traffic/orders-policy.yaml", "Rate policy", "new", "green")
						</div>
					</div>

					<div data-tab-panel="diff" style="display:none">
						<div class="z-code-editor">
							<div class="z-code-lines">
								for i := range lines(agentExampleCode()) {
									<span>{ itoa(i + 1) }</span>
								}
							</div>
							<pre class="z-code-body" style="max-height:360px">{ agentExampleCode() }</pre>
						</div>
					</div>

					<div data-tab-panel="context" style="display:none">
						<div class="z-grid z-grid-2">
							<div class="z-panel"><div class="z-panel-body"><div class="z-label">Repository</div><div class="z-mono" style="font-size:11px;margin-top:6px">acme/orders</div><div class="z-help" style="margin-top:4px">branch main · clean working tree</div></div></div>
							<div class="z-panel"><div class="z-panel-body"><div class="z-label">Runtime</div><div class="z-mono" style="font-size:11px;margin-top:6px">go 1.26 · linux/amd64</div><div class="z-help" style="margin-top:4px">image sha-77b0e1</div></div></div>
							<div class="z-panel"><div class="z-panel-body"><div class="z-label">Existing schema</div><div class="z-mono" style="font-size:11px;margin-top:6px">3 tables</div><div class="z-help" style="margin-top:4px">users, sessions, orders</div></div></div>
							<div class="z-panel"><div class="z-panel-body"><div class="z-label">Conventions</div><div class="z-mono" style="font-size:11px;margin-top:6px">sqlc + gin</div><div class="z-help" style="margin-top:4px">from .agent/context.md</div></div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="z-panel" style="margin-top:14px">
				<div class="z-panel-header"><span class="z-panel-title">Conversation</span><span class="z-badge z-badge-muted">draft</span></div>
				<div class="z-panel-body" style="display:flex;flex-direction:column;gap:10px">
					<div style="display:flex;gap:9px">
						<span class="z-user-avatar" style="width:24px;height:24px">A</span>
						<div style="flex:1;background:rgba(255,255,255,.025);border:1px solid var(--border);border-radius:6px;padding:9px 11px;font-size:11.5px;color:var(--text-2);line-height:1.6">Build an order management API. Keep the existing Go/Gin conventions and use Postgres. Publish an event when an order is paid and rate limit per API key.</div>
					</div>
					<div style="display:flex;gap:9px">
						<span class="z-user-avatar" style="width:24px;height:24px;background:rgba(182,156,255,.16);border-color:rgba(182,156,255,.35);color:#d8c9ff">AI</span>
						<div style="flex:1;background:rgba(182,156,255,.045);border:1px solid rgba(182,156,255,.16);border-radius:6px;padding:9px 11px;font-size:11.5px;color:var(--text-2);line-height:1.6">I found an existing <span class="z-code-inline">orders</span> table convention and a Go runtime. My plan adds customers and order_items, three handlers, one stream, and a per-key rate policy. I left the existing user schema untouched.</div>
					</div>
					<div class="z-input-group">
						<input class="z-input" placeholder="Refine the plan…" onkeydown="if(event.key==='Enter'){toast('Follow-up prompts are a placeholder','info')}"/>
						<button class="z-btn z-btn-primary">@Icon("arrow-right", "")</button>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script>
		function usePrompt(text) {
			document.getElementById("agent-prompt").value = text;
			document.getElementById("agent-prompt").focus();
		}
		function newPlan() {
			document.getElementById("agent-prompt").value = "";
			document.getElementById("plan-status").textContent = "draft";
			document.getElementById("plan-status").className = "z-badge z-badge-amber";
			toast("New plan draft", "info");
		}
		async function generatePlan() {
			const prompt = document.getElementById("agent-prompt").value.trim();
			if (!prompt) { toast("Describe a use case first", "info"); document.getElementById("agent-prompt").focus(); return; }
			const btn = document.getElementById("agent-generate");
			const status = document.getElementById("plan-status");
			btn.disabled = true;
			status.textContent = "generating";
			status.className = "z-badge z-badge-blue";
			toast("Planning artifacts…", "info");
			await zDummyFetch("/api/agent/plan/", {ok: true});
			setTimeout(() => {
				btn.disabled = false;
				status.textContent = "ready";
				status.className = "z-badge z-badge-green";
				document.getElementById("plan-meta").textContent = "4 steps · 7 artifacts · est. 3 min";
				toast("Plan ready for review", "success");
			}, 1100);
		}
		document.addEventListener("keydown", e => {
			if ((e.metaKey || e.ctrlKey) && e.key === "Enter") { e.preventDefault(); generatePlan(); }
		});
	</script>
}

templ scopeToggle(label string, detail string, on bool) {
	<div style="display:flex;align-items:center;gap:9px;padding:6px 0">
		<span class={ "z-toggle", templ.KV("on", on) }></span>
		<div>
			<div style="font-size:11px;color:var(--text-2)">{ label }</div>
			<div class="z-help" style="font-size:9.5px">{ detail }</div>
		</div>
	</div>
}

templ artifactRow(path string, kind string, change string, tone string) {
	<div class="z-list-item">
		<span class="z-list-icon">@Icon("file", "")</span>
		<div class="z-list-main">
			<div class="z-list-title z-mono" style="font-size:10.5px">{ path }</div>
			<div class="z-list-sub">{ kind }</div>
		</div>
		<span class={ "z-badge", templ.KV("z-badge-green", tone == "green"), templ.KV("z-badge-blue", tone == "blue"), templ.KV("z-badge-purple", tone == "purple"), templ.KV("z-badge-amber", tone == "amber"), templ.KV("z-badge-cyan", tone == "cyan") }>{ change }</span>
		<button class="z-icon-btn">@Icon("chevron-right", "")</button>
	</div>
}
