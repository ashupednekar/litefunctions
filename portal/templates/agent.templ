package templates

templ AgentContent() {
	@PageHead("Agent", "Describe a use case. The agent writes functions, routes, streaming handlers, and async workers into this project through the LiteFunctions MCP server.", "Build", templ.Raw(`
		<button class="z-btn" onclick="newPlan()">`+svgClock()+` New session</button>
		<button class="z-btn z-btn-primary" onclick="generatePlan()">`+svgPlus()+` Build something</button>
	`))

	<div class="z-alert z-alert-blue" style="margin-bottom:14px">
		@Icon("sparkles", "")
		<div><strong style="color:var(--text);font-weight:550">Live agent.</strong> Changes are committed to the project repo and synced back after every turn. Databases, persistent streams, object storage, and traffic policies are not supported yet.</div>
	</div>

	<div class="z-agent-layout">
		<div>
			<div class="z-panel">
				<div class="z-panel-header">
					<span class="z-panel-title">Use case</span>
					<span class="z-badge z-badge-purple">agent</span>
				</div>
				<div class="z-panel-body">
					<div class="z-composer">
						<textarea id="agent-prompt" placeholder="e.g. Build an order API with a POST endpoint, a GET status route, a WebSocket echo function, and an async worker that records new orders…"></textarea>
						<div class="z-composer-bar">
							<span class="z-badge z-badge-muted">@Icon("file", "") project repo</span>
							<span class="z-badge z-badge-muted">@Icon("network", "") MCP tools</span>
							<span class="z-badge z-badge-muted">@Icon("bolt", "") git commit</span>
							<span style="margin-left:auto" class="z-mono z-faint">⌘↵</span>
						</div>
					</div>
					<div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:10px">
						<button class="z-chip-btn" onclick="usePrompt('Build a Go health endpoint')">Health endpoint</button>
						<button class="z-chip-btn" onclick="usePrompt('Create an async worker that reacts to new orders and logs the payload')">Async worker</button>
						<button class="z-chip-btn" onclick="usePrompt('Add a WebSocket echo function that returns the current server time')">WebSocket echo</button>
						<button class="z-chip-btn" onclick="usePrompt('Add a Python API with a POST /items route and a GET /items/{id} route')">Python API</button>
					</div>

					<div class="z-divider"></div>

					<div style="display:flex;flex-direction:column;gap:9px">
						<div style="display:flex;align-items:center;justify-content:space-between">
							<span style="font-size:11px;color:var(--text-2)">Language</span>
							<select id="agent-language" class="z-select" style="width:190px;height:26px;font-size:10.5px">
								<option value="">let the agent choose</option>
								<option value="go">go</option>
								<option value="python">python</option>
								<option value="ts">typescript</option>
								<option value="rust">rust</option>
								<option value="lua">lua</option>
							</select>
						</div>
						<div style="display:flex;align-items:center;justify-content:space-between">
							<span style="font-size:11px;color:var(--text-2)">Surface</span>
							<select id="agent-surface" class="z-select" style="width:190px;height:26px;font-size:10.5px">
								<option value="">let the agent choose</option>
								<option value="http">sync HTTP</option>
								<option value="async">async worker</option>
								<option value="ws">WebSocket</option>
								<option value="sse">SSE</option>
							</select>
						</div>
					</div>

					<button id="agent-generate" class="z-btn z-btn-primary" style="width:100%;height:34px;margin-top:14px" onclick="generatePlan()">
						@Icon("sparkles", "")
						Send to agent
						<span style="margin-left:auto" class="z-kbd">⌘↵</span>
					</button>
					<div class="z-help" style="text-align:center;margin-top:8px">Nothing is written until the agent calls the project tools.</div>
				</div>
			</div>

			<div class="z-panel" style="margin-top:14px">
				<div class="z-panel-header"><span class="z-panel-title">Capabilities</span></div>
				<div class="z-panel-body" style="display:flex;flex-direction:column;gap:9px">
					<div style="display:flex;gap:9px;align-items:flex-start">
						<span class="z-dot z-dot-green" style="margin-top:4px"></span>
						<div><div style="font-size:11px;color:var(--text-2)">HTTP functions</div><div class="z-help">Go, Python, TypeScript, Rust, Lua</div></div>
					</div>
					<div style="display:flex;gap:9px;align-items:flex-start">
						<span class="z-dot z-dot-green" style="margin-top:4px"></span>
						<div><div style="font-size:11px;color:var(--text-2)">Streaming</div><div class="z-help">WebSocket and server-sent events</div></div>
					</div>
					<div style="display:flex;gap:9px;align-items:flex-start">
						<span class="z-dot z-dot-green" style="margin-top:4px"></span>
						<div><div style="font-size:11px;color:var(--text-2)">Async workers</div><div class="z-help">NATS-backed functions invoked through their async endpoint</div></div>
					</div>
					<div class="z-divider"></div>
					<div style="display:flex;gap:9px;align-items:flex-start">
						<span class="z-dot z-dot-amber" style="margin-top:4px"></span>
						<div><div style="font-size:11px;color:var(--text-2)">Not yet</div><div class="z-help">Databases, persistent streams, object storage, traffic policies, scheduled jobs</div></div>
					</div>
				</div>
			</div>
		</div>

		<div>
			<div class="z-panel" style="min-height:520px;display:flex;flex-direction:column">
				<div class="z-panel-header">
					<span class="z-panel-title">Conversation</span>
					<span id="agent-conversation-status" class="z-badge z-badge-muted">ready</span>
					<span class="z-panel-sub">project repo · live</span>
					<div class="z-panel-actions">
						<button class="z-btn z-btn-sm" onclick="newPlan()">@Icon("refresh", "") Reset</button>
					</div>
				</div>
				<div id="agent-conversation" class="z-panel-body" style="flex:1;display:flex;flex-direction:column;gap:12px;min-height:380px;max-height:560px;overflow-y:auto">
					<div style="display:flex;gap:9px">
						<span class="z-user-avatar" style="width:24px;height:24px;background:rgba(182,156,255,.16);border-color:rgba(182,156,255,.35);color:#d8c9ff">AI</span>
						<div style="flex:1;background:rgba(182,156,255,.045);border:1px solid rgba(182,156,255,.16);border-radius:6px;padding:9px 11px;font-size:11.5px;color:var(--text-2);line-height:1.6">Describe what you want to build. I will inspect the project, create the function packages, add routes, and commit everything to your repo.</div>
					</div>
					<div class="z-help" id="agent-conversation-empty">No messages yet. Try one of the suggestions or write your own prompt.</div>
				</div>
				<div class="z-panel-body" style="border-top:1px solid var(--border);padding-top:10px">
					<div class="z-input-group">
						<input id="agent-followup" class="z-input" placeholder="Refine the result…" onkeydown="if(event.key==='Enter'){agentPagePrompt(this.value); this.value=''}"/>
						<button class="z-btn z-btn-primary" onclick="agentPagePrompt(document.getElementById('agent-followup').value); document.getElementById('agent-followup').value=''">@Icon("arrow-right", "")</button>
					</div>
					<div class="z-help" style="margin-top:8px">The agent can say “not supported yet” for databases and persistent streams.</div>
				</div>
			</div>
		</div>
	</div>

	<script>
		function agentSessionKey() {
			const dock = document.getElementById("agent-dock");
			return "lws_agent_session:" + ((dock && dock.dataset.agentProject) || "project");
		}

		function usePrompt(text) {
			document.getElementById("agent-prompt").value = text;
			document.getElementById("agent-prompt").focus();
		}

		function newPlan() {
			document.getElementById("agent-prompt").value = "";
			try { localStorage.removeItem(agentSessionKey()); } catch (err) { /* ignore */ }
			const conversation = document.getElementById("agent-conversation");
			conversation.innerHTML = "";
			const intro = document.createElement("div");
			intro.style.cssText = "display:flex;gap:9px";
			intro.innerHTML = '<span class="z-user-avatar" style="width:24px;height:24px;background:rgba(182,156,255,.16);border-color:rgba(182,156,255,.35);color:#d8c9ff">AI</span><div style="flex:1;background:rgba(182,156,255,.045);border:1px solid rgba(182,156,255,.16);border-radius:6px;padding:9px 11px;font-size:11.5px;color:var(--text-2);line-height:1.6">Describe what you want to build. I will inspect the project, create the function packages, add routes, and commit everything to your repo.</div>';
			conversation.appendChild(intro);
			const empty = document.createElement("div");
			empty.className = "z-help";
			empty.id = "agent-conversation-empty";
			empty.textContent = "No messages yet. Try one of the suggestions or write your own prompt.";
			conversation.appendChild(empty);
			document.getElementById("agent-conversation-status").textContent = "ready";
			document.getElementById("agent-conversation-status").className = "z-badge z-badge-muted";
			toast("New agent session", "info");
		}

		function appendAgentMessage(role, text) {
			const conversation = document.getElementById("agent-conversation");
			document.getElementById("agent-conversation-empty")?.remove();
			const row = document.createElement("div");
			row.style.display = "flex";
			row.style.gap = "9px";
			const avatar = document.createElement("span");
			avatar.className = "z-user-avatar";
			avatar.style.width = "24px";
			avatar.style.height = "24px";
			avatar.textContent = role === "assistant" ? "AI" : "You";
			if (role === "assistant") {
				avatar.style.background = "rgba(182,156,255,.16)";
				avatar.style.borderColor = "rgba(182,156,255,.35)";
				avatar.style.color = "#d8c9ff";
			}
			const body = document.createElement("div");
			body.style.cssText = "flex:1;border:1px solid var(--border);border-radius:6px;padding:9px 11px;font-size:11.5px;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere;background:rgba(255,255,255,.025);color:var(--text-2)";
			body.textContent = text;
			row.appendChild(avatar);
			row.appendChild(body);
			conversation.appendChild(row);
			conversation.scrollTop = conversation.scrollHeight;
			return body;
		}

		async function agentPagePrompt(text) {
			const prompt = (text || "").trim();
			if (!prompt) { toast("Describe a use case first", "info"); return; }
			const language = document.getElementById("agent-language").value;
			const surface = document.getElementById("agent-surface").value;
			let finalPrompt = prompt;
			if (language || surface) {
				finalPrompt += "\n\nPreferred language: " + (language || "any") + ". Preferred surface: " + (surface || "any") + ".";
			}
			const btn = document.getElementById("agent-generate");
			const convStatus = document.getElementById("agent-conversation-status");
			btn.disabled = true;
			convStatus.textContent = "working";
			convStatus.className = "z-badge z-badge-blue";
			appendAgentMessage("user", finalPrompt);
			const pending = appendAgentMessage("assistant", "Thinking…");
			pending.style.color = "var(--text-4)";
			pending.style.fontStyle = "italic";
			try {
				let session = "";
				try { session = localStorage.getItem(agentSessionKey()) || ""; } catch (err) { /* ignore */ }
				const res = await fetch("/api/agent/prompt/", {
					method: "POST",
					headers: { "Content-Type": "application/json", Accept: "application/json" },
					body: JSON.stringify({ prompt: finalPrompt, session_id: session })
				});
				const data = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(data.error || ("HTTP " + res.status));
				if (data.session_id) {
					try { localStorage.setItem(agentSessionKey(), data.session_id); } catch (err) { /* ignore */ }
				}
				pending.style.color = "";
				pending.style.fontStyle = "";
				pending.textContent = data.text || "(the agent returned an empty response)";
				if (data.sync_error) appendAgentMessage("assistant", "Sync warning: " + data.sync_error);
				convStatus.textContent = "ready";
				convStatus.className = "z-badge z-badge-green";
				toast("Agent finished", "success");
			} catch (err) {
				pending.style.color = "var(--red)";
				pending.style.fontStyle = "";
				pending.textContent = err.message || "The agent request failed.";
				convStatus.textContent = "error";
				convStatus.className = "z-badge z-badge-amber";
			} finally {
				btn.disabled = false;
			}
		}

		async function generatePlan() {
			await agentPagePrompt(document.getElementById("agent-prompt").value);
		}

		document.addEventListener("keydown", e => {
			if ((e.metaKey || e.ctrlKey) && e.key === "Enter") { e.preventDefault(); generatePlan(); }
		});
	</script>
}
