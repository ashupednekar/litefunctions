package templates

templ PageHead(title string, subtitle string, eyebrow string, actions templ.Component) {
	<div class="z-page-head">
		<div class="z-page-head-main">
			if eyebrow != "" {
				<div class="z-page-eyebrow">
					<span class="z-dot z-dot-blue"></span>
					{ eyebrow }
				</div>
			}
			<h1 class="z-page-title">{ title }</h1>
			if subtitle != "" {
				<p class="z-page-sub">{ subtitle }</p>
			}
		</div>
		if actions != nil {
			<div class="z-page-actions">
				@actions
			</div>
		}
	</div>
}

templ Icon(name string, class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "grid":
				<rect x="3" y="3" width="7" height="7" rx="1"></rect>
				<rect x="14" y="3" width="7" height="7" rx="1"></rect>
				<rect x="3" y="14" width="7" height="7" rx="1"></rect>
				<rect x="14" y="14" width="7" height="7" rx="1"></rect>
			case "code":
				<path d="m8 6-6 6 6 6"></path>
				<path d="m16 6 6 6-6 6"></path>
			case "route":
				<circle cx="6" cy="19" r="3"></circle>
				<path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path>
				<circle cx="18" cy="5" r="3"></circle>
			case "package":
				<path d="m7.5 4.27 9 5.15"></path>
				<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
				<path d="m3.3 7 8.7 5 8.7-5"></path>
				<path d="M12 22V12"></path>
			case "database":
				<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
				<path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
				<path d="M3 12a9 3 0 0 0 18 0"></path>
			case "sparkles":
				<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"></path>
				<path d="M5 3v4M3 5h4M19 17v4M17 19h4"></path>
			case "layers":
				<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path>
				<path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path>
				<path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path>
			case "network":
				<rect x="16" y="16" width="6" height="6" rx="1"></rect>
				<rect x="2" y="16" width="6" height="6" rx="1"></rect>
				<rect x="9" y="2" width="6" height="6" rx="1"></rect>
				<path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"></path>
				<path d="M12 12V8"></path>
			case "shield":
				<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z"></path>
			case "cpu":
				<rect x="4" y="4" width="16" height="16" rx="2"></rect>
				<rect x="9" y="9" width="6" height="6"></rect>
				<path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"></path>
			case "activity":
				<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
			case "rocket":
				<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
				<path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
				<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
				<path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
			case "key":
				<circle cx="7.5" cy="15.5" r="5.5"></circle>
				<path d="m21 2-9.6 9.6M15.5 7.5l3 3L22 7l-3-3"></path>
			case "users":
				<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
				<circle cx="9" cy="7" r="4"></circle>
				<path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
			case "clock":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 6v6l4 2"></path>
			case "search":
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m21 21-4.35-4.35"></path>
			case "chevron-down":
				<path d="m6 9 6 6 6-6"></path>
			case "chevron-right":
				<path d="m9 18 6-6-6-6"></path>
			case "chevron-left":
				<path d="m15 18-6-6 6-6"></path>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "play":
				<path d="m6 3 14 9-14 9V3z"></path>
			case "refresh":
				<path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
				<path d="M21 3v5h-5"></path>
				<path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
				<path d="M3 21v-5h5"></path>
			case "external":
				<path d="M15 3h6v6"></path>
				<path d="M10 14 21 3"></path>
				<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
			case "filter":
				<path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"></path>
			case "check":
				<path d="M20 6 9 17l-5-5"></path>
			case "alert":
				<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
				<path d="M12 9v4M12 17h.01"></path>
			case "arrow-right":
				<path d="M5 12h14M12 5l7 7-7 7"></path>
			case "git-branch":
				<line x1="6" x2="6" y1="3" y2="15"></line>
				<circle cx="18" cy="6" r="3"></circle>
				<circle cx="6" cy="18" r="3"></circle>
				<path d="M18 9a9 9 0 0 1-9 9"></path>
			case "terminal":
				<path d="m4 17 6-6-6-6"></path>
				<path d="M12 19h8"></path>
			case "lock":
				<rect x="3" y="11" width="18" height="11" rx="2"></rect>
				<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
			case "eye":
				<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"></path>
				<circle cx="12" cy="12" r="3"></circle>
			case "copy":
				<rect x="9" y="9" width="13" height="13" rx="2"></rect>
				<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
			case "trash":
				<path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
			case "edit":
				<path d="M12 20h9"></path>
				<path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
			case "save":
				<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
				<path d="M17 21v-8H7v8M7 3v5h8"></path>
			case "close":
				<path d="M18 6 6 18M6 6l12 12"></path>
			case "bolt":
				<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
			case "globe":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
			case "github":
				<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
				<path d="M9 18c-4.51 2-5-2-7-2"></path>
			case "file":
				<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
				<path d="M14 2v6h6"></path>
			case "braces":
				<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1"></path>
				<path d="M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1"></path>
			case "table":
				<rect x="3" y="3" width="18" height="18" rx="2"></rect>
				<path d="M3 9h18M3 15h18M9 3v18"></path>
			case "sliders":
				<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"></path>
			case "box":
				<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
				<path d="m3.3 7 8.7 5 8.7-5M12 22V12"></path>
			case "cloud":
				<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
			case "gauge":
				<path d="m12 14 4-4"></path>
				<path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
			case "book":
				<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
				<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
			case "more":
				<circle cx="12" cy="12" r="1"></circle>
				<circle cx="19" cy="12" r="1"></circle>
				<circle cx="5" cy="12" r="1"></circle>
			default:
				<circle cx="12" cy="12" r="9"></circle>
		}
	</svg>
}

templ NavItem(href string, label string, icon string, active bool, badge string) {
	<a href={ templ.SafeURL(href) } class={ "z-nav-item", templ.KV("active", active) } title={ label }>
		@Icon(icon, "")
		<span>{ label }</span>
		if badge != "" {
			<span class="z-nav-badge">{ badge }</span>
		}
	</a>
}

templ PageActions(actions templ.Component) {
	<div class="z-page-actions">
		@actions
	</div>
}
