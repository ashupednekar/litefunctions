package templates

templ DeploymentsContent() {
	@PageHead("Deployments", "Environments, releases and rollout state. Every deploy is tied to a Git SHA and a reviewed artifact set.", "Operate", templ.Raw(`
		<button class="z-btn" onclick="toast('Rollback dialog is a placeholder','info')">`+svgClock()+` Rollback</button>
		<button class="z-btn z-btn-primary" onclick="zOpenModal('deploy-modal')">`+svgPlus()+` New release</button>
	`))

	<div class="z-grid z-grid-4" style="margin-bottom:14px">
		<div class="z-stat"><div class="z-stat-label">@Icon("cloud", "") Environments</div><div class="z-stat-value">3</div><div class="z-stat-delta">production <span class="z-faint">·</span> staging <span class="z-faint">·</span> preview</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("rocket", "") Current release</div><div class="z-stat-value" style="font-size:18px">v0.14.2</div><div class="z-stat-delta z-mono">sha 77b0e1 · 18m ago</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("git-branch", "") Commits ahead</div><div class="z-stat-value">3</div><div class="z-stat-delta">staging is 3 ahead of production</div></div>
		<div class="z-stat"><div class="z-stat-label">@Icon("check", "") Rollout</div><div class="z-stat-value" style="color:var(--green)">100<small>%</small></div><div class="z-stat-delta">healthy <span class="z-faint">·</span> 0 failed pods</div></div>
	</div>

	<div class="z-tabs" data-tab-group>
		<button class="z-tab active" data-tab="releases">Releases</button>
		<button class="z-tab" data-tab="environments">Environments</button>
		<button class="z-tab" data-tab="artifacts">Artifacts</button>
		<button class="z-tab" data-tab="gates">Approval gates</button>
	</div>

	<div data-tab-panel="releases">
		<div class="z-panel">
			<div class="z-panel-header"><span class="z-panel-title">Release history</span><span class="z-panel-sub">production</span><div class="z-panel-actions"><button class="z-btn z-btn-sm">@Icon("filter", "") Filter</button></div></div>
			<div class="z-table-wrap">
				<table class="z-table">
					<thead><tr><th>Release</th><th>Environment</th><th>Commit</th><th>Changes</th><th>Deployed by</th><th>When</th><th>Status</th><th></th></tr></thead>
					<tbody>
						@releaseRow("v0.14.2", "production", "77b0e1", "3 functions · 1 route", "ashu", "18m ago", "live")
						@releaseRow("v0.14.1", "production", "a112fe", "1 function · 2 fixes", "ashu", "1d ago", "superseded")
						@releaseRow("v0.15.0-rc1", "staging", "c401da", "5 functions · schema", "ci", "6m ago", "canary 25%")
						@releaseRow("v0.14.0", "production", "90bc22", "initial orders API", "ashu", "6d ago", "superseded")
						@releaseRow("v0.15.0-rc1", "preview", "c401da", "5 functions · schema", "ci", "6m ago", "live")
					</tbody>
				</table>
			</div>
			<div class="z-panel-foot"><span class="z-help">Deploys are Git-driven. The portal only records release state and approvals.</span><span class="z-badge z-badge-green" style="margin-left:auto">rollout healthy</span></div>
		</div>

		<div class="z-grid z-grid-2" style="margin-top:14px">
			<div class="z-panel">
				<div class="z-panel-header"><span class="z-panel-title">Rollout · v0.15.0-rc1</span><span class="z-badge z-badge-blue" style="margin-left:auto">canary</span></div>
				<div class="z-panel-body">
					<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px"><span class="z-help">Canary traffic</span><span class="z-mono" style="font-size:10px">25%</span></div>
					<div class="z-progress"><span style="width:25%"></span></div>
					<div class="z-divider"></div>
					<dl class="z-kv">
						<dt>Stable</dt><dd>v0.14.2 · 3 replicas</dd>
						<dt>Canary</dt><dd>v0.15.0-rc1 · 1 replica</dd>
						<dt>Error delta</dt><dd style="color:var(--green)">-0.01%</dd>
						<dt>Latency delta</dt><dd style="color:var(--green)">-4ms p95</dd>
					</dl>
					<button class="z-btn z-btn-primary" style="width:100%;margin-top:12px" onclick="toast('Promotion is a placeholder','success')">Promote to 100%</button>
				</div>
			</div>
			<div class="z-panel">
				<div class="z-panel-header"><span class="z-panel-title">Deploy diff</span><span class="z-panel-sub">v0.14.2 → v0.15.0-rc1</span></div>
				<div class="z-panel-body tight">
					<div class="z-list">
						<div class="z-list-item"><span class="z-list-icon tone-green">@Icon("plus", "")</span><div class="z-list-main"><div class="z-list-title z-mono" style="font-size:10.5px">functions/orders/refund.go</div><div class="z-list-sub">new function</div></div><span class="z-badge z-badge-green">add</span></div>
						<div class="z-list-item"><span class="z-list-icon tone-blue">@Icon("edit", "")</span><div class="z-list-main"><div class="z-list-title z-mono" style="font-size:10.5px">functions/orders/create.go</div><div class="z-list-sub">validation + telemetry</div></div><span class="z-badge z-badge-blue">modify</span></div>
						<div class="z-list-item"><span class="z-list-icon tone-purple">@Icon("table", "")</span><div class="z-list-main"><div class="z-list-title z-mono" style="font-size:10.5px">migrations/00005_refunds.sql</div><div class="z-list-sub">new table + index</div></div><span class="z-badge z-badge-purple">migration</span></div>
						<div class="z-list-item"><span class="z-list-icon">@Icon("shield", "")</span><div class="z-list-main"><div class="z-list-title z-mono" style="font-size:10.5px">traffic/refund-policy.yaml</div><div class="z-list-sub">30 req/min per key</div></div><span class="z-badge z-badge-green">add</span></div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div data-tab-panel="environments" style="display:none">
		<div class="z-grid z-grid-3">
			@envCard("production", "v0.14.2", "77b0e1", "healthy", "green", "3 replicas", "https://litefunctions.portal")
			@envCard("staging", "v0.15.0-rc1", "c401da", "canary", "blue", "2 replicas", "https://staging.litefunctions.portal")
			@envCard("preview", "v0.15.0-rc1", "c401da", "ephemeral", "amber", "1 replica", "https://pr-142.preview.litefunctions.portal")
		</div>
	</div>

	<div data-tab-panel="artifacts" style="display:none">
		<div class="z-panel">
			<div class="z-panel-header"><span class="z-panel-title">Build artifacts</span><span class="z-panel-sub">OCI images by runtime</span></div>
			<div class="z-table-wrap">
				<table class="z-table">
					<thead><tr><th>Runtime</th><th>Image</th><th>Digest</th><th>Size</th><th>Built</th><th>Status</th></tr></thead>
					<tbody>
						<tr><td class="z-cell-main">go</td><td class="z-cell-mono">registry/orders-go:v0.15.0-rc1</td><td class="z-cell-mono">sha256:77b0e1…</td><td class="z-cell-mono">18 MB</td><td class="z-cell-mono">6m ago</td><td><span class="z-badge z-badge-green">pushed</span></td></tr>
						<tr><td class="z-cell-main">python</td><td class="z-cell-mono">registry/orders-py:v0.15.0-rc1</td><td class="z-cell-mono">sha256:1f2a9c…</td><td class="z-cell-mono">64 MB</td><td class="z-cell-mono">6m ago</td><td><span class="z-badge z-badge-green">pushed</span></td></tr>
						<tr><td class="z-cell-main">ts</td><td class="z-cell-mono">registry/orders-ts:v0.15.0-rc1</td><td class="z-cell-mono">sha256:c401da…</td><td class="z-cell-mono">42 MB</td><td class="z-cell-mono">6m ago</td><td><span class="z-badge z-badge-green">pushed</span></td></tr>
					</tbody>
				</table>
			</div>
			<div class="z-panel-foot"><span class="z-help">SBOM and provenance attestations are attached to each image.</span></div>
		</div>
	</div>

	<div data-tab-panel="gates" style="display:none">
		<div class="z-panel">
			<div class="z-panel-header"><span class="z-panel-title">Approval gates</span><span class="z-badge z-badge-muted" style="margin-left:auto">production</span></div>
			<div class="z-panel-body" style="display:flex;flex-direction:column;gap:2px">
				@gateRow("Required reviewers", "1 owner approval", "passed", true)
				@gateRow("Tests", "unit + integration", "passed", true)
				@gateRow("Migration review", "manual sign-off", "passed", true)
				@gateRow("Vulnerability scan", "no high/critical", "passed", true)
				@gateRow("Canary analysis", "error delta &lt; 0.1%", "running", false)
			</div>
			<div class="z-panel-foot"><span class="z-help">Gates are evaluated by the operator before promotion.</span><button class="z-btn z-btn-sm z-btn-accent" style="margin-left:auto" onclick="toast('Gate configuration is a placeholder','info')">Configure</button></div>
		</div>
	</div>

	<div id="deploy-modal" class="z-modal-backdrop" onclick="zCloseModal('deploy-modal')">
		<div class="z-modal" onclick="event.stopPropagation()">
			<div class="z-modal-header">@Icon("rocket", "w-4 h-4")<span class="z-modal-title">New release</span><button class="z-icon-btn" style="margin-left:auto" data-close-modal>@Icon("close", "")</button></div>
			<div class="z-modal-body">
				<div class="z-field"><label class="z-label">Environment</label><select class="z-select"><option>staging</option><option>production</option><option>preview</option></select></div>
				<div class="z-field" style="margin-top:11px"><label class="z-label">Git ref</label><input class="z-input z-mono" value="main"/></div>
				<div class="z-field" style="margin-top:11px"><label class="z-label">Strategy</label><select class="z-select"><option>Canary (25% → 100%)</option><option>Rolling</option><option>Recreate</option></select></div>
				<div class="z-alert z-alert-blue" style="margin-top:12px">@Icon("git-branch", "") <div>The operator builds from the ref and reconciles workloads. No builds run from this page.</div></div>
			</div>
			<div class="z-modal-foot"><button class="z-btn" data-close-modal>Cancel</button><button class="z-btn z-btn-primary" onclick="zCloseModal('deploy-modal'); toast('Release queued (placeholder)','success')">Start release</button></div>
		</div>
	</div>
}

templ releaseRow(version string, env string, sha string, changes string, by string, when string, status string) {
	<tr>
		<td class="z-cell-main z-mono" style="font-size:10.5px">{ version }</td>
		<td><span class={ "z-badge", templ.KV("z-badge-green", env == "production"), templ.KV("z-badge-blue", env == "staging"), templ.KV("z-badge-amber", env == "preview") }>{ env }</span></td>
		<td class="z-cell-mono">{ sha }</td>
		<td class="z-cell-mono">{ changes }</td>
		<td class="z-cell-mono">{ by }</td>
		<td class="z-cell-mono">{ when }</td>
		<td><span class={ "z-badge", templ.KV("z-badge-green", status == "live"), templ.KV("z-badge-muted", status == "superseded"), templ.KV("z-badge-blue", status == "canary 25%") }>{ status }</span></td>
		<td class="z-cell-actions"><button class="z-btn z-btn-sm z-btn-ghost">@Icon("more", "")</button></td>
	</tr>
}

templ envCard(name string, version string, sha string, status string, tone string, replicas string, url string) {
	<div class="z-panel" style="margin-top:0">
		<div class="z-panel-header">
			<span class={ "z-dot", templ.KV("z-dot-green", tone == "green"), templ.KV("z-dot-blue", tone == "blue"), templ.KV("z-dot-amber", tone == "amber") }></span>
			<span class="z-panel-title">{ name }</span>
			<span class={ "z-badge", templ.KV("z-badge-green", tone == "green"), templ.KV("z-badge-blue", tone == "blue"), templ.KV("z-badge-amber", tone == "amber") } style="margin-left:auto">{ status }</span>
		</div>
		<div class="z-panel-body">
			<div class="z-mono" style="font-size:15px;color:var(--text)">{ version }</div>
			<div class="z-help z-mono" style="margin-top:3px">{ sha } · { replicas }</div>
			<div class="z-divider"></div>
			<a class="z-mono z-link" style="font-size:10px;word-break:break-all" href={ templ.SafeURL(url) } target="_blank" rel="noopener">{ url }</a>
			<div style="display:flex;gap:6px;margin-top:12px">
				<button class="z-btn z-btn-sm" style="flex:1" onclick="toast('Promotion is a placeholder','success')">Promote</button>
				<button class="z-btn z-btn-sm z-btn-ghost">@Icon("external", "")</button>
			</div>
		</div>
	</div>
}

templ gateRow(name string, detail string, status string, passed bool) {
	<div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)">
		<span class={ "z-dot", templ.KV("z-dot-green", passed), templ.KV("z-dot-blue", !passed) }></span>
		<div style="flex:1">
			<div style="font-size:11.5px;color:var(--text)">{ name }</div>
			<div class="z-help" style="font-size:9.5px">{ detail }</div>
		</div>
		<span class={ "z-badge", templ.KV("z-badge-green", passed), templ.KV("z-badge-blue", !passed) }>{ status }</span>
	</div>
}
