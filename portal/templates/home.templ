package templates

import "fmt"

templ HomeContent(adminLoginEnabled bool) {
	<script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.umd.min.js"></script>
	<script>
		const adminUsername = "litefunctions-system";

		function isAdminLoginEnabled() {
			const form = document.getElementById("login-form");
			return form !== null && form.dataset.adminEnabled === "true";
		}

		function postLoginRedirect() {
			const redirect = new URLSearchParams(window.location.search).get("redirect");
			if (redirect && redirect.startsWith("/") && !redirect.startsWith("//")) { return redirect; }
			return "/dashboard/";
		}

		window.syncLoginMode = function () {
			const username = document.getElementById("username").value.trim();
			const isAdmin = isAdminLoginEnabled() && username === adminUsername;
			const passwordField = document.getElementById("admin-password-field");
			const registerButton = document.getElementById("register-device-button");
			const submitLabel = document.getElementById("login-submit-label");
			const hint = document.getElementById("auth-mode-hint");

			passwordField.style.display = isAdmin ? "" : "none";
			registerButton.style.display = isAdmin ? "none" : "";
			submitLabel.textContent = isAdmin ? "Sign in as admin" : "Continue with passkey";
			hint.textContent = isAdmin
				? "The system admin signs in with the admin password configured by the operator."
				: "Use a passkey stored on this device. No passwords, no resets — the private key never leaves your authenticator.";

			if (isAdmin) { document.getElementById("admin-password").focus(); }
		};

		window.login = async function () {
			const username = document.getElementById("username").value.trim();
			if (!username) { toast("Please enter your username first.", "info"); return; }
			if (username === adminUsername) {
				if (!isAdminLoginEnabled()) { toast("Admin login is disabled.", "error"); return; }
				return loginAdmin();
			}
			return loginPasskey();
		};

		window.loginAdmin = async function () {
			try {
				const username = document.getElementById("username").value.trim();
				const password = document.getElementById("admin-password").value;
				if (!password) { toast("Please enter the admin password.", "info"); return; }

				const resp = await fetch("/admin/login/", {
					method: "POST",
					headers: {"Content-Type": "application/json"},
					body: JSON.stringify({username, password}),
				});
				if (!resp.ok) {
					toast("Login failed: " + await resp.text(), "error");
					return;
				}
				window.location.href = postLoginRedirect();
			} catch (err) {
				console.error(err);
				toast("Login error: " + err, "error");
			}
		};

		document.addEventListener("DOMContentLoaded", syncLoginMode);

		function extractPublicKey(opts) {
			if (opts.publicKey) { return opts.publicKey; }
			if (opts.response) { return opts.response; }
			if (opts.challenge) { return opts; }
			throw new Error("Backend did not return valid WebAuthn publicKey options");
		}

		window.registerPasskey = async function () {
			try {
				const username = document.getElementById("username").value.trim();
				if (!username) { toast("Please enter a username first.", "info"); return; }

				const startResp = await fetch("/passkey/register/start/", {
					method: "POST",
					headers: {"Content-Type": "application/json"},
					body: JSON.stringify({username}),
				});
				if (!startResp.ok) {
					toast("Failed to start registration: " + await startResp.text(), "error");
					return;
				}

				const sessionKey = startResp.headers.get("Session-Key");
				const options = await startResp.json();
				const publicKeyOpts = extractPublicKey(options);
				const attResp = await SimpleWebAuthnBrowser.startRegistration(publicKeyOpts);

				const finishResp = await fetch("/passkey/register/finish/", {
					method: "POST",
					headers: {"Content-Type": "application/json", "Session-Key": sessionKey},
					body: JSON.stringify(attResp),
				});
				if (finishResp.ok) {
					window.location.href = "/dashboard/";
				} else {
					toast("Registration failed: " + await finishResp.text(), "error");
				}
			} catch (err) {
				console.error(err);
				toast("Registration error: " + err, "error");
			}
		};

		window.loginPasskey = async function () {
			try {
				const username = document.getElementById("username").value.trim();
				if (!username) { toast("Please enter your username first.", "info"); return; }

				const startResp = await fetch("/passkey/login/start/", {
					method: "POST",
					headers: {"Content-Type": "application/json"},
					body: JSON.stringify({username}),
				});
				if (!startResp.ok) {
					toast("Failed to start login: " + await startResp.text(), "error");
					return;
				}

				const sessionKey = startResp.headers.get("Session-Key");
				const options = await startResp.json();
				const publicKeyOpts = extractPublicKey(options);
				const assertionResp = await SimpleWebAuthnBrowser.startAuthentication(publicKeyOpts);

				const finishResp = await fetch("/passkey/login/finish/", {
					method: "POST",
					headers: {"Content-Type": "application/json", "Session-Key": sessionKey},
					body: JSON.stringify(assertionResp),
				});
				if (finishResp.ok) {
					window.location.href = postLoginRedirect();
				} else {
					toast("Login failed: " + await finishResp.text(), "error");
				}
			} catch (err) {
				console.error(err);
				toast("Login error: " + err, "error");
			}
		};
	</script>

	<div>
		<div class="z-auth-kicker">Function platform · self-hosted</div>
		<h1 class="z-auth-title">
			Ship functions.<br/>
			<span>Not infrastructure.</span>
		</h1>
		<p class="z-auth-sub">
			A self-hosted function platform for Kubernetes. Write in Go, Rust, Python, TypeScript or Lua —
			we handle routing, async execution, pub/sub, secrets and traffic policy.
		</p>
		<div class="z-auth-chips">
			<span class="z-auth-chip">@Icon("bolt", "") sync + async</span>
			<span class="z-auth-chip">@Icon("network", "") HTTP · SSE · WebSocket</span>
			<span class="z-auth-chip">@Icon("git-branch", "") git-driven deploys</span>
			<span class="z-auth-chip">@Icon("shield", "") per-route policies</span>
			<span class="z-auth-chip">@Icon("package", "") no vendor lock-in</span>
		</div>
		<div class="z-auth-stat-row">
			<div>
				<div class="z-auth-stat-value">5</div>
				<div class="z-auth-stat-label">Runtimes</div>
			</div>
			<div>
				<div class="z-auth-stat-value">0</div>
				<div class="z-auth-stat-label">Cold starts*</div>
			</div>
			<div>
				<div class="z-auth-stat-value">∞</div>
				<div class="z-auth-stat-label">Functions</div>
			</div>
			<div>
				<div class="z-auth-stat-value">MIT</div>
				<div class="z-auth-stat-label">Licensed</div>
			</div>
		</div>
	</div>

	<div class="z-auth-card">
		<div style="display:flex;align-items:center;gap:8px;margin-bottom:2px">
			<span class="z-badge z-badge-blue">@Icon("lock", "") passkey</span>
			<span class="z-badge z-badge-muted">passwordless</span>
		</div>
		<h2>Sign in to your workspace</h2>
		<p id="auth-mode-hint">Use a passkey stored on this device. No passwords, no resets — the private key never leaves your authenticator.</p>
		<form id="login-form" data-admin-enabled={ fmt.Sprint(adminLoginEnabled) } onsubmit="event.preventDefault(); login();">
			<div class="z-field">
				<label class="z-label" for="username">Username</label>
				<input id="username" type="text" class="z-input" placeholder="e.g. ashu" autocomplete="username webauthn" autofocus oninput="syncLoginMode()"/>
			</div>
			<div id="admin-password-field" class="z-field" style="display:none">
				<label class="z-label" for="admin-password">Admin password</label>
				<input id="admin-password" type="password" class="z-input" autocomplete="current-password"/>
			</div>
			<button type="submit" class="z-btn z-btn-primary" style="height:34px;margin-top:2px">
				@Icon("key", "")
				<span id="login-submit-label">Continue with passkey</span>
				@Icon("arrow-right", "")
			</button>
			<div style="display:flex;gap:7px">
				<button id="register-device-button" type="button" onclick="registerPasskey()" class="z-btn" style="flex:1;height:32px">Register device</button>
				<a href="https://github.com/ashupednekar/litefunctions" target="_blank" rel="noopener" class="z-btn z-btn-ghost" style="height:32px">Docs</a>
			</div>
		</form>
		<div class="z-auth-foot">
			@Icon("shield", "w-3 h-3")
			<span>WebAuthn · credentials stay on-device</span>
		</div>
		<div class="z-divider"></div>
		<div style="display:flex;align-items:center;justify-content:space-between;font-size:10px;color:var(--text-4)">
			<span>New here? Register above.</span>
			<span class="z-mono">v0.1.0</span>
		</div>
	</div>
}
